{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"0e1136d40b3acd733edce49901b2c63cd7cdf1f331493ae8aa09494e442af11f","after_sha256":"e4dcd4e94d421491a631fd7a2750a1081c8833d92420e292e48c783a8a2560d7","remove":false,"lines":[{"span":[0,36]},{"port":"// party_menu.c: forget the Pokemon FLY was chosen on in the Party (spent or given up)\n"},{"port":"void CtrPartyMenu_ClearFlyChoice(void);\n"},{"span":[36,151]}]},{"path":"src/event_object_movement.c","before_sha256":"0f9c0ceea63ec4a65a2163e15469ff14bdf9107af08ea26ee81e3c9cbe49cfe5","after_sha256":"3c3368aeecf6045068dd88fae8a936d8f77db52914b08fc10caea10267292b6a","remove":false,"lines":[{"span":[0,10194]},{"port":"                // The jump off the surf blob leaves a water tile: showing itself there would stand it on the water,\n"},{"port":"                // so it drops that tile and keeps waiting until the first step taken from land.\n"},{"port":"                if (MetatileBehavior_IsSurfable(MapGridGetMetatileBehaviorAt(sCtrTrailX[0], sCtrTrailY[0])))\n"},{"port":"                {\n"},{"port":"                    sCtrTrailCount = 0;\n"},{"port":"                }\n"},{"port":"                else\n"},{"port":"                {\n"},{"port":"                    // It shows itself on the tile the player left, facing as the player does.\n"},{"port":"                    CtrFollower_Place(follower, sCtrTrailX[0], sCtrTrailY[0], sCtrTrailElevation[0]);\n"},{"port":"                    ObjectEventTurn(follower, player->facingDirection);\n"},{"port":"                    follower->invisible = FALSE;\n"},{"port":"                    sCtrFollowerWaiting = FALSE;\n"},{"port":"                    sCtrTrailCount = 0;\n"},{"port":"                }\n"},{"span":[10200,126]}]},{"path":"src/party_menu.c","before_sha256":"1ebd636f80cab1cf8d68acdbc9ec79684b6f7fba734d6cf0c65623ea63e9d30a","after_sha256":"943c3ef371d9eca650ab704892ced31995e28f64d90257a15175a6d85b1195f1","remove":false,"lines":[{"span":[0,194]},{"port":"// The Pokemon FLY was chosen on in the Party, so the HOME tap that ends it flies with that one (-1: none chosen).\n"},{"port":"static s8 sCtrFlyChosenSlot = -1;\n"},{"span":[194,4177]},{"port":"                    sCtrFlyChosenSlot = GetCursorSelectionMonId();\n"},{"span":[4371,159]},{"port":"// The party Pokemon that Fly would use from the field: the one FLY was chosen on\n"},{"port":"// in the Party if it can still fly, else the first that is not an egg and knows it\n"},{"port":"// (the field move the Party menu offers for it), or -1.\n"},{"span":[4532,4]},{"port":"    // The player's own choice wins over the first match; the Party may have changed since, so it is checked again.\n"},{"port":"    if (sCtrFlyChosenSlot >= 0 && sCtrFlyChosenSlot < PARTY_SIZE)\n"},{"port":"    {\n"},{"port":"        u16 species = GetMonData(&gPlayerParty[sCtrFlyChosenSlot], MON_DATA_SPECIES_OR_EGG);\n"},{"port":"\n"},{"port":"        if (species != SPECIES_NONE && species != SPECIES_EGG)\n"},{"port":"        {\n"},{"port":"            if (CtrFreeHm_Has(sFieldMoves[FIELD_MOVE_FLY]))\n"},{"port":"                return sCtrFlyChosenSlot;\n"},{"port":"            for (j = 0; j < MAX_MON_MOVES; j++)\n"},{"port":"            {\n"},{"port":"                if (GetMonData(&gPlayerParty[sCtrFlyChosenSlot], MON_DATA_MOVE1 + j) == sFieldMoves[FIELD_MOVE_FLY])\n"},{"port":"                    return sCtrFlyChosenSlot;\n"},{"port":"            }\n"},{"port":"        }\n"},{"port":"    }\n"},{"span":[4536,30]},{"port":"}\n"},{"port":"\n"},{"port":"// The Party's choice is spent (the Fly started) or given up (3ds_bottom.c), so a later\n"},{"port":"// Fly from HOME alone does not reuse it.\n"},{"port":"void CtrPartyMenu_ClearFlyChoice(void)\n"},{"port":"{\n"},{"port":"    sCtrFlyChosenSlot = -1;\n"},{"span":[4566,2621]}]},{"path":"src/pokemon_summary_screen.c","before_sha256":"23af77e30fbb65f97159a57acd46602adf7137803dfa66e64f7eb09fe9b40db4","after_sha256":"2d119bc0d7c6ca3fcad75c2555875ea94b01501018e99794c14f65d22a02724a","remove":false,"lines":[{"span":[0,1168]},{"port":"}\n"},{"port":"\n"},{"port":"// Read when a touch plan sends B on the move details: with a swap pending, B\n"},{"port":"// only cancels it and the page stays, so the plan must expect that page.\n"},{"port":"int CtrBottomSummary_Swapping(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomSummary_IsActive() && sMonSummaryScreen->isSwappingMoves;\n"},{"span":[1168,4639]}]},{"path":"src/region_map.c","before_sha256":"6ec1305e17edcefee81a4d340617a16560c79e64561533d78f56cda22eba8287","after_sha256":"adcb2052948adfb9f1f1a1593f2b7d5567a0b29540244c6cd96d09723dc4d93f","remove":false,"lines":[{"span":[0,4405]},{"port":"    // The Party's choice serves this one Fly, refused or not: a later one from HOME alone takes the first able Pokemon.\n"},{"port":"    CtrPartyMenu_ClearFlyChoice();\n"},{"span":[4405,99]}]}]}

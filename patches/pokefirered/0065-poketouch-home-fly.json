{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"dc9cffb59d59a118b8d8005b34a55c69051a9b5635049eadf9db89b0a49593a9","after_sha256":"2953af9bfabd0eaa900fe2af1bb68bbc7e9e742ac5f63ede9d68f629b6dce1e4","remove":false,"lines":[{"span":[0,25]},{"port":"// Fly from the home map: PokeTouch asks what Fly does at a map section\n"},{"port":"// (3ds_poketouch.h PT_FLY_*) and, when it can, starts it.\n"},{"port":"// ctr_poketouch.c\n"},{"port":"int CtrPokeTouch_FlyStatus(unsigned mapsec);\n"},{"port":"void CtrPokeTouch_RequestFly(unsigned mapsec);\n"},{"port":"// region_map.c: the Fly map's view of a map section (0 none, 1 unvisited, 2 visited), and the Fly itself\n"},{"port":"int CtrRegionMap_FlyDestination(unsigned mapsec);\n"},{"port":"bool8 CtrField_UseFly(u16 mapsec);\n"},{"port":"// party_menu.c: the party Pokemon that would Fly (slot, or -1), made the one the effect reads\n"},{"port":"int CtrPartyMenu_FlyUser(void);\n"},{"port":"void CtrPartyMenu_SetFlyUser(u8 slot);\n"},{"port":"// field_effect.c: the Fly effect from the live field\n"},{"port":"void CtrFieldEffect_UseFlyFromField(void);\n"},{"span":[25,38]}]},{"path":"src/ctr_poketouch.c","before_sha256":"ab9401dc48a87695a591654514dd3207bab6ff3daa35adf07f45ab33a16b932a","after_sha256":"228bb61071f317c5200416ed9c568b95cb82c726ca8cff44769115eb3278a8d5","remove":false,"lines":[{"span":[0,22]},{"port":"#include \"constants/party_menu.h\"\n"},{"port":"#include \"constants/flags.h\"\n"},{"port":"#include \"constants/maps.h\"\n"},{"port":"#include \"menu_helpers.h\"\n"},{"span":[22,44]},{"port":"static u16 sFlyMapsec;\n"},{"span":[66,12]},{"port":"// Fly to a map section of the home map, as a field command: taken (and\n"},{"port":"// checked again) where FireRed runs START, like every other request.\n"},{"port":"void CtrPokeTouch_RequestFly(unsigned mapsec)\n"},{"line":247},{"line":72},{"line":73},{"port":"    sFlyMapsec = mapsec;\n"},{"port":"    sCommand = PT_FLY + 1;\n"},{"line":75},{"line":249},{"line":245},{"span":[78,16]},{"port":"    case PT_FLY:\n"},{"port":"        return CtrField_UseFly(sFlyMapsec);\n"},{"span":[94,23]},{"line":249},{"line":245},{"line":158},{"port":" * What Fly does at a map section of the home map, by the rules of the Party\n"},{"port":" * menu and the Fly map: not a destination (the Fly map's own types); one not\n"},{"port":" * visited; no party Pokemon that knows Fly; the badge for it (the field move's\n"},{"port":" * own badge check); a place it cannot be used (a link or Union Room, indoors or\n"},{"port":" * underground: where the Party menu offers no Fly or the Fly map does not take\n"},{"port":" * a destination); the field not ready to take a command; else usable.\n"},{"line":162},{"port":"int CtrPokeTouch_FlyStatus(unsigned mapsec)\n"},{"line":247},{"port":"    switch (CtrRegionMap_FlyDestination(mapsec))\n"},{"line":201},{"port":"    case 0:\n"},{"port":"        return PT_FLY_NONE;\n"},{"port":"    case 1:\n"},{"port":"        return PT_FLY_UNVISITED;\n"},{"line":222},{"port":"    if (CtrPartyMenu_FlyUser() < 0)\n"},{"port":"        return PT_FLY_NO_MON;\n"},{"port":"    if (FlagGet(FLAG_BADGE01_GET + FIELD_MOVE_FLY) != TRUE)\n"},{"port":"        return PT_FLY_NO_BADGE;\n"},{"port":"    if (MenuHelpers_IsLinkActive() == TRUE || InUnionRoom() == TRUE\n"},{"port":"     || Overworld_MapTypeAllowsTeleportAndFly(gMapHeader.mapType) != TRUE\n"},{"port":"     || GetMapTypeByGroupAndId(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum) == MAP_TYPE_UNDERGROUND\n"},{"port":"     || GetMapTypeByGroupAndId(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum) == MAP_TYPE_INDOOR)\n"},{"port":"        return PT_FLY_NO_PLACE;\n"},{"line":72},{"port":"        return PT_FLY_BUSY;\n"},{"port":"    return PT_FLY_OK;\n"},{"span":[117,133]}]},{"path":"src/field_effect.c","before_sha256":"989bf07268157134acc6d54d56ecc2ff7e060ed903b4b4450cc59be720e285c7","after_sha256":"6c7b732d9f6148abf474e0471e1a36d72f97549cc893251858144bfd593fc86d","remove":false,"lines":[{"span":[0,1078]},{"line":4031},{"line":2864},{"port":"// FieldCallback_UseFly for a Fly started in the live field (the home map): the\n"},{"port":"// effect from where the player stands, with no Fly map before it to fade in from.\n"},{"port":"void CtrFieldEffect_UseFlyFromField(void)\n"},{"line":4034},{"line":1073},{"line":3100},{"line":3101},{"line":4038},{"line":2866},{"span":[1078,2961]}]},{"path":"src/party_menu.c","before_sha256":"1b233456030e5846f6dd82046e884a9ec87af53be1c424e755a49760ccf0aa5e","after_sha256":"8c75ab312bdc258efb8cf717e905cef010377385fc00de26d7efbf06a3937ad3","remove":false,"lines":[{"span":[0,4216]},{"line":6682},{"port":"// The party Pokemon that Fly would use from the field: the first that is not an\n"},{"port":"// egg and knows it (the field move the Party menu offers for it), or -1.\n"},{"port":"int CtrPartyMenu_FlyUser(void)\n"},{"line":6684},{"port":"    int i, j;\n"},{"line":6681},{"line":6649},{"line":6653},{"port":"        u16 species = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES_OR_EGG);\n"},{"line":6681},{"port":"        if (species == SPECIES_NONE || species == SPECIES_EGG)\n"},{"port":"            continue;\n"},{"port":"        for (j = 0; j < MAX_MON_MOVES; j++)\n"},{"line":6655},{"port":"            if (GetMonData(&gPlayerParty[i], MON_DATA_MOVE1 + j) == sFieldMoves[FIELD_MOVE_FLY])\n"},{"port":"                return i;\n"},{"line":6660},{"line":6663},{"line":6664},{"line":6687},{"line":6681},{"port":"// It is the Pokemon the Fly effect and the quest log event read (as if chosen in the menu).\n"},{"port":"void CtrPartyMenu_SetFlyUser(u8 slot)\n"},{"line":6684},{"port":"    gPartyMenu.slotId = slot;\n"},{"line":6687},{"line":6688},{"line":6681},{"span":[4216,2473]}]},{"path":"src/region_map.c","before_sha256":"374c44ef493effcecb74b8e0bca9806e349425af904a624340e126e4fac6593e","after_sha256":"d0ff5acbbf175d956b274ffd15bccc35c65d9eea9c026b381535a7ef5ca421ff","remove":false,"lines":[{"span":[0,22]},{"port":"#include \"3ds_poketouch.h\"\n"},{"span":[22,3007]},{"port":"static u8 GetMapsecTypeWithFly(u8 mapsec, bool8 hasFlyDestinations);\n"},{"line":4356},{"span":[3029,1]},{"line":4352},{"port":"    return GetMapsecTypeWithFly(mapsec, mapsec == MAPSEC_ROUTE_4_POKECENTER ? GetRegionMapPermission(MAPPERM_HAS_FLY_DESTINATIONS) : FALSE);\n"},{"line":4402},{"line":4356},{"port":"static u8 GetMapsecTypeWithFly(u8 mapsec, bool8 hasFlyDestinations)\n"},{"span":[3030,40]},{"port":"        if (!hasFlyDestinations)\n"},{"span":[3071,1154]},{"port":"static void SetFlyWarpDestinationOnly(u16 mapsec)\n"},{"span":[4226,11]},{"line":4402},{"line":4356},{"line":4225},{"line":4352},{"port":"    SetFlyWarpDestinationOnly(mapsec);\n"},{"span":[4237,99]},{"line":4402},{"line":4356},{"port":"// What the Fly map makes of a map section, with its Fly permission: 0 not a\n"},{"port":"// destination, 1 a destination not visited yet, 2 a visited one (the only kind\n"},{"port":"// its A button takes).\n"},{"port":"int CtrRegionMap_FlyDestination(unsigned mapsec)\n"},{"line":4352},{"line":4320},{"line":4379},{"port":"    switch (GetMapsecTypeWithFly(mapsec, TRUE))\n"},{"line":4358},{"port":"    case MAPSECTYPE_VISITED:\n"},{"port":"        return 2;\n"},{"port":"    case MAPSECTYPE_NOT_VISITED:\n"},{"port":"        return 1;\n"},{"line":4373},{"port":"    return 0;\n"},{"line":4402},{"line":4356},{"port":"// Fly from the field to a map section (the home map's second tap): the Fly\n"},{"port":"// map's own destination (SetFlyWarpDestinationOnly, its warp and quest log\n"},{"port":"// event) and the Fly field effect from where the player stands, as the Fly map\n"},{"port":"// leaves it (FieldCallback_UseFly) without its trip through the Party menu and\n"},{"port":"// back. False, and nothing started, unless Fly is allowed right now.\n"},{"port":"bool8 CtrField_UseFly(u16 mapsec)\n"},{"line":4352},{"port":"    int slot = CtrPartyMenu_FlyUser();\n"},{"line":4356},{"port":"    if (CtrPokeTouch_FlyStatus(mapsec) != PT_FLY_OK || slot < 0)\n"},{"line":3928},{"port":"    CtrPartyMenu_SetFlyUser(slot);\n"},{"port":"    SetFlyWarpDestinationOnly(mapsec);\n"},{"port":"    CtrFieldEffect_UseFlyFromField();\n"},{"line":3929},{"span":[4336,68]}]}]}

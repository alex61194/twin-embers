{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/load_save.h","before_sha256":"7cb006b791e8e35c23d0db14b397864a0e5f9983c19c38c40925d54e005abb34","after_sha256":"fa795e0447a61060e6b6055b04e5472917b595ef800928500dc233cfc73613d0","remove":false,"lines":[{"span":[0,26]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"bool8 MigrateLegacy3dsSave(void);\n"},{"port":"#endif\n"},{"span":[26,12]}]},{"path":"src/load_save.c","before_sha256":"b6a07136288f9330cf2b56f3a101fb62fd99fb23d76c9ab8de81e8cba458c012","after_sha256":"2c4f8181251b15abc758388c35fa1e99cc295e49a4ba532ffc3d45157f31fe63","remove":false,"lines":[{"span":[0,13]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_log.h\"\n"},{"line":130},{"span":[13,14]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// GCC may reorder separate EWRAM variables. Each moving block must own its\n"},{"port":"// trailing reservation, since loads/clears can reach 124 bytes past its base.\n"},{"port":"static EWRAM_DATA struct {\n"},{"port":"    struct SaveBlock2 data;\n"},{"port":"    u8 relocation[SAVEBLOCK_MOVE_RANGE];\n"},{"port":"} sSaveBlock2Storage = {0};\n"},{"port":"static EWRAM_DATA struct {\n"},{"port":"    struct SaveBlock1 data;\n"},{"port":"    u8 relocation[SAVEBLOCK_MOVE_RANGE];\n"},{"port":"} sSaveBlock1Storage = {0};\n"},{"port":"static EWRAM_DATA struct {\n"},{"port":"    struct PokemonStorage data;\n"},{"port":"    u8 relocation[SAVEBLOCK_MOVE_RANGE];\n"},{"port":"} sPokemonStorageStorage = {0};\n"},{"line":291},{"port":"// Keep the original game symbols and typed base addresses. Each data member\n"},{"port":"// starts at offset zero; its reservation is part of the same C allocation.\n"},{"port":"extern struct SaveBlock2 gSaveBlock2 __attribute__((alias(\"sSaveBlock2Storage\")));\n"},{"port":"extern struct SaveBlock1 gSaveBlock1 __attribute__((alias(\"sSaveBlock1Storage\")));\n"},{"port":"extern struct PokemonStorage gPokemonStorage __attribute__((alias(\"sPokemonStorageStorage\")));\n"},{"port":"#else\n"},{"span":[27,8]},{"line":130},{"span":[35,10]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// Early ARM11 builds wrote their AAPCS struct layout into otherwise standard\n"},{"port":"// sectors. Detect that early native layout using its displaced key and money,\n"},{"port":"// and expand the five short records in RAM. The SD image is read-only here;\n"},{"port":"// the next ordinary save writes the canonical GBA layout and checksums.\n"},{"port":"bool8 MigrateLegacy3dsSave(void)\n"},{"line":286},{"port":"    u8 *sav1 = (u8 *)gSaveBlock1Ptr;\n"},{"port":"    u8 *sav2 = (u8 *)gSaveBlock2Ptr;\n"},{"port":"    u32 legacyKey;\n"},{"port":"    int i, j;\n"},{"line":291},{"port":"    memcpy(&legacyKey, sav2 + 0xF1C, sizeof(legacyKey));\n"},{"port":"    if (gSaveBlock2Ptr->encryptionKey != 0 || legacyKey == 0\n"},{"port":"     || gSaveBlock1Ptr->money <= 999999\n"},{"port":"     || (gSaveBlock1Ptr->money ^ legacyKey) > 999999)\n"},{"port":"        return FALSE;\n"},{"line":291},{"port":"    // Expand Time from 6 to 8 bytes; subsequent SaveBlock2 fields move by 4.\n"},{"port":"    memmove(sav2 + 0xA8, sav2 + 0xA4, 0xF20 - 0xA4);\n"},{"port":"    memmove(sav2 + 0xA0, sav2 + 0x9E, 6);\n"},{"port":"    memset(sav2 + 0x9E, 0, 2);\n"},{"port":"    memset(sav2 + 0xA6, 0, 2);\n"},{"line":291},{"port":"    // Work backwards so no source bytes are lost during in-place expansion.\n"},{"port":"    memmove(sav1 + 0x3A94, sav1 + 0x39D4, 0x3CA8 - 0x39D4);\n"},{"port":"    for (i = ARRAY_COUNT(gSaveBlock1Ptr->fameChecker) - 1; i >= 0; --i)\n"},{"line":53},{"port":"        memmove(sav1 + 0x3A54 + i * 4, sav1 + 0x39B4 + i * 2, 2);\n"},{"port":"        memset(sav1 + 0x3A54 + i * 4 + 2, 0, 2);\n"},{"line":55},{"port":"    memmove(sav1 + 0x2F10, sav1 + 0x2E70, 0x39B4 - 0x2E70);\n"},{"port":"    for (i = MAIL_COUNT - 1; i >= 0; --i)\n"},{"line":53},{"port":"        memmove(sav1 + 0x2CD0 + i * 0x24, sav1 + 0x2C50 + i * 0x22, 0x22);\n"},{"port":"        memset(sav1 + 0x2CD0 + i * 0x24 + 0x22, 0, 2);\n"},{"line":55},{"port":"    memmove(sav1 + 0x2CA0, sav1 + 0x2C20, 0x30);\n"},{"port":"    for (i = QUEST_LOG_SCENE_COUNT - 1; i >= 0; --i)\n"},{"line":53},{"port":"        u8 *src = sav1 + 0x1300 + i * 0x648;\n"},{"port":"        u8 *dest = sav1 + 0x1300 + i * 0x668;\n"},{"port":"        memmove(dest + 0x148, src + 0x128, 0x520);\n"},{"port":"        for (j = OBJECT_EVENTS_COUNT - 1; j >= 0; --j)\n"},{"port":"        {\n"},{"port":"            memmove(dest + 8 + j * 0x14, src + 8 + j * 0x12, 0x12);\n"},{"port":"            memset(dest + 8 + j * 0x14 + 0x12, 0, 2);\n"},{"port":"        }\n"},{"port":"        memmove(dest, src, 8);\n"},{"line":55},{"port":"    // DaycareMon keeps the same total size, but its Mail tail starts 2 bytes\n"},{"port":"    // later. Move the names/language within each of its embedded mail records.\n"},{"port":"    for (i = 0; i <= DAYCARE_MON_COUNT; ++i)\n"},{"line":53},{"port":"        struct DayCareMail *mail = i == DAYCARE_MON_COUNT\n"},{"port":"            ? &gSaveBlock1Ptr->route5DayCareMon.mail\n"},{"port":"            : &gSaveBlock1Ptr->daycare.mons[i].mail;\n"},{"port":"        memmove((u8 *)mail + 0x24, (u8 *)mail + 0x22, 20);\n"},{"port":"        memset((u8 *)mail + 0x22, 0, 2);\n"},{"line":55},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"SAVE migrated early ARM11 layout key=%08lX money=%lu\",\n"},{"port":"                 (unsigned long)legacyKey, (unsigned long)(gSaveBlock1Ptr->money ^ legacyKey));\n"},{"port":"    return TRUE;\n"},{"line":297},{"line":130},{"line":291},{"span":[45,15]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CpuFill16(0, &sSaveBlock2Storage, sizeof(sSaveBlock2Storage));\n"},{"port":"#else\n"},{"span":[60,1]},{"line":130},{"span":[61,4]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CpuFill16(0, &sSaveBlock1Storage, sizeof(sSaveBlock1Storage));\n"},{"port":"#else\n"},{"span":[65,1]},{"line":130},{"span":[66,13]},{"line":291},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"SAVE relocate offset=%lu block1=%p base1=%p block2=%p base2=%p storage=%p baseStorage=%p sizes=%lu,%lu,%lu\",\n"},{"port":"                 (unsigned long)offset, (void *)gSaveBlock1Ptr, (void *)&gSaveBlock1,\n"},{"port":"                 (void *)gSaveBlock2Ptr, (void *)&gSaveBlock2,\n"},{"port":"                 (void *)gPokemonStoragePtr, (void *)&gPokemonStorage,\n"},{"port":"                 (unsigned long)sizeof(gSaveBlock1), (unsigned long)sizeof(gSaveBlock2),\n"},{"port":"                 (unsigned long)sizeof(gPokemonStorage));\n"},{"line":130},{"span":[79,219]}]},{"path":"src/save.c","before_sha256":"24f0b70d72cc83c50f7b2d6d73cb211c9b1272ab5fa40dc1d553ad48d1f4511c","after_sha256":"4757e7c8e9d20151ba5c008407908b67b739595dd7fc110ad5d983b41d417b5e","remove":false,"lines":[{"span":[0,12]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_log.h\"\n"},{"line":946},{"span":[12,66]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"STATIC_ASSERT(sizeof(struct SaveBlock2) == 0xF24, SaveBlock2GbaSize);\n"},{"port":"STATIC_ASSERT(sizeof(struct SaveBlock1) == 0x3D68, SaveBlock1GbaSize);\n"},{"port":"STATIC_ASSERT(sizeof(struct PokemonStorage) == 0x83D0, PokemonStorageGbaSize);\n"},{"port":"STATIC_ASSERT(offsetof(struct SaveBlock2, encryptionKey) == 0xF20, EncryptionKeyGbaOffset);\n"},{"port":"STATIC_ASSERT(sizeof(struct Time) == 8, TimeGbaSize);\n"},{"port":"STATIC_ASSERT(sizeof(struct Mail) == 0x24, MailGbaSize);\n"},{"port":"STATIC_ASSERT(sizeof(struct QuestLogScene) == 0x668, QuestLogSceneGbaSize);\n"},{"port":"STATIC_ASSERT(offsetof(struct QuestLogScene, script) == 0x568, QuestLogScriptGbaOffset);\n"},{"port":"STATIC_ASSERT(offsetof(struct SaveBlock1, rivalName) == 0x3A4C, RivalNameGbaOffset);\n"},{"line":946},{"span":[78,353]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 04 validation start sectors=%p locations=%p\", (void *)gSaveDataBufferPtr, (void *)locations);\n"},{"line":946},{"span":[431,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 05 selected result=%u slot=%lu counter=%lu\", status,\n"},{"port":"                     (unsigned long)(gSaveCounter % NUM_SAVE_SLOTS), (unsigned long)gSaveCounter);\n"},{"line":946},{"span":[432,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 07 blocks copied\");\n"},{"line":946},{"span":[433,17]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        /* Record the raw ID before any table lookup, including a damaged ID.\n"},{"port":"         * Diagnostics must not introduce an extra unsafe lookup themselves. */\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 06 sector=%u id=%u signature=%08lX checksum=%04x\",\n"},{"port":"                     i + sector, id, (unsigned long)gSaveDataBufferPtr->signature, gSaveDataBufferPtr->checksum);\n"},{"line":946},{"span":[450,356]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"SAVE enter LoadGameSave type=%u status=%u block1=%p block2=%p storage=%p\",\n"},{"port":"                 saveType, gSaveFileStatus, (void *)gSaveBlock1Ptr,\n"},{"port":"                 (void *)gSaveBlock2Ptr, (void *)gPokemonStoragePtr);\n"},{"line":946},{"line":880},{"span":[806,12]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 08 migration start result=%u\", result);\n"},{"port":"        if (result == SAVE_STATUS_OK || result == SAVE_STATUS_ERROR)\n"},{"port":"            MigrateLegacy3dsSave();\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 08 migration complete\");\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"SAVE slot result=%u slot=%lu counter=%lu firstSector=%u key=%08lX map=%d.%d pos=%d,%d\",\n"},{"port":"                     result, (unsigned long)(gSaveCounter % NUM_SAVE_SLOTS),\n"},{"port":"                     (unsigned long)gSaveCounter, gLastWrittenSector,\n"},{"port":"                     (unsigned long)gSaveBlock2Ptr->encryptionKey,\n"},{"port":"                     gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum,\n"},{"port":"                     gSaveBlock1Ptr->pos.x, gSaveBlock1Ptr->pos.y);\n"},{"line":946},{"span":[818,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 08 deserialized party/objects\");\n"},{"line":946},{"span":[819,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"SAVE exit LoadGameSave status=%u\", gSaveFileStatus);\n"},{"line":946},{"span":[821,142]}]}]}

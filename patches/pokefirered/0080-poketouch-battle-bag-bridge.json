r4), or 0.\n"},{"port":"int CtrBottomBag_Message(char *out, int size)\n"},{"line":2580},{"port":"    out[0] = 0;\n"},{"port":"    if (CtrBottomBag_State() != CTR_BAG_MESSAGE)\n"},{"line":1147},{"port":"    CtrBattle_FireRedText(gStringVar4, out, size);\n"},{"port":"    return out[0] != 0;\n"},{"line":2617},{"line":2578},{"port":"// The open context menu's rows (USE, CANCEL ...) as the Bag lists them.\n"},{"port":"int CtrBottomBag_ActionCount(void)\n"},{"line":2580},{"port":"    return CtrBottomBag_State() == CTR_BAG_ACTIONS && sContextMenuItemsPtr != NULL ? sContextMenuNumItems : 0;\n"},{"line":2617},{"line":2578},{"port":"void CtrBottomBag_ActionName(int index, char *out, int size)\n"},{"line":2580},{"port":"    out[0] = 0;\n"},{"port":"    if (index >= 0 && index < CtrBottomBag_ActionCount())\n"},{"port":"        CtrBattle_FireRedText(sItemMenuContextActions[sContextMenuItemsPtr[index]].text, out, size);\n"},{"span":[2265,353]}]}]}

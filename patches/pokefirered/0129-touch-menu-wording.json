{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/field_message_box.c","before_sha256":"38969672a37611f46b7ff54ba2172129d8a9690f7a6ce4587b02203233ea1c0e","after_sha256":"0f2fea6b99c04bcb413157de1864e507d164a98e13998982ab2995c0f6276eb9","remove":false,"lines":[{"span":[0,12]},{"port":"\n"},{"port":"// Twin Embers: the MENU opens from the lower screen, not START. The scripts come from the\n"},{"port":"// ROM unchanged; only what the TRAINER TIPS sign, the girl who copies it and Oak's lab sign\n"},{"port":"// show is the port's own text.\n"},{"port":"extern const u8 PalletTown_Text_PressStartToOpenMenu[];\n"},{"port":"extern const u8 PalletTown_Text_PressStartToOpenMenuCopy[];\n"},{"port":"extern const u8 PalletTown_ProfessorOaksLab_Text_PressStartToOpenMenu[];\n"},{"port":"\n"},{"port":"static const u8 sText_TrainerTipsTouchToOpenMenu[] = _(\"TRAINER TIPS\\pTouch the lower screen to open\\nthe MENU!\");\n"},{"port":"static const u8 sText_TrainerTipsTouchToOpenMenuCopy[] = _(\"TRAINER TIPS!\\pTouch the lower screen to open\\nthe MENU!\");\n"},{"port":"static const u8 sText_TouchToOpenMenu[] = _(\"Touch the lower screen to open\\nthe MENU!\");\n"},{"port":"\n"},{"port":"static const u8 *TouchMenuWording(const u8 *str)\n"},{"port":"{\n"},{"port":"    if (str == PalletTown_Text_PressStartToOpenMenu)\n"},{"port":"        return sText_TrainerTipsTouchToOpenMenu;\n"},{"port":"    if (str == PalletTown_Text_PressStartToOpenMenuCopy)\n"},{"port":"        return sText_TrainerTipsTouchToOpenMenuCopy;\n"},{"port":"    if (str == PalletTown_ProfessorOaksLab_Text_PressStartToOpenMenu)\n"},{"port":"        return sText_TouchToOpenMenu;\n"},{"port":"    return str;\n"},{"port":"}\n"},{"span":[12,92]},{"port":"    StringExpandPlaceholders(gStringVar4, TouchMenuWording(str));\n"},{"span":[105,37]}]},{"path":"src/help_system.c","before_sha256":"b5a16f20a8593296a8a850159802cab7c8669d2ffad3605cdb42d1a527ff8350","after_sha256":"d5eda25af2a4f
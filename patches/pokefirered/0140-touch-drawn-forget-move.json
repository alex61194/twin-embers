{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/pokemon_summary_screen.c","before_sha256":"49910162b27aca2f420aac2a36ee209d0d02acb11750fbb42aeb5130047a8fa8","after_sha256":"77e5233581be392e05243efd730519fbe3e820c384b02e1456c6efb2dbc8767d","remove":false,"lines":[{"span":[0,1198]},{"port":"}\n"},{"port":"\n"},{"port":"extern void CtrBattle_FireRedText(const u8 *text, char *out, int size);\n"},{"port":"\n"},{"port":"// The Summary that picks the move to forget for a new one (PSS_MODE_SELECT_MOVE: the four moves and the new one, 4),\n"},{"port":"// drawn by the lower screen (3ds_bottom.c) as a remote: whether it is open and takes a key, its cursor, the Pokemon,\n"},{"port":"// its moves (id, type, FireRed's name, PP, power and accuracy), the selected move's description and the question.\n"},{"port":"int CtrBottomLearn_IsOpen(void)\n"},{"port":"{\n"},{"port":"    return sMonSummaryScreen != NULL && sMonSummaryScreen->mode == PSS_MODE_SELECT_MOVE\n"},{"port":"        && sMonSummaryScreen->monList.mons == gPlayerParty\n"},{"port":"        && (gMain.callback2 == CB2_SetUpPSS || gMain.callback2 == CB2_RunPokemonSummaryScreen);\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomLearn_Ready(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomLearn_IsOpen() && !gPaletteFade.active && FuncIsActiveTask(Task_InputHandler_SelectOrForgetMove)\n"},{"port":"        && sMonSummaryScreen->selectMoveInputHandlerState == 2;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomLearn_Cursor(void)\n"},{"port":"{\n"},{"port":"    return sMoveSelectionCursorPos;\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrBottomLearn_Species(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomLearn_IsOpen() ? GetMonData(&sMonSummaryScreen->currentMon, MON_DATA_SPECIES) : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomLearn_Name(char *nickname, int nsize, char *level, int lsize)\n"},{"port":"{\n"},{"port":"    nickname[0] = level[0] = 0;\n"},{"port":"    if (!CtrBottomLearn_IsOpen())\n"},{"port":"        return;\n"},{"port":"    CtrText_CopyFireRed(sMonSummaryScreen->summary.nicknameStrBuf, nickname, (unsigned)nsize);\n"},{"port":"    CtrText_CopyFireRed(sMonSummaryScreen->summary.levelStrBuf, level, (unsigned)lsize);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A move row (0-3 the Pokemon's, 4 the new one): its id (0: none), and its type, name, PP, power and accuracy.\n"},{"port":"unsigned CtrBottomLearn_Move(int i, int *type, char *name, int nsize, char *pp, int psize, char *power, int wsize,\n"},{"port":"                             char *accuracy, int asize)\n"},{"port":"{\n"},{"port":"    struct PokeSummary *summary;\n"},{"port":"    char cur[8], max[8];\n"},{"port":"    u16 move;\n"},{"port":"\n"},{"port":"    name[0] = pp[0] = power[0] = accuracy[0] = 0;\n"},{"port":"    *type = -1;\n"},{"port":"    if (!CtrBottomLearn_IsOpen() || i < 0 || i > 4 || (move = sMonSummaryScreen->moveIds[i]) == MOVE_NONE)\n"},{"port":"        return 0;\n"},{"port":"    summary = &sMonSummaryScreen->summary;\n"},{"port":"    *type = sMonSummaryScreen->moveTypes[i];\n"},{"port":"    CtrText_CopyFireRed(summary->moveNameStrBufs[i], name, (unsigned)nsize);\n"},{"port":"    CtrText_CopyFireRed(summary->moveCurPpStrBufs[i], cur, sizeof(cur));\n"},{"port":"    CtrText_CopyFireRed(summary->moveMaxPpStrBufs[i], max, sizeof(max));\n"},{"port":"    snprintf(pp, psize, \"%s/%s\", cur, max);\n"},{"port":"    CtrText_CopyFireRed(summary->movePowerStrBufs[i], power, (unsigned)wsize);\n"},{"port":"    CtrText_CopyFireRed(summary->moveAccuracyStrBufs[i], accuracy, (unsigned)asize);\n"},{"port":"    return move;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomLearn_Description(unsigned move, char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (move != MOVE_NONE && move < MOVES_COUNT)\n"},{"port":"        CtrBattle_FireRedText(gMoveDescriptionPointers[move - 1], out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomLearn_TypeName(int type, char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (type >= 0 && type < NUMBER_OF_MON_TYPES)\n"},{"port":"    {\n"},{"port":"        CtrAssets_RequireRange(gTypeNames[type], sizeof(gTypeNames[0]));\n"},{"port":"        CtrText_CopyFireRed(gTypeNames[type], out, (unsigned)size);\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomLearn_Question(char *out, int size)\n"},{"port":"{\n"},{"port":"    CtrBattle_FireRedText(gText_WhichMoveToForget, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A move FireRed will not forget here (an HM): A only plays its failure sound.\n"},{"port":"int CtrBottomLearn_Locked(int i)\n"},{"port":"{\n"},{"port":"    return CtrBottomLearn_IsOpen() && i >= 0 && i < 4 && IsMoveHm(sMonSummaryScreen->moveIds[i]) == TRUE;\n"},{"span":[1198,4333]}]}]}

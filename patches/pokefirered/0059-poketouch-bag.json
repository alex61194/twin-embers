},{"port":"/*\n"},{"port":" * PokeTouch's view of the field Bag (3ds_bottom.c), read-only: which of the\n"},{"port":" * Bag's own input states runs, its live list and pocket, and what its windows\n"},{"port":" * show under a GBA pixel. The Bag's tasks take every input; the lower screen\n"},{"port":" * only presses its buttons.\n"},{"port":" */\n"},{"port":"enum\n"},{"line":2389},{"port":"    CTR_BAG_BUSY,\n"},{"port":"    CTR_BAG_LIST,       // Task_BagMenu_HandleInput takes input\n"},{"port":"    CTR_BAG_ACTIONS,    // the item's context menu\n"},{"port":"    CTR_BAG_YESNO,\n"},{"port":"    CTR_BAG_QUANTITY,   // how many to toss\n"},{"port":"    CTR_BAG_MESSAGE,    // a printed message waits for A\n"},{"line":298},{"line":2387},{"port":"// CtrBottomBag_HitAt: list indices from 0, then these.\n"},{"port":"#define CTR_BAG_HIT_MENU        0x100   // + row of the open menu\n"},{"port":"#define CTR_BAG_HIT_POCKET_PREV 0x200\n"},{"port":"#define CTR_BAG_HIT_POCKET_NEXT 0x201\n"},{"port":"#define CTR_BAG_HIT_SCROLL_UP   0x202\n"},{"port":"#define CTR_BAG_HIT_SCROLL_DOWN 0x203\n"},{"port":"#define CTR_BAG_HIT_QTY_UP      0x204\n"},{"port":"#define CTR_BAG_HIT_QTY_DOWN    0x205\n"},{"port":"#define CTR_BAG_HIT_QTY_OK      0x206\n"},{"line":2387},{"port":"// The Bag's callbacks (setup or running) in a Bag the lower screen shows:\n"},{"port":"// the field Bag, or the one Party's GIVE opens to choose an item to hold\n"},{"port":"// (CB2_SelectBagItemToGive). Shops, PCs, battle and tutorials are not.\n"},{"port":"int CtrBottomBag_IsOpen(void)\n"},{"line":2389},{"port":"    return (gMain.callback2 == CB2_OpenBagMenu || gMain.callback2 == CB2_BagMenuRun)\n"},{"port":"        && (gBagMenuState.location == ITEMMENULOCATION_FIELD || gBagMenuState.location == ITEMMENULOCATION_PARTY)\n"},{"port":"        && sBagMenuDisplay != NULL;\n"},{"line":2426},{"line":2387},{"port":"// That Bag is Party's GIVE: a child screen of Party.\n"},{"port":"int CtrBottomBag_FromParty(void)\n"},{"line":2389},{"port":"    return CtrBottomBag_IsOpen() && gBagMenuState.location == ITEMMENULOCATION_PARTY;\n"},{"line":2426},{"line":2387},{"port":"static bool8 BagTask(u8 *taskId)\n"},{"line":2389},{"port":"    if (!CtrBottomBag_IsOpen() || gMain.callback2 != CB2_BagMenuRun\n"},{"port":"        || sCtrBagTask >= NUM_TASKS || !gTasks[sCtrBagTask].isActive)\n"},{"line":2233},{"port":"    *taskId = sCtrBagTask;\n"},{"line":2073},{"line":2426},{"line":2387},{"port":"int CtrBottomBag_State(void)\n"},{"line":2389},{"port":"    u8 taskId, window;\n"},{"port":"    TaskFunc func;\n"},{"line":2387},{"port":"    if (!BagTask(&taskId) || gPaletteFade.active || FuncIsActiveTask(Task_AnimateWin0v) == TRUE\n"},{"port":"        || IsActiveOverworldLinkBusy() == TRUE)\n"},{"port":"        return CTR_BAG_BUSY;\n"},{"port":"    func = gTasks[taskId].func;\n"},{"port":"    if (func == Task_BagMenu_HandleInput)\n"},{"port":"        return CTR_BAG_LIST;\n"},{"port":"    if (func == Task_FieldItemContextMenuHandleInput)\n"},{"port":"        return CTR_BAG_ACTIONS;\n"},{"port":"    if (func == Task_SelectQuantityToToss)\n"},{"port":"        return CTR_BAG_QUANTITY;\n"},{"port":"    if (CtrMenuHelpers_InYesNo(taskId))\n"},{"port":"        return CTR_BAG_YESNO;\n"},{"port":"    if (CtrMenuHelpers_InMessage(taskId) || func == Task_MoveItemInPocket_HandleInput\n"},{"port":"        || func == Task_AnimateSwitchPockets)\n"},{"port":"        return CTR_BAG_BUSY;\n"},{"port":"    if (func == Task_WaitAB_RedrawAndReturnToBag)\n"},{"port":"        return CTR_BAG_MESSAGE;\n"},{"port":"    window = GetBagWindow(5);\n"},{"port":"    if (window != 0xFF && !IsTextPrinterActive(window))\n"},{"port":"        return CTR_BAG_MESSAGE;\n"},{"port":"    return CTR_BAG_BUSY;\n"},{"line":2426},{"line":2387},{"port":"// The list's length without CANCEL, which is the row after the last item.\n"},{"port":"int CtrBottomBag_Count(void)\n"},{"line":2389},{"port":"    return sBagMenuDisplay != NULL ? sBagMenuDisplay->nItems[gBagMenuState.pocket] : 0;\n"},{"line":2426},{"line":2387},{"port":"int CtrBottomBag_MaxShowed(void)\n"},{"line":2389},{"port":"    return sBagMenuDisplay != NULL ? sBagMenuDisplay->maxShowed[gBagMenuState.pocket] : 0;\n"},{"line":2426},{"line":2387},{"port":"// The list's selection: its first shown row plus the cursor's row, as\n"},{"port":"// Task_BagMenu_HandleInput keeps them.\n"},{"port":"int CtrBottomBag_Cursor(void)\n"},{"line":2389},{"line":312},{"port":"        return -1;\n"},{"port":"    return GetSelectedItemIndex(gBagMenuState.pocket);\n"},{"line":2426},{"line":2387},{"port":"int CtrBottomBag_MenuCursor(void)\n"},{"line":2389},{"port":"    return Menu_GetCursorPos();\n"},{"line":2426},{"line":2387},{"port":"// Changes when the Bag's input state, pocket, list or open windows do.\n"},{"port":"unsigned CtrBottomBag_Serial(void)\n"},{"line":2389},{"port":"    return (unsigned)CtrBottomBag_State() | (unsigned)gBagMenuState.pocket << 4\n"},{"port":"        | (unsigned)CtrBottomBag_Count() << 8 | (unsigned)sCtrBagTask << 16\n"},{"port":"        | (unsigned)(GetBagWindow(10) ^ GetBagWindow(0) << 4) << 24;\n"},{"line":2426},{"line":2387},{"port":"unsigned CtrBottomBag_Item(int index)\n"},{"line":2389},{"port":"    if (index < 0 || index >= CtrBottomBag_Count())\n"},{"port":"        return ITEM_NONE;\n"},{"port":"    return BagGetItemIdByPocketPosition(gBagMenuState.pocket + 1, index);\n"},{"line":2426},{"line":2387},{"port":"void CtrBottomBag_PocketName(char *out, int size)\n"},{"line":2389},{"port":"    CtrPokeTouch_Text(sPocketNames[gBagMenuState.pocket], 32, out, size);\n"},{"line":2426},{"line":2387},{"port":"void CtrBottomBag_ItemName(unsigned item, char *out, int size)\n"},{"line":2389},{"port":"    CtrPokeTouch_Text(ItemId_GetName(item), ITEM_NAME_LENGTH, out, size);\n"},{"line":2426},{"line":2387},{"port":"unsigned CtrBottomBag_Money(void)\n"},{"line":2389},{"port":"    return GetMoney(&gSaveBlock1Ptr->money);\n"},{"line":2426},{"line":2387},{"port":"/* What the Bag shows under GBA pixel (x, y) in its current state: a list row\n"},{"port":" * (its index; CANCEL is CtrBottomBag_Count), the pocket switch beside the Bag,\n"},{"port":" * the scroll arrows above and below the list, a row of the open context or\n"},{"port":" * YES/NO menu, or the quantity box and its arrows. -1 for nothing. */\n"},{"port":"int CtrBottomBag_HitAt(int x, int y)\n"},{"line":2389},{"port":"    int left, top, width, height, rowHeight, row, index;\n"},{"line":2387},{"port":"    switch (CtrBottomBag_State())\n"},{"line":2392},{"port":"    case CTR_BAG_LIST:\n"},{"port":"        left = GetWindowAttribute(0, WINDOW_TILEMAP_LEFT) * 8;\n"},{"port":"        top = GetWindowAttribute(0, WINDOW_TILEMAP_TOP) * 8;\n"},{"port":"        width = GetWindowAttribute(0, WINDOW_WIDTH) * 8;\n"},{"port":"        height = GetWindowAttribute(0, WINDOW_HEIGHT) * 8;\n"},{"port":"        if (x >= left && x < left + width && y >= top && y < top + height)\n"},{"line":2394},{"port":"            rowHeight = GetFontAttribute(gMultiuseListMenuTemplate.fontId, FONTATTR_MAX_LETTER_HEIGHT)\n"},{"port":"                      + gMultiuseListMenuTemplate.itemVerticalPadding;\n"},{"port":"            y -= top + gMultiuseListMenuTemplate.upText_Y;\n"},{"port":"            row = y < 0 ? 0 : y / rowHeight;\n"},{"port":"            index = gBagMenuState.cursorPos[gBagMenuState.pocket] + row;\n"},{"port":"            if (row < CtrBottomBag_MaxShowed() && index <= CtrBottomBag_Count())\n"},{"port":"                return index;\n"},{"port":"            return -1;\n"},{"line":2423},{"port":"        // The arrows CreatePocketScrollArrowPair puts at x 160, y 8 and 104.\n"},{"port":"        if (x >= 144 && x < 176 && y < top)\n"},{"port":"            return CTR_BAG_HIT_SCROLL_UP;\n"},{"port":"        if (x >= 144 && x < 176 && y >= top + height && y < top + height + 8)\n"},{"port":"            return CTR_BAG_HIT_SCROLL_DOWN;\n"},{"port":"        // The Bag and its pocket arrows (x 8 and 72), left of the list.\n"},{"port":"        if (x < left && y >= top && y < top + height && sBagMenuDisplay->pocketSwitchMode == 0)\n"},{"line":2394},{"port":"            if (x < left / 2)\n"},{"port":"                return gBagMenuState.pocket > POCKET_ITEMS - 1 ? CTR_BAG_HIT_POCKET_PREV : -1;\n"},{"port":"            return gBagMenuState.pocket < POCKET_POKE_BALLS - 1 ? CTR_BAG_HIT_POCKET_NEXT : -1;\n"},{"line":2423},{"port":"        return -1;\n"},{"port":"    case CTR_BAG_ACTIONS:\n"},{"port":"    case CTR_BAG_YESNO:\n"},{"port":"        row = CtrMenu_ItemAt(x, y);\n"},{"port":"        return row >= 0 ? CTR_BAG_HIT_MENU + row : -1;\n"},{"port":"    case CTR_BAG_QUANTITY:\n"},{"port":"        // The quantity box (bag window 0) with its arrows on its top and\n"},{"port":"        // bottom edges (CreateArrowPair_QuantitySelect).\n"},{"port":"        if (GetBagWindow(0) == 0xFF)\n"},{"port":"            return -1;\n"},{"port":"        left = GetWindowAttribute(GetBagWindow(0), WINDOW_TILEMAP_LEFT) * 8;\n"},{"port":"        top = GetWindowAttribute(GetBagWindow(0), WINDOW_TILEMAP_TOP) * 8;\n"},{"port":"        width = GetWindowAttribute(GetBagWindow(0), WINDOW_WIDTH) * 8;\n"},{"port":"        height = GetWindowAttribute(GetBagWindow(0), WINDOW_HEIGHT) * 8;\n"},{"port":"        if (x < left - 8 || x >= left + width + 8 || y < top - 16 || y >= top + height + 8)\n"},{"port":"            return -1;\n"},{"port":"        if (y < top + 8)\n"},{"port":"            return CTR_BAG_HIT_QTY_UP;\n"},{"port":"        if (y >= top + height - 8)\n"},{"port":"            return CTR_BAG_HIT_QTY_DOWN;\n"},{"port":"        return CTR_BAG_HIT_QTY_OK;\n"},{"line":2425},{"port":"    return -1;\n"},{"span":[2074,353]}]},{"path":"src/menu_helpers.c","before_sha256":"ac404f7061de3041529435f0a5012f263846ed9514e6c39575aa9bc0654191c7","after_sha256":"9341243d65591352de46d79c454c86abf361446beb08ef1a4b3f6340291f84c4","remove":false,"lines":[{"span":[0,69]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"boo
},{"port":"        else if (c >= CHAR_a && c <= CHAR_z)\n"},{"port":"            out[o++] = 'a' + (c - CHAR_a);\n"},{"port":"        else if (c >= CHAR_0 && c <= CHAR_9)\n"},{"port":"            out[o++] = '0' + (c - CHAR_0);\n"},{"port":"        else if (c == CHAR_PERIOD)\n"},{"port":"            out[o++] = '.';\n"},{"port":"        else if (c == CHAR_HYPHEN)\n"},{"port":"            out[o++] = '-';\n"},{"port":"        else if (c == CHAR_SGL_QUOTE_RIGHT)\n"},{"port":"            out[o++] = '\\'';\n"},{"port":"        else\n"},{"port":"            out[o++] = ' ';\n"},{"line":156},{"port":"    out[o] = 0;\n"},{"line":197},{"line":193},{"port":"// The current location's name (GetMapName).\n"},{"port":"void CtrPokeTouch_Location(char *out, int size)\n"},{"line":195},{"port":"    u8 name[32], *end;\n"},{"line":193},{"port":"    end = GetMapName(name, gMapHeader.regionMapSectionId, 0);\n"},{"port":"    ToUtf8(name, end - name, out, size);\n"},{"line":197},{"line":193},{"port":"// The player's name from the save, as the Trainer Card shows it.\n"},{"port":"void CtrPokeTouch_PlayerName(char *out, int size)\n"},{"line":195},{"port":"    ToUtf8(gSaveBlock2Ptr->playerName, PLAYER_NAME_LENGTH, out, size);\n"},{"line":197},{"line":193},{"span":[194,4]}]},{"path":"src/menu.c","before_sha256":"19158e25455ffed14afa516f0aa89c3412b3243dd11b5d7050cd41402db2a8ad","after_sha256":"0b69e1a67cc3d917cff82db292ded1459966e1b168a5649544d8285c484d7200","remove":false,"lines":[{"span":[0,872]},{"line":836},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The row of the menu Menu_InitCursor set up under GBA pixel (x, y): its window\n"},{"port":"// on screen (BG scroll 0, as in the menus using it), rows optionHeight apart\n"},{"port":"// from its top. -1 outside the window or past the last row.\n"},{"port":"int CtrMenu_ItemAt(int x, int y)\n"},{"line":834},{"port":"    int left, top, row;\n"},{"line":836},{"port":"    if (sMenu.windowId == WINDOW_NONE || sMenu.optionHeight == 0)\n"},{"port":"        
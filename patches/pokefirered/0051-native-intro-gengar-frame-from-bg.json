{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/intro.c","before_sha256":"a3ddba9f7c05ac2ad1505624f2ec57b84fee0e865a528edabb8e2fddc0e31006","after_sha256":"210ae0d564949826b0521cdd70cd97e0f0cf316eb00a4ebe92e85095dc447700","remove":false,"lines":[{"span":[0,2856]},{"port":"    // Read the animation row from BG Y itself: every writer sets it to\n"},{"port":"    // (frame << 15) + 0x1F000 minus an arc offset of at most 32px. The paused\n"},{"port":"    // bounce task can still hold its crouched state after the attack resets\n"},{"port":"    // the BG to frame 0, so its task data is not the displayed frame.\n"},{"port":"    s32 y = (s32)GetBgY(BG_SCENE3_GENGAR) - 0x1F000;\n"},{"port":"    s32 frame = (y + 0x4000) >> 15;\n"},{"port":"    if (frame < 0)\n"},{"port":"        frame = 0;\n"},{"port":"    if (frame > 3)\n"},{"port":"        frame = 3;\n"},{"port":"    pose->gengarFrame = frame;\n"},{"span":[2860,1]},{"port":"    pose->gengarY = ((frame << 15) - y) / 256;\n"},{"span":[2862,3]}]}]}

{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/m4a.c","before_sha256":"83151bdf1fe4c6a67d0f222e841883a282e04af9f361441b06d7d1c36dae87b1","after_sha256":"08da361dab78b80ab333744d39874d4dbebad4af3c5e5b89082a41dec2e5210d","remove":false,"lines":[{"span":[0,7]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The step of a fixed-pitch voice in SoundMainRAM (9.23 fixed point, 0x800000: one source\n"},{"port":"// sample per mixed sample, as at FireRed's own 13379 Hz). Set by SampleFreqSet; 0 until then,\n"},{"port":"// which SoundMainRAM reads as 0x800000. Zero-initialised: no data in the image.\n"},{"port":"u32 gCtrFixedPitchStep;\n"},{"port":"#endif\n"},{"span":[7,443]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // Fixed-pitch voices (the drum kits) take one source sample per mixed sample, so a mixer\n"},{"port":"    // faster than FireRed's 13379 Hz (224 samples a frame) played them faster and higher.\n"},{"port":"    // They keep 224 source samples a frame, whatever this mode mixes.\n"},{"port":"    gCtrFixedPitchStep = (0x800000u * gPcmSamplesPerVBlankTable[(SOUND_MODE_FREQ_13379 >> 16) - 1]\n"},{"port":"                          + soundInfo->pcmSamplesPerVBlank / 2) / soundInfo->pcmSamplesPerVBlank;\n"},{"port":"#endif\n"},{"span":[450,1374]}]},{"path":"src/m4a_1.s","before_sha256":"b4c0880192b303075521b99f30d76383982cf78faa23d0b642abde8d897ee6ee","after_sha256":"d274a065bfffc2659bc9a4f5c28702684f51b70dc457af51a5b9a63dd88eb018","remove":false,"lines":[{"span":[0,327]},{"port":"\t.ifdef PLATFORM_3DS\n"},{"port":"\t@ On a mixer faster than FireRed's 13379 Hz a fixed-pitch voice is held for\n"},{"port":"\t@ as long as on the GBA (gCtrFixedPitchStep, m4a.c), not one sample a mix.\n"},{"port":"\tldr r0, =gCtrFixedPitchStep\n"},{"port":"\tldr r0, [r0]\n"},{"port":"\tcmp r0, 0\n"},{"port":"\tcmpne r0, 0x800000\n"},{"port":"\tbne CtrFixedPitchHold\n"},{"port":"\t.endif\n"},{"span":[327,154]},{"port":"\n"},{"port":"\t.ifdef PLATFORM_3DS\n"},{"port":"@ Fixed-pitch voices on a mixer faster than FireRed's 13379 Hz: the resampling\n"},{"port":"@ loop of SoundMainRAM (_081DD19C), stepping by gCtrFixedPitchStep, with each\n"},{"port":"@ source sample held instead of blended with the next, as the GBA's DAC holds\n"},{"port":"@ it. Same registers, frame loop, wave loop and end of sample as that loop.\n"},{"port":"@ (Fixed voices that are also compressed or reversed go through Unk1; FireRed\n"},{"port":"@ defines none.)\n"},{"port":"\tarm_func_start CtrFixedPitchHold\n"},{"port":"CtrFixedPitchHold:\n"},{"port":"\tpush {r4,r12}\n"},{"port":"\tldr r4, =gCtrFixedPitchStep\n"},{"port":"\tldr r4, [r4]\n"},{"port":"\tldrsb r0, [r3]\n"},{"port":"\tldrsb r1, [r3, 0x1]!\n"},{"port":"\tsub r1, r1, r0\n"},{"port":"CtrFixedPitchHold_Block:\n"},{"port":"\tldr r6, [r5]\n"},{"port":"\tldr r7, [r5, PCM_DMA_BUF_SIZE]\n"},{"port":"CtrFixedPitchHold_Sample:\n"},{"port":"\tmul r12, r10, r0\n"},{"port":"\tbic r12, r12, 0xFF0000\n"},{"port":"\tadd r6, r12, r6, ror 8\n"},{"port":"\tmul r12, r11, r0\n"},{"port":"\tbic r12, r12, 0xFF0000\n"},{"port":"\tadd r7, r12, r7, ror 8\n"},{"port":"\tadd r9, r9, r4\n"},{"port":"\tmovs lr, r9, lsr 23\n"},{"port":"\tbeq CtrFixedPitchHold_Next\n"},{"port":"\tbic r9, r9, 0x3F800000\n"},{"port":"\tsubs r2, r2, lr\n"},{"port":"\tble CtrFixedPitchHold_End\n"},{"port":"\tsubs lr, lr, 0x1\n"},{"port":"\taddeq r0, r0, r1\n"},{"port":"CtrFixedPitchHold_Load:\n"},{"port":"\tldrsbne r0, [r3, lr]!\n"},{"port":"\tldrsb r1, [r3, 0x1]!\n"},{"port":"\tsub r1, r1, r0\n"},{"port":"CtrFixedPitchHold_Next:\n"},{"port":"\tadds r5, r5, 0x40000000\n"},{"port":"\tbcc CtrFixedPitchHold_Sample\n"},{"port":"\tstr r7, [r5, PCM_DMA_BUF_SIZE]\n"},{"port":"\tstr r6, [r5], 0x4\n"},{"port":"\tsubs r8, r8, 0x4\n"},{"port":"\tbgt CtrFixedPitchHold_Block\n"},{"port":"\tsub r3, r3, 0x1\n"},{"port":"\tpop {r4,r12}\n"},{"port":"\tb _081DD228\n"},{"port":"CtrFixedPitchHold_End:\n"},{"port":"\tldr r0, [sp, 0x18]\n"},{"port":"\tcmp r0, 0\n"},{"port":"\tbeq _081DD158\n"},{"port":"\tldr r3, [sp, 0x14]\n"},{"port":"\trsb lr, r2, 0\n"},{"port":"CtrFixedPitchHold_Wrap:\n"},{"port":"\tadds r2, r0, r2\n"},{"port":"\tbgt CtrFixedPitchHold_Load\n"},{"port":"\tsub lr, lr, r0\n"},{"port":"\tb CtrFixedPitchHold_Wrap\n"},{"port":"\t.pool\n"},{"port":"\tarm_func_end CtrFixedPitchHold\n"},{"port":"\t.endif\n"},{"span":[481,1455]}]}]}

{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/event_object_movement.c","before_sha256":"ca4c5f01f7e7cd674fc2bf3cb2b2dabbcaa6d392af0676ee64154d5cda752559","after_sha256":"0af33dffcd2f32616ee7a5244675f6dfec7241b4b9d4080872d7c89ff8f672e4","remove":false,"lines":[{"span":[0,9424]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// For the compositor (3ds_field_npc.c): the object event whose sprite shows these OBJ tiles and palette, as its graphics\n"},{"port":"// id, the image its animation shows and the game's unfaded palette buffer. 1 if there is one.\n"},{"port":"int CtrNpc_Sprite(unsigned tileNum, unsigned paletteNum, unsigned *graphicsId, unsigned *frame, const u16 **unfaded)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)\n"},{"port":"    {\n"},{"port":"        struct ObjectEvent *objectEvent = &gObjectEvents[i];\n"},{"port":"        struct Sprite *sprite;\n"},{"port":"        const union AnimCmd *cmd;\n"},{"port":"        u8 gfx;\n"},{"port":"\n"},{"port":"        if (!objectEvent->active || objectEvent->spriteId >= MAX_SPRITES)\n"},{"port":"            continue;\n"},{"port":"        sprite = &gSprites[objectEvent->spriteId];\n"},{"port":"        if (!sprite->inUse || sprite->usingSheet || sprite->anims == NULL || sprite->oam.tileNum != tileNum\n"},{"port":"         || sprite->oam.paletteNum != paletteNum)\n"},{"port":"            continue;\n"},{"port":"        gfx = objectEvent->graphicsId;\n"},{"port":"        if (gfx >= OBJ_EVENT_GFX_VARS)\n"},{"port":"            gfx = VarGetObjectEventGraphicsId(gfx - OBJ_EVENT_GFX_VARS);\n"},{"port":"        cmd = &sprite->anims[sprite->animNum][sprite->animCmdIndex];\n"},{"port":"        if (cmd->type < 0 && sprite->animCmdIndex > 0)\n"},{"port":"            cmd--;  // an ended animation keeps its last frame\n"},{"port":"        *graphicsId = gfx;\n"},{"port":"        *frame = cmd->type < 0 ? 0 : cmd->frame.imageValue;\n"},{"port":"        *unfaded = gPlttBufferUnfaded;\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    return 0;\n"},{"port":"}\n"},{"port":"#endif\n"}]}]}
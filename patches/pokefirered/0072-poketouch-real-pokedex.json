{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"f9d368a0ccdf8da4de6320792032b70d912d5d3620509391b55737a2290bdebf","after_sha256":"f2a229827ad4337d1aae2f80a644126ecee77e27f056d045d4e2124280a24e8a","remove":false,"lines":[{"span":[0,65]},{"port":"// pokedex_screen.c: the real Pokedex, shown in the lower viewport. IsOpen from its first frame to the end\n"},{"port":"// of its close; State is CTR_DEX_BUSY (setup, fade, flip, closing) or the screen that takes input; its B goes\n"},{"port":"// one level back (out of the Pokedex from the top menu). Cursor, RowAt and ArrowAt answer for the list on\n"},{"port":"// screen (CTR_DEX_MENU, CTR_DEX_LIST) in 240x160 coordinates.\n"},{"port":"enum { CTR_DEX_BUSY = 0, CTR_DEX_MENU, CTR_DEX_LIST, CTR_DEX_CATEGORY, CTR_DEX_PAGE };\n"},{"port":"int CtrBottomDex_IsOpen(void);\n"},{"port":"int CtrBottomDex_State(void);\n"},{"port":"int CtrBottomDex_Cursor(void);\n"},{"port":"int CtrBottomDex_RowAt(int x, int y);\n"},{"port":"int CtrBottomDex_ArrowAt(int x, int y);\n"},{"port":"void CB2_OpenPokedexFromBottom(void);\n"},{"port":"// start_menu.c: the Pokedex opened directly (no START menu) and left straight back to the field\n"},{"port":"void CtrCB2_ReturnFromBottomDex(void);\n"},{"port":"int CtrField_TryOpenDex(void);\n"},{"line":105},{"span":[65,42]}]},{"path":"src/pokedex_screen.c","before_sha256":"cb3f6e5a007eede5d8d1282e93bf9c3be223e0818d451086becd1fda5df9cc45","after_sha256":"c6642c396b5ea14b386a3bc7ca3c0cbda72b1367e98c84421520de91c9b08707","remove":false,"lines":[{"span":[0,3]},{"port":"#include \"ctr_poketouch.h\"\n"},{"span":[3,989]},{"line":2917},{"port":"// Opened from PokeTouch's lower screen (CtrField_TryOpenDex): the exit resumes\n"},{"port":"// the field instead of reopening the START menu.\n"},{"port":"static bool8 sBottomDex;\n"},{"line":2919},{"line":3468},{"span":[992,5]},{"line":2917},{"port":"        if (sBottomDex)\n"},{"line":3432},{"port":"            sBottomDex = FALSE;\n"},{"port":"            SetMainCallback2(CtrCB2_ReturnFromBottomDex);\n"},{"line":872},{"line":3442},{"line":2919},{"span":[997,2474]},{"line":3468},{"line":2917},{"port":"/* PokeTouch (3ds_bottom.c) shows this very screen in its lower viewport and\n"},{"port":" * drives it with FireRed's own keys. These only answer questions (and open\n"},{"port":" * it); the Pokedex's state stays here. */\n"},{"port":"void CB2_OpenPokedexFromBottom(void)\n"},{"line":3452},{"port":"    sBottomDex = TRUE;\n"},{"port":"    CB2_OpenPokedexFromStartMenu();\n"},{"line":3470},{"line":3468},{"port":"// Alive from its first frame to the end of its close.\n"},{"port":"int CtrBottomDex_IsOpen(void)\n"},{"line":3452},{"port":"    return sPokedexScreenData != NULL || gMain.callback2 == CB2_OpenPokedexFromBottom\n"},{"port":"        || gMain.callback2 == CB2_OpenPokedexFromStartMenu;\n"},{"line":3470},{"line":3468},{"port":"// The screen takes input in a state whose B (the only key PokeTouch's BACK sends) goes one level back:\n"},{"port":"// the top menu, a list, a category page, a Pokemon's page or its area page. Anything else (setup, a fade,\n"},{"port":"// a page flip, a zoom, closing) is not ready.\n"},{"port":"int CtrBottomDex_State(void)\n"},{"line":3452},{"port":"    struct Task *task;\n"},{"port":"    TaskFunc func;\n"},{"line":37},{"line":3468},{"port":"    if (sPokedexScreenData == NULL || gMain.callback2 != CB2_PokedexScreen || gPaletteFade.active\n"},{"port":"     || IsDma3ManagerBusyWithBgCopy())\n"},{"port":"        return CTR_DEX_BUSY;\n"},{"port":"    task = &gTasks[sPokedexScreenData->taskId];\n"},{"port":"    if (!task->isActive)\n"},{"port":"        return CTR_DEX_BUSY;\n"},{"port":"    func = task->func;\n"},{"port":"    state = sPokedexScreenData->state;\n"},{"port":"    if (func == Task_PokedexScreen && state == 6)\n"},{"port":"        return CTR_DEX_MENU;\n"},{"port":"    if ((func == Task_DexScreen_NumericalOrder || func == Task_DexScreen_CharacteristicOrder) && state == 6)\n"},{"port":"        return CTR_DEX_LIST;\n"},{"port":"    if (func == Task_DexScreen_CategorySubmenu && state == 5)\n"},{"port":"        return CTR_DEX_CATEGORY;\n"},{"port":"    if (func == Task_DexScreen_ShowMonPage && (state == 5 || state == 9))\n"},{"port":"        return CTR_DEX_PAGE;\n"},{"port":"    if (func == Task_DexScreen_CategorySubmenu && (state == 17 || state == 23))\n"},{"port":"        return CTR_DEX_PAGE;\n"},{"port":"    return CTR_DEX_BUSY;\n"},{"line":3470},{"line":3468},{"port":"// The ListMenu on screen (the top menu's or an ordered list's), while it takes input.\n"},{"port":"static struct ListMenu *CtrDexList(void)\n"},{"line":3452},{"port":"    switch (CtrBottomDex_State())\n"},{"line":3456},{"port":"    case CTR_DEX_MENU:\n"},{"port":"        return (struct ListMenu *)gTasks[sPokedexScreenData->modeSelectListMenuId].data;\n"},{"port":"    case CTR_DEX_LIST:\n"},{"port":"        return (struct ListMenu *)gTasks[sPokedexScreenData->orderedListMenuTaskId].data;\n"},{"line":3467},{"port":"    return NULL;\n"},{"line":3470},{"line":3468},{"port":"// The list's selected item (its position in the list), or -1.\n"},{"port":"int CtrBottomDex_Cursor(void)\n"},{"line":3452},{"port":"    struct ListMenu *list = CtrDexList();\n"},{"line":3468},{"port":"    return list != NULL ? list->cursorPos + list->itemsAbove : -1;\n"},{"line":3470},{"line":3468},{"port":"// The item under a point of the 240x160 screen, from the list's own window and row height; -1 outside the\n"},{"port":"// rows, past the last item or on a header.\n"},{"port":"int CtrBottomDex_RowAt(int x, int y)\n"},{"line":3452},{"port":"    struct ListMenu *list = CtrDexList();\n"},{"port":"    const struct WindowTemplate *window;\n"},{"port":"    int rowHeight, row, index;\n"},{"line":3468},{"port":"    if (list == NULL)\n"},{"port":"        return -1;\n"},{"port":"    window = &gWindows[list->template.windowId].window;\n"},{"port":"    rowHeight = GetFontAttribute(list->template.fontId, FONTATTR_MAX_LETTER_HEIGHT) + list->template.itemVerticalPadding;\n"},{"port":"    x -= window->tilemapLeft * 8;\n"},{"port":"    y -= window->tilemapTop * 8 + list->template.upText_Y;\n"},{"port":"    if (x < 0 || x >= window->width * 8 || y < 0)\n"},{"port":"        return -1;\n"},{"port":"    row = y / rowHeight;\n"},{"port":"    index = list->cursorPos + row;\n"},{"port":"    if (row >= list->template.maxShowed || index >= list->template.totalItems\n"},{"port":"     || list->template.items[index].index == LIST_HEADER)\n"},{"port":"        return -1;\n"},{"port":"    return index;\n"},{"line":3470},{"line":3468},{"port":"// The list's scroll arrows (where the arrow sprites are): -1 the upper one, 1 the lower one, 0 none.\n"},{"port":"int CtrBottomDex_ArrowAt(int x, int y)\n"},{"line":3452},{"port":"    if (CtrDexList() == NULL)\n"},{"line":2221},{"port":"    if (x >= sDexOrderScrollArrowsTemplate.firstX - 12 && x <= sDexOrderScrollArrowsTemplate.firstX + 12)\n"},{"line":3456},{"port":"        if (y >= sDexOrderScrollArrowsTemplate.firstY - 10 && y <= sDexOrderScrollArrowsTemplate.firstY + 10)\n"},{"port":"            return -1;\n"},{"port":"        if (y >= sDexOrderScrollArrowsTemplate.secondY - 10 && y <= sDexOrderScrollArrowsTemplate.secondY + 10)\n"},{"line":3222},{"line":3467},{"line":3224},{"line":3470},{"line":2919}]},{"path":"src/start_menu.c","before_sha256":"1951ed810f888426cb5f799534bf1251da7f31de413508a94b048ae4fa4f384b","after_sha256":"208abeaa9812f46cd5a44daab252fa4d4f871a2b5cf37f89743b4d140da7241f","remove":false,"lines":[{"span":[0,1182]},{"port":"/* The real Pokedex, opened from the lower screen the way StartMenuPokedexCallback does it (the same stat\n"},{"port":" * and cleanup, then its own opening callback) but without the START menu, and with an exit that resumes\n"},{"port":" * the field instead of reopening START. It is the same entry the menu has: not before one Pokemon was seen. */\n"},{"port":"void CtrCB2_ReturnFromBottomDex(void)\n"},{"line":1348},{"line":1160},{"line":1161},{"line":1353},{"line":1345},{"port":"int CtrField_TryOpenDex(void)\n"},{"line":1348},{"port":"    if (!CtrField_CanOpenBag() || !FlagGet(FLAG_SYS_POKEDEX_GET) || GetNationalPokedexCount(FLAG_GET_SEEN) == 0)\n"},{"line":1190},{"line":1194},{"line":1195},{"port":"    IncrementGameStat(GAME_STAT_CHECKED_POKEDEX);\n"},{"line":1175},{"line":1176},{"line":1177},{"port":"    SetMainCallback2(CB2_OpenPokedexFromBottom);\n"},{"line":1196},{"line":1353},{"line":1345},{"span":[1182,173]}]}]}

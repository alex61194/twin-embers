{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_gfx_sfx_util.c","before_sha256":"ef1b6b45d446b2da16c44ea81b98fe11de5d91782f0ccb045297bd76edf8436c","after_sha256":"54e2ad17381f19d50c4674a50301c6b642a84c27254259f4382bf191e11b7244","remove":false,"lines":[{"span":[0,162]},{"port":"}\n"},{"port":"\n"},{"port":"// The player's back (Red's or Leaf's) while it stands in the battler's sprite: the frame its animation shows, for the\n"},{"port":"// compositor to draw the pack's frame of it in its place.\n"},{"port":"int CtrGen4_BackSprite(unsigned battler, unsigned *backPic, unsigned *frame, const void **firePic)\n"},{"port":"{\n"},{"port":"    const union AnimCmd *cmd;\n"},{"port":"    struct Sprite *sprite;\n"},{"port":"    u8 spriteId;\n"},{"port":"\n"},{"port":"    if (gBattleSpritesDataPtr == NULL || battler >= gBattlersCount)\n"},{"port":"        return -1;\n"},{"port":"    spriteId = gBattlerSpriteIds[battler];\n"},{"port":"    if (spriteId >= MAX_SPRITES || !gSprites[spriteId].inUse || gSprites[spriteId].anims == NULL)\n"},{"port":"        return -1;\n"},{"port":"    sprite = &gSprites[spriteId];\n"},{"port":"    if (sprite->images == gTrainerBackPicTable_Red)\n"},{"port":"        *backPic = TRAINER_BACK_PIC_RED;\n"},{"port":"    else if (sprite->images == gTrainerBackPicTable_Leaf)\n"},{"port":"        *backPic = TRAINER_BACK_PIC_LEAF;\n"},{"port":"    else\n"},{"port":"        return -1;\n"},{"port":"    cmd = &sprite->anims[sprite->animNum][sprite->animCmdIndex];\n"},{"port":"    if (cmd->type < 0 && sprite->animCmdIndex > 0)\n"},{"port":"        cmd--;  // an ended animation keeps its last frame\n"},{"port":"    *frame = cmd->type < 0 ? 0 : cmd->frame.imageValue;\n"},{"port":"    *firePic = sprite->images[0].data;\n"},{"port":"    return sprite->oam.tileNum | (sprite->oam.paletteNum << 12);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Where FireRed loads the player's back palette: the pack's, for its frames, when it has Red's or Leaf's.\n"},{"port":"void CtrGen4_TryBackPalette(u16 backPic, u16 paletteOffset)\n"},{"port":"{\n"},{"port":"    u16 palette[16];\n"},{"port":"\n"},{"port":"    if ((backPic == TRAINER_BACK_PIC_RED || backPic == TRAINER_BACK_PIC_LEAF) && CtrGen4_BackPalette(backPic, palette))\n"},{"port":"        LoadPalette(palette, paletteOffset, PLTT_SIZE_4BPP);\n"},{"span":[162,380]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // HeartGold's picture of this trainer, when the Builder put it in the pack (3ds_battle_gen4.h): the sprite that\n"},{"port":"    // shows these tiles and this palette draws it instead, and the palette gets its colours.\n"},{"port":"    {\n"},{"port":"        u16 palette[16];\n"},{"port":"        u8 paletteNum = IndexOfSpritePaletteTag(gTrainerFrontPicPaletteTable[frontPicId].tag);\n"},{"port":"        u16 tileNum = GetSpriteTileStartByTag(gTrainerFrontPicTable[frontPicId].tag);\n"},{"port":"\n"},{"port":"        if (paletteNum < 16 && tileNum != 0xFFFF\n"},{"port":"         && CtrGen4_LoadTrainer(battlerId, frontPicId, gMonSpritesGfxPtr->sprites[position], tileNum, paletteNum,\n"},{"port":"                                palette))\n"},{"port":"            LoadPalette(palette, OBJ_PLTT_ID(paletteNum), PLTT_SIZE_4BPP);\n"},{"port":"    }\n"},{"port":"#endif\n"},{"span":[542,5]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrGen4_TryBackPalette(index, OBJ_PLTT_ID2(palette));\n"},{"port":"#endif\n"},{"span":[547,8]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrGen4_DropTrainer(frontPicId);\n"},{"port":"#endif\n"},{"span":[555,629]}]},{"path":"src/battle_controller_player.c","before_sha256":"5bd98e67ed4ce8b00b4bdd41fa22a17457615cb1a536a134236e9321d7aa2d47","after_sha256":"c4c6ed5fe560f657bce249c2ace645beee635e5afae8f63cbb8b848114bf4d1c","remove":false,"lines":[{"span":[0,2821]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    {\n"},{"port":"        extern void CtrGen4_TryBackPalette(u16 backPic, u16 paletteOffset);\n"},{"port":"\n"}
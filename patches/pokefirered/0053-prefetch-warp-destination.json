{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/field_fadetransition.c","before_sha256":"f8fefdf09bf66f95d32d5db1f01a9f8f5b1d06c744d4da827bc1fcbf7a2a41fc","after_sha256":"b7b0bb3191630b42d32e461352c31858951017e0f9fcd935275a409d553940e7","remove":false,"lines":[{"span":[0,534]},{"line":481},{"port":"    extern void PrefetchWarpDestinationStep(void);\n"},{"port":"    if (gPaletteFade.active)\n"},{"port":"        PrefetchWarpDestinationStep();\n"},{"line":490},{"span":[534,442]}]},{"path":"src/overworld.c","before_sha256":"93e832570aed716a4ac88e4eba1f7d05707264c6b7ba2122af2c838f3dd384a4","after_sha256":"63e7ec8271edb9f4cbdfc99dd91a9df7badba46dbeeec8627eaf760a4e486898","remove":false,"lines":[{"span":[0,553]},{"line":2355},{"port":"#include \"3ds_assets.h\"\n"},{"port":"/* Called every frame a warp waits for its fade to black: brings one piece of\n"},{"port":" * the destination's tilesets and layout in from the data pack, so CB2_LoadMap\n"},{"port":" * does not read them all in one 85-117 ms frame. Only reads data the warp is\n"},{"port":" * about to load anyway; resident assets return at once. */\n"},{"port":"void PrefetchWarpDestinationStep(void)\n"},{"line":3669},{"port":"    static s16 sKey = -1;\n"},{"port":"    static u8 sStep;\n"},{"port":"    const struct MapLayout *layout;\n"},{"port":"    const void *piece = NULL;\n"},{"port":"    size_t bytes = 1;\n"},{"port":"    s16 key = (s16)((sWarpDestination.mapGroup << 8) | (u8)sWarpDestination.mapNum);\n"},{"line":3681},{"port":"    if (sWarpDestination.mapGroup < 0 || sWarpDestination.mapGroup >= MAP_GROUPS_COUNT\n"},{"port":"        || sWarpDestination.mapNum < 0)\n"},{"line":1152},{"port":"    if (key != sKey)\n"},{"line":3684},{"port":"        sKey = key;\n"},{"port":"        sStep = 0;\n"},{"line":3687},{"port":"    layout = GetDestinationWarpMapHeader()->mapLayout;\n"},{"port":"    while (layout != NULL && sStep < 10 && piece == NULL)\n"},{"line":3684},{"port":"        const struct Tileset *tileset = sStep < 5 ? layout->primaryTileset : layout->secondaryTileset;\n"},{"port":"        switch (sStep++ % 5)\n"},{"line":3657},{"port":"        case 0: piece = tileset ? tileset->tiles : NULL; break;\n"},{"port":"        case 1: piece = tileset ? tileset->palettes : NULL; bytes = 16 * 16 * sizeof(u16); break;\n"},{"port":"        case 2: piece = tileset ? tileset->metatiles : NULL; break;\n"},{"port":"        case 3: piece = tileset ? tileset->metatileAttributes : NULL; break;\n"},{"port":"        default: piece = sStep <= 5 ? (const void *)layout->map : (const void *)layout->border; break;\n"},{"line":3659},{"line":3687},{"port":"    if (piece != NULL)\n"},{"port":"        CtrAssets_EnsureRange(piece, bytes);\n"},{"line":3688},{"line":2368},{"line":3681},{"span":[553,3136]}]}]}

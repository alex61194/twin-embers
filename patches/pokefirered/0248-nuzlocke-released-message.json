{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_main.c","before_sha256":"88298810652ed883c41d96034fdbca91cd57119c950cad93d1b587bd5daea11e","after_sha256":"272b1fd239555488681bcd61677e15ec780313bd35c0ad6f335274791a78521d","remove":false,"lines":[{"span":[0,3951]},{"port":"extern void ScriptContext_SetupScript(const u8 *ptr);\n"},{"port":"\n"},{"port":"/* The released Pokemon are told to the player in the game's own message box. The battle state machine has no safe point for one once\n"},{"port":" * the battle is over (the bag, the party and the field are reloaded by the callback that follows), so the nicknames wait here and the\n"},{"port":" * overworld asks for them: ProcessPlayerFieldInput (field_control_avatar.c) calls CtrNuzlocke_ReleaseMessage on every frame it runs,\n"},{"port":" * the first free one after the battle (or after the script that started it), and the message is a one-shot RAM script. */\n"},{"port":"static u8 sCtrNzNames[PARTY_SIZE][POKEMON_NAME_LENGTH + 1];\n"},{"port":"static u8 sCtrNzCount;\n"},{"port":"static u8 sCtrNzScript[48];\n"},{"port":"static u8 sCtrNzMsg[PARTY_SIZE][POKEMON_NAME_LENGTH + 24];\n"},{"port":"\n"},{"port":"#if defined(CTR_LANG_ES) && CTR_LANG_ES\n"},{"port":"static const u8 sCtrNzReleased[] = _(\" fue liberado.\");\n"},{"port":"#elif defined(CTR_LANG_DE) && CTR_LANG_DE\n"},{"port":"static const u8 sCtrNzReleased[] = _(\" wurde freigelassen.\");\n"},{"port":"#else\n"},{"port":"static const u8 sCtrNzReleased[] = _(\" was released.\");\n"},{"port":"#endif\n"},{"port":"\n"},{"port":"static u8 *CtrNzPtr(u8 *at, const void *pointer)\n"},{"port":"{\n"},{"port":"    uintptr_t value = (uintptr_t)pointer;\n"},{"port":"    u8 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < 4; i++)\n"},{"port":"        *at++ = (u8)(value >> (8 * i));\n"},{"port":"    return at;\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* TRUE when it started a message (this frame's input is consumed): lockall; (message, waitmessage, waitbuttonpress) per Pokemon;\n"},{"port":" * closemessage; releaseall; end. */\n"},{"port":"bool8 CtrNuzlocke_ReleaseMessage(void)\n"},{"port":"{\n"},{"port":"    u8 *s = sCtrNzScript;\n"},{"port":"    u8 i, n = sCtrNzCount;\n"},{"port":"\n"},{"port":"    if (n == 0)\n"},{"port":"        return FALSE;\n"},{"port":"    sCtrNzCount = 0;\n"},{"port":"    *s++ = 0x69;\n"},{"port":"    for (i = 0; i < n; ++i)\n"},{"port":"    {\n"},{"port":"        StringCopy(sCtrNzMsg[i], sCtrNzNames[i]);\n"},{"port":"        StringAppend(sCtrNzMsg[i], sCtrNzReleased);\n"},{"port":"        *s++ = 0x67; s = CtrNzPtr(s, sCtrNzMsg[i]);\n"},{"port":"        *s++ = 0x66;\n"},{"port":"        *s++ = 0x6D;\n"},{"port":"    }\n"},{"port":"    *s++ = 0x68;\n"},{"port":"    *s++ = 0x6B;\n"},{"port":"    *s++ = 0x02;\n"},{"port":"    ScriptContext_SetupScript(sCtrNzScript);\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"span":[3951,33]},{"port":"        if (sCtrNzCount < PARTY_SIZE)\n"},{"port":"            GetMonData(&gPlayerParty[i], MON_DATA_NICKNAME, sCtrNzNames[sCtrNzCount++]);   // told to the player by the overworld\n"},{"span":[3984,573]}]},{"path":"src/field_control_avatar.c","before_sha256":"64ccdea0fb61b5febb071a3c9f3759e1c436572f3eff6a5826dc3c3fa1af74df","after_sha256":"18b87db714a6c28cd98ae6ab15911cf95805e1db0130f1be46c11159ae2c9461","remove":false,"lines":[{"span":[0,204]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"extern bool8 CtrNuzlocke_ReleaseMessage(void);\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[204,15]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    if (gQuestLogState != QL_STATE_PLAYBACK && CtrNuzlocke_ReleaseMessage() == TRUE)\n"},{"port":"        return TRUE;\n"},{"port":"#endif\n"},{"span":[219,990]}]}]}
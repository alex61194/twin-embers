{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/trainer_card.c","before_sha256":"2ca2f8219764d0d60947b8acda5f9509e57a7eb7c1b4d250dd4ffdae71d05379","after_sha256":"6a001a7f536f5ab2b1695e2b1f963155e76a969e0421ff67065d004de4ad9083","remove":false,"lines":[{"span":[0,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include <stdio.h>\n"},{"port":"#include \"ctr_poketouch.h\"\n"},{"port":"#include \"data.h\"\n"},{"port":"#include \"decompress.h\"\n"},{"port":"#endif\n"},{"span":[1,685]},{"port":"}\n"},{"port":"\n"},{"port":"/* What the lower screen draws for the player's card (3ds_bottom.c): which side is up, FireRed's labels, the numbers it\n"},{"port":" * prints, the rows of its back and its pictures (the trainer's front picture and the badges, as the card loads them).\n"},{"port":" * Only the player's own card: a link card keeps FireRed's picture. */\n"},{"port":"int CtrBottomCard_TouchDrawn(void)\n"},{"port":"{\n"},{"port":"    return sTrainerCardDataPtr != NULL && !sTrainerCardDataPtr->isLink && !gReceivedRemoteLinkPlayers\n"},{"port":"        && sTrainerCardDataPtr->cardType == CARD_TYPE_FRLG;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomCard_OnBack(void)\n"},{"port":"{\n"},{"port":"    return sTrainerCardDataPtr != NULL && sTrainerCardDataPtr->onBack;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// 0 NAME, 1 IDNo., 2 MONEY, 3 the yen sign, 4 POKeDEX, 5 TIME.\n"},{"port":"/* No table of FireRed's text pointers here: a pointer array or a switch's jump table would sit in this game object as\n"},{"port":" * FireRed data (the clean-release audit counts it), so the label is picked one comparison at a time. */\n"},{"port":"__attribute__((noinline, optimize(\"no-jump-tables\", \"no-tree-switch-conversion\")))\n"},{"port":"void CtrBottomCard_Label(int which, char *out, int size)\n"},{"port":"{\n"},{"port":"    const u8 *text = NULL;\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (which == 0)\n"},{"port":"        text = gText_TrainerCardName;\n"},{"port":"    else if (which == 1)\n"},{"port":"        text = gText_TrainerCardIDNo;\n"},{"port":"    else if (which == 2)\n"},{"port":"        text = gText_TrainerCardMoney;\n"},{"port":"    else if (which == 3)\n"},{"port":"        text = gText_TrainerCardYen;\n"},{"port":"    else if (which == 4)\n"},{"port":"        text = gText_TrainerCardPokedex;\n"},{"port":"    else if (which == 5)\n"},{"port":"        text = gText_TrainerCardTime;\n"},{"port":"    if (text != NULL)\n"},{"port":"        CtrBattle_FireRedText(text, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomCard_Name(char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (sTrainerCardDataPtr != NULL)\n"},{"port":"        CtrPokeTouch_Text(sTrainerCardDataPtr->trainerCard.rse.playerName, PLAYER_NAME_LENGTH + 1, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// ID, money, whether the Pokedex is had and how many are caught, the play time (hours, minutes), stars, the badges\n"},{"port":"// (bit i: badge i).\n"},{"port":"void CtrBottomCard_Numbers(unsigned out[8])\n"},{"port":"{\n"},{"port":"    const struct TrainerCardRSE *card;\n"},{"port":"    unsigned badges = 0;\n"},{"port":"\n"},{"port":"    memset(out, 0, 8 * sizeof(out[0]));\n"},{"port":"    if (sTrainerCardDataPtr == NULL)\n"},{"port":"        return;\n"},{"port":"    card = &sTrainerCardDataPtr->trainerCard.rse;\n"},{"port":"    out[0] = card->trainerId;\n"},{"port":"    out[1] = card->money;\n"},{"port":"    out[2] = FlagGet(FLAG_SYS_POKEDEX_GET) != 0;\n"},{"port":"    out[3] = card->caughtMonsCount;\n"},{"port":"    out[4] = gSaveBlock2Ptr->playTimeHours > 999 ? 999 : gSaveBlock2Ptr->playTimeHours;\n"},{"port":"    out[5] = gSaveBlock2Ptr->playTimeMinutes > 59 ? 59 : gSaveBlock2Ptr->playTimeMinutes;\n"},{"port":"    out[6] = card->stars;\n"},{"port":"    for (int i = 0; i < NUM_BADGES; i++)\n"},{"port":"        if (sTrainerCardDataPtr->hasBadge[i])\n"},{"port":"            badges |= 1u << i;\n"},{"port":"    out[7] = badges;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The back's rows in FireRed's order (HALL OF FAME DEBUT, LINK BATTLES, POKeMON TRADES, UNION TRADES & BATTLES,\n"},{"port":"// BERRY CRUSH), only those the card prints; 0 past the last.\n"},{"port":"int CtrBottomCard_BackRow(int index, char *label, int lsize, char *value, int vsize)\n"},{"port":"{\n"},{"port":"    const struct TrainerCard *card;\n"},{"port":"    int n = 0;\n"},{"port":"\n"},{"port":"    label[0] = value[0] = 0;\n"},{"port":"    if (sTrainerCardDataPtr == NULL)\n"},{"port":"        return 0;\n"},{"port":"    card = &sTrainerCardDataPtr->trainerCard;\n"},{"port":"    if (sTrainerCardDataPtr->hasHofResult && n++ == index)\n"},{"port":"    {\n"},{"port":"        CtrBattle_FireRedText(gText_HallOfFameDebut, label, lsize);\n"},{"port":"        snprintf(value, vsize, \"%u:%02u:%02u\", card->rse.hofDebutHours, card->rse.hofDebutMinutes, card->rse.hofDebutSeconds);\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    if (sTrainerCardDataPtr->hasLinkResults && n++ == index)\n"},{"port":"    {\n"},{"port":"        CtrBattle_FireRedText(sLinkTrainerCardRecordStrings[sTrainerCardDataPtr->cardType], label, lsize);\n"},{"port":"        snprintf(value, vsize, \"W:%u  L:%u\", card->rse.linkBattleWins, card->rse.linkBattleLosses);\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    if (sTrainerCardDataPtr->hasTrades && n++ == index)\n"},{"port":"    {\n"},{"port":"        CtrBattle_FireRedText(gText_PokemonTrades, label, lsize);\n"},{"port":"        snprintf(value, vsize, \"%u\", card->rse.pokemonTrades);\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    if (card->unionRoomNum && n++ == index)\n"},{"port":"    {\n"},{"port":"        CtrBattle_FireRedText(gText_UnionRoomTradesBattles, label, lsize);\n"},{"port":"        snprintf(value, vsize, \"%u\", (unsigned)card->unionRoomNum);\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    if (card->berryCrushPoints && n++ == index)\n"},{"port":"    {\n"},{"port":"        CtrBattle_FireRedText(gText_BerryCrushes, label, lsize);\n"},{"port":"        snprintf(value, vsize, \"%u\", (unsigned)card->berryCrushPoints);\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    return 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The trainer's front picture (64x64 4bpp, 8x8 tiles in rows of eight) and its palette.\n"},{"port":"int CtrPokeTouch_CardTrainerPic(unsigned char *tiles, unsigned short *palette)\n"},{"port":"{\n"},{"port":"    const u32 *gfx, *pal;\n"},{"port":"    u16 picId;\n"},{"port":"\n"},{"port":"    if (sTrainerCardDataPtr == NULL)\n"},{"port":"        return 0;\n"},{"port":"    picId = PlayerGenderToFrontTrainerPicId(sTrainerCardDataPtr->trainerCard.rse.gender, TRUE);\n"},{"port":"    gfx = gTrainerFrontPicTable[picId].data;\n"},{"port":"    pal = gTrainerFrontPicPaletteTable[picId].data;\n"},{"port":"    CTR_ASSET_READ(gfx, 4);\n"},{"port":"    CTR_ASSET_READ(pal, 4);\n"},{"port":"    if (GetDecompressedDataSize((const u8 *)gfx) != 0x800 || GetDecompressedDataSize((const u8 *)pal) > 32)\n"},{"port":"        return 0;\n"},{"port":"    LZ77UnCompWram(gfx, tiles);\n"},{"port":"    LZ77UnCompWram(pal, palette);\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The badges (128x16 4bpp: sixteen tiles a row, two rows; badge i at tiles 2i and 2i+16) and their palette.\n"},{"port":"int CtrPokeTouch_CardBadges(unsigned char *tiles, unsigned short *palette)\n"},{"port":"{\n"},{"port":"    CTR_ASSET_READ(sKantoTrainerCardBadges_Gfx, 4);\n"},{"port":"    CTR_ASSET_READ(sKantoTrainerCardBadges_Pal, 32);\n"},{"port":"    if (GetDecompressedDataSize((const u8 *)sKantoTrainerCardBadges_Gfx) != 0x80 * NUM_BADGES)\n"},{"port":"        return 0;\n"},{"port":"    LZ77UnCompWram(sKantoTrainerCardBadges_Gfx, tiles);\n"},{"port":"    memcpy(palette, sKantoTrainerCardBadges_Pal, 32);\n"},{"port":"    return 1;\n"},{"span":[686,1315]}]}]}

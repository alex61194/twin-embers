kemon *mon;\n"},{"span":[272,12]},{"port":"    mon = CtrWild_VersionSlot(info, area, slot, &scratch);\n"},{"port":"    level = ChooseWildMonLevel(mon);\n"},{"span":[285,4]},{"port":"    GenerateWildMon(mon->species, level, slot);\n"},{"span":[290,6]},{"port":"    struct WildPokemon scratch;\n"},{"port":"    const struct WildPokemon *mon = CtrWild_VersionSlot(info, WILD_AREA_FISHING, slot, &scratch);\n"},{"port":"    u8 level = ChooseWildMonLevel(mon);\n"},{"port":"    GenerateWildMon(mon->species, level, slot);\n"},{"port":"    return mon->species;\n"},{"span":[299,485]}]}]}

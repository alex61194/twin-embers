{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/learn_move.c","before_sha256":"4eb6ee3b674d788354af6d6b56dad15bd2cacee1cd2605e13c8f658aaf03b77a","after_sha256":"93fdd8cf60e1ff62f5fa5603d4df5e36cf24e21facb0c35abe63920faa0a3aea","remove":false,"lines":[{"span":[0,964]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The lower screen draws the relearner's list itself (3ds_field_relearn_impl.h), a remote for this screen: the Pokemon, the moves it\n"},{"port":"// can remember (then CANCEL), the cursor and the selected move's numbers and description. It does so for the list only (the setup, the\n"},{"port":"// fade in, the wait for a key); the questions and messages stay in the viewport (CtrBottomView_Relearner), where FireRed prints them.\n"},{"port":"// A row is walked to with the list's own UP / DOWN and taken with its A, so the game decides everything.\n"},{"port":"extern void CtrText_CopyFireRed(const u8 *src, char *out, unsigned size);\n"},{"port":"extern void CtrBattle_FireRedText(const u8 *text, char *out, int size);\n"},{"port":"extern void CtrBottomLearn_Description(unsigned move, char *out, int size);\n"},{"port":"extern void CtrBottomLearn_TypeName(int type, char *out, int size);\n"},{"port":"\n"},{"port":"static void CtrRelearnNumber(char *out, int size, unsigned v, int dash)\n"},{"port":"{\n"},{"port":"    char tmp[6];\n"},{"port":"    int n = 0, k;\n"},{"port":"\n"},{"port":"    if (size < 1)\n"},{"port":"        return;\n"},{"port":"    if (dash)\n"},{"port":"    {\n"},{"port":"        for (k = 0; k < 3 && k + 1 < size; k++)\n"},{"port":"            out[k] = '-';\n"},{"port":"        out[k] = 0;\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    do\n"},{"port":"    {\n"},{"port":"        tmp[n++] = '0' + v % 10;\n"},{"port":"        v /= 10;\n"},{"port":"    } while (v != 0 && n < 5);\n"},{"port":"    for (k = 0; k < n && k + 1 < size; k++)\n"},{"port":"        out[k] = tmp[n - 1 - k];\n"},{"port":"    out[k] = 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomRelearn_IsOpen(void)\n"},{"port":"{\n"},{"port":"    return sMoveRelearner != NULL && gMain.callback2 == CB2_MoveRelearner && sMoveRelearner->state <= MENU_STATE_IDLE_BATTLE_MODE\n"},{"port":"        && sMoveRelearner->numLearnableMoves > 0 && sMoveRelearner->selectedPartyMember < PARTY_SIZE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomRelearn_Ready(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomRelearn_IsOpen() && sMoveRelearner->state == MENU_STATE_IDLE_BATTLE_MODE && !gPaletteFade.active;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The moves it can remember; the list has one more entry after them, CANCEL.\n"},{"port":"int CtrBottomRelearn_Count(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomRelearn_IsOpen() ? sMoveRelearner->numLearnableMoves - 1 : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomRelearn_Cursor(void)\n"},{"port":"{\n"},{"port":"    int count = CtrBottomRelearn_Count();\n"},{"port":"\n"},{"port":"    if (count < 1)\n"},{"port":"        return 0;\n"},{"port":"    return sMoveRelearner->selectedIndex < count ? sMoveRelearner->selectedIndex : count;\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrBottomRelearn_Species(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomRelearn_IsOpen() ? GetMonData(&gPlayerParty[sMoveRelearner->selectedPartyMember], MON_DATA_SPECIES) : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomRelearn_Name(char *nickname, int nsize, char *level, int lsize)\n"},{"port":"{\n"},{"port":"    u8 raw[POKEMON_NAME_LENGTH + 1], nick[POKEMON_NAME_LENGTH + 1];\n"},{"port":"\n"},{"port":"    nickname[0] = level[0] = 0;\n"},{"port":"    if (!CtrBottomRelearn_IsOpen())\n"},{"port":"        return;\n"},{"port":"    GetMonData(&gPlayerParty[sMoveRelearner->selectedPartyMember], MON_DATA_NICKNAME, raw);\n"},{"port":"    StringCopy_Nickname(nick, raw);\n"},{"port":"    CtrText_CopyFireRed(nick, nickname, (unsigned)nsize);\n"},{"port":"    CtrRelearnNumber(level, lsize, GetMonData(&gPlayerParty[sMoveRelearner->selectedPartyMember], MON_DATA_LEVEL), FALSE);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// FireRed's question above the list (it prints it on its window 7 with the nickname in STR_VAR_1).\n"},{"port":"void CtrBottomRelearn_Question(char *out, int size)\n"},{"port":"{\n"},{"port":"    u8 text[80];\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!CtrBottomRelearn_IsOpen())\n"},{"port":"        return;\n"},{"port":"    StringExpandPlaceholders(text, gText_TeachWhichMoveToMon);\n"},{"port":"    CtrBattle_FireRedText(text, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A list row: i < count a move (its id returned, then its type and FireRed's name, base PP, power and accuracy), i == count CANCEL\n"},{"port":"// (0 returned, its label the name), anything else nothing (0, empty).\n"},{"port":"unsigned CtrBottomRelearn_Row(int i, int *type, char *name, int nsize, char *pp, int psize, char *power, int wsize, char *accuracy, int asize)\n"},{"port":"{\n"},{"port":"    u16 move;\n"},{"port":"    int count = CtrBottomRelearn_Count();\n"},{"port":"\n"},{"port":"    name[0] = pp[0] = power[0] = accuracy[0] = 0;\n"},{"port":"    *type = -1;\n"},{"port":"    if (i < 0 || i > count || i >= 25)\n"},{"port":"        return 0;\n"},{"port":"    CtrText_CopyFireRed(sMoveRelearner->listMenuStrbufs[i], name, (unsigned)nsize);\n"},{"port":"    if (i == count)\n"},{"port":"        return 0;\n"},{"port":"    move = sMoveRelearner->learnableMoves[i];\n"},{"port":"    if (move == MOVE_NONE || move >= MOVES_COUNT)\n"},{"port":"        return 0;\n"},{"port":"    *type = gBattleMoves[move].type;\n"},{"port":"    CtrRelearnNumber(pp, psize, gBattleMoves[move].pp, FALSE);\n"},{"port":"    CtrRelearnNumber(power, wsize, gBattleMoves[move].power, gBattleMoves[move].power < 2);\n"},{"port":"    CtrRelearnNumber(accuracy, asize, gBattleMoves[move].accuracy, gBattleMoves[move].accuracy == 0);\n"},{"port":"    return move;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomRelearn_Description(unsigned move, char *out, int size)\n"},{"port":"{\n"},{"port":"    CtrBottomLearn_Description(move, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomRelearn_TypeName(int type, char *out, int size)\n"},{"port":"{\n"},{"port":"    CtrBottomLearn_TypeName(type, out, size);\n"},{"port":"}\n"},{"port":"#endif\n"}]}]}
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_controller_player.c","before_sha256":"fc7dd2c8ad4a707392cd984e92a0e03f12423ac858b727ac64846934e6dfa9aa","after_sha256":"597f286049115bd8a23fb19f0c2178a2e18d35dfca985be51f70fbe3c9a98263","remove":false,"lines":[{"span":[0,35]},{"port":"// The quick ball (the lower screen's ball button): the ball it shows, and whether the action just chosen is its throw.\n"},{"port":"static u16 sCtrBall;\n"},{"port":"static bool8 sCtrBallThrow;\n"},{"port":"int CtrBattle_QuickBallReady(void);\n"},{"port":"void CtrBattle_QuickBallStep(int dir);\n"},{"port":"void CtrSettings_SetLastBall(unsigned item);\n"},{"span":[35,202]},{"port":"    // The ball button went away (no balls left, the boxes full): its cursor goes back to FIGHT.\n"},{"port":"    if (gActionSelectionCursor[gActiveBattler] == CTR_ACTION_BALL && !CtrBattle_QuickBallReady())\n"},{"port":"        gActionSelectionCursor[gActiveBattler] = 0;\n"},{"span":[237,7]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        case CTR_ACTION_BALL:\n"},{"port":"            // Thrown at once: the item action, answered with the ball where the Bag would open (PlayerHandleChooseItem).\n"},{"port":"            sCtrBallThrow = TRUE;\n"},{"port":"            BtlController_EmitTwoReturnValues(1, B_ACTION_USE_ITEM, 0);\n"},{"port":"            break;\n"},{"port":"#endif\n"},{"span":[244,21]},{"port":"        int cursor = gActionSelectionCursor[gActiveBattler];\n"},{"port":"        int next = CtrBattleActionStepBall(cursor, dir, CtrBattle_QuickBallReady());\n"},{"span":[266,8]},{"port":"    }\n"},{"port":"    // SELECT: the next ball on the ball button, as a swipe across it does.\n"},{"port":"    else if (JOY_NEW(SELECT_BUTTON))\n"},{"port":"    {\n"},{"port":"        if (CtrBattle_QuickBallReady())\n"},{"port":"            CtrBattle_QuickBallStep(1);\n"},{"span":[274,2283]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // The quick ball: the ball is taken from the Bag as its USE does (BattleUseFunc_PokeBallEtc) and given back as the\n"},{"port":"    // Bag's answer, with no Bag on screen. Anything amiss (it ran out, the boxes filled) opens the Bag as usual.\n"},{"port":"    if (sCtrBallThrow)\n"},{"port":"    {\n"},{"port":"        u16 ball = sCtrBall;\n"},{"port":"\n"},{"port":"        sCtrBallThrow = FALSE;\n"},{"port":"        if (CtrBattle_QuickBallReady() && CheckBagHasItem(ball, 1))\n"},{"port":"        {\n"},{"port":"            for (i = 0; i < 3; ++i)\n"},{"port":"                gBattlePartyCurrentOrder[i] = gBattleBufferA[gActiveBattler][1 + i];\n"},{"port":"            RemoveBagItem(ball, 1);\n"},{"port":"            gSpecialVar_ItemId = ball;\n"},{"port":"            CtrSettings_SetLastBall(ball);\n"},{"port":"            BtlController_EmitOneReturnValue(1, ball);\n"},{"port":"            PlayerBufferExecCompleted();\n"},{"port":"            return;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"#endif\n"},{"span":[2557,592]},{"port":"    sCtrAskedCursor = slot >= 0 && slot <= CTR_ACTION_BALL ? slot : -1;     // CTR_ACTION_BALL: the ball button\n"},{"span":[3150,8]},{"port":"    if (sCtrAskedCursor == CTR_ACTION_BALL && !CtrBattle_QuickBallReady())\n"},{"port":"        sCtrAskedCursor = -1;   // only the player's own action menu has it, and only while a ball can be thrown\n"},{"port":"    else if (sCtrAskedCursor != gActionSelectionCursor[gActiveBattler])\n"},{"span":[3159,263]},{"port":"\n"},{"port":"/*\n"},{"port":" * The quick ball (issue #16): in a wild battle the lower screen's action menu has a button that throws a ball at once,\n"},{"port":" * the one it shows; a swipe across it, its arrows or SELECT go through the balls in the Bag's order. Only where the\n"},{"port":" * Bag could throw one: not against a trainer, in a link, the Safari Zone (its own BALL), the old man's or Oak's\n"},{"port":" * tutorials, or the towers. It starts on the ball last thrown this way (the port's settings).\n"},{"port":" */\n"},{"port":"unsigned CtrSettings_LastBall(void);\n"},{"port":"u16 GetBagItemQuantity(u16 *quantity);       // item.c\n"},{"port":"\n"},{"port":"static bool8 CtrQuickBall_Battle(void)\n"},{"port":"{\n"},{"port":"    return !(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_TRAINER | BATTLE_TYPE_FIRST_BATTLE | BATTLE_TYPE_SAFARI\n"},{"port":"                                 | BATTLE_TYPE_BATTLE_TOWER | BATTLE_TYPE_OLD_MAN_TUTORIAL | BATTLE_TYPE_EREADER_TRAINER\n"},{"port":"                                 | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_TRAINER_TOWER));\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The balls in the Bag, in its order: their items and quantities; how many.\n"},{"port":"static int CtrQuickBall_List(u16 *items, u16 *counts)\n"},{"port":"{\n"},{"port":"    struct BagPocket *pocket = &gBagPockets[POCKET_POKE_BALLS - 1];\n"},{"port":"    int i, n = 0;\n"},{"port":"\n"},{"port":"    for (i = 0; i < pocket->capacity && n < BAG_POKEBALLS_COUNT; i++)\n"},{"port":"    {\n"},{"port":"        u16 item = pocket->itemSlots[i].itemId, count = GetBagItemQuantity(&pocket->itemSlots[i].quantity);\n"},{"port":"\n"},{"port":"        if (item != ITEM_NONE && count != 0)\n"},{"port":"        {\n"},{"port":"            items[n] = item;\n"},{"port":"            counts[n++] = count;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"    return n;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The ball shown: its place in the list (the one last thrown when the button has shown none yet, else the first).\n"},{"port":"static int CtrQuickBall_Pick(const u16 *items, int n)\n"},{"port":"{\n"},{"port":"    int i;\n"},{"port":"    u16 last;\n"},{"port":"\n"},{"port":"    for (i = 0; i < n; i++)\n"},{"port":"        if (items[i] == sCtrBall)\n"},{"port":"            return i;\n"},{"port":"    last = (u16)CtrSettings_LastBall();\n"},{"port":"    for (i = 0; i < n; i++)\n"},{"port":"        if (items[i] == last)\n"},{"port":"            break;\n"},{"port":"    if (i >= n)\n"},{"port":"        i = 0;\n"},{"port":"    sCtrBall = n ? items[i] : ITEM_NONE;\n"},{"port":"    return i;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// CTR_QUICK_BALL_*: whether the button is there and what it shows (the ball, how many, its place among `count`).\n"},{"port":"int CtrBattle_QuickBall(unsigned *item, unsigned *quantity, int *place, int *count)\n"},{"port":"{\n"},{"port":"    u16 items[BAG_POKEBALLS_COUNT], counts[BAG_POKEBALLS_COUNT];\n"},{"port":"    int n, i;\n"},{"port":"\n"},{"port":"    *item = *quantity = 0;\n"},{"port":"    *place = *count = 0;\n"},{"port":"    if (gMain.callback2 != BattleMainCB2 || !CtrQuickBall_Battle())\n"},{"port":"        return CTR_QUICK_BALL_NONE;\n"},{"port":"    n = CtrQuickBall_List(items, counts);\n"},{"port":"    *count = n;\n"},{"port":"    if (n == 0)\n"},{"port":"        return CTR_QUICK_BALL_EMPTY;\n"},{"port":"    i = CtrQuickBall_Pick(items, n);\n"},{"port":"    *item = items[i];\n"},{"port":"    *quantity = counts[i];\n"},{"port":"    *place = i;\n"},{"port":"    return IsPlayerPartyAndPokemonStorageFull() ? CTR_QUICK_BALL_FULL : CTR_QUICK_BALL_READY;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBattle_QuickBallReady(void)\n"},{"port":"{\n"},{"port":"    unsigned item, quantity;\n"},{"port":"    int place, count;\n"},{"port":"\n"},{"port":"    return CtrBattle_QuickBall(&item, &quantity, &place, &count) == CTR_QUICK_BALL_READY;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The next (dir 1) or previous (-1) ball, round the list, with the menu's sound.\n"},{"port":"void CtrBattle_QuickBallStep(int dir)\n"},{"port":"{\n"},{"port":"    u16 items[BAG_POKEBALLS_COUNT], counts[BAG_POKEBALLS_COUNT];\n"},{"port":"    int n = CtrQuickBall_List(items, counts), i;\n"},{"port":"\n"},{"port":"    if (n < 2)\n"},{"port":"        return;\n"},{"port":"    i = CtrQuickBall_Pick(items, n);\n"},{"port":"    i = (i + (dir < 0 ? n - 1 : 1)) % n;\n"},{"port":"    sCtrBall = items[i];\n"},{"port":"    PlaySE(SE_SELECT);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The Berry Pouch, when the Bag has it: the battle Bag's BERRIES button opens it (ITEM_NONE when there is none).\n"},{"port":"unsigned CtrBattle_BerryPouch(void)\n"},{"port":"{\n"},{"port":"    return CheckBagHasItem(ITEM_BERRY_POUCH, 1) ? ITEM_BERRY_POUCH : ITEM_NONE;\n"},{"port":"}\n"},{"span":[3422,55]}]},{"path":"src/item_menu.c","before_sha256":"eeb5940467e30ca32e65d09fcf0d4c897fbb89de30751cdd802a77bc31cd051e","after_sha256":"7dfc349e6ae816fe13e0f175dedef266f97e5d1fc6f9323791eabccca5cd6514","remove":false,"lines":[{"span":[0,385]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // Twin Embers: the battle Bag is the items (the balls have their own button on the lower screen), so it opens there.\n"},{"port":"    GoToBagMenu(ITEMMENULOCATION_BATTLE, OPEN_BAG_ITEMS, SetCB2ToReshowScreenAfterMenu2);\n"},{"port":"#else\n"},{"line":385},{"port":"#endif\n"},{"span":[386,2423]}]}]}
 *y = *y < uy ? *y : uy;\n"},{"port":"        *w = right - *x;\n"},{"port":"        *h = bottom - *y;\n"},{"port":"        return 1;\n"},{"port":"    }\n"},{"port":"    *x = ux;\n"},{"port":"    *y = uy;\n"},{"port":"    *w = uw;\n"},{"port":"    *h = uh;\n"},{"span":[642,65]},{"port":"    if (CtrUnionMsg_Text(out, size))\n"},{"port":"        return 1;                    // the Union Room's own message box (its YES/NO, its lists, its notices)\n"},{"span":[707,614]}]},{"path":"src/text_printer.c","before_sha256":"61760b6db8bbf439c383339062c928aa8f9eb7faac412a883da1f309b745761d","after_sha256":"c9275e38ad7823b02b4cc60b634550fe49e21cb330dcc56a48afc697b546235e","remove":false,"lines":[{"span":[0,350]},{"port":"\n"},{"port":"// Where a running printer is in its text: the Union Room's message on the lower screen reads the page the box shows from it. NULL when it is not running.\n"},{"port":"const u8 *CtrTextPrinter_Position(u8 id)\n"},{"port":"{\n"},{"port":"    return id < NUM_TEXT_PRINTERS && sTextPrinters[id].active ? sTextPrinters[id].printerTemplate.currentChar : NULL;\n"},{"port":"}\n"},{"span":[350,1]}]},{"path":"src/union_room.c","before_sha256":"b11dc7766bac4fdb277092028eda7941c0b471636fb598b96e0801df5a22d07b","after_sha256":"f9cfbdb08464fb975288ae7d2772470cd4dae4d6a140e24b6e69ed09494af633","remove":false,"lines":[{"span":[0,394]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The room's message box for the lower screen (3ds_bottom.c): the text the room printed in it last, as the note of a field choice (the room's\n"},{"port":"// YES/NO and lists keep their rows) with an OK when the box waits for A. It is up for as long as the box is on BG0, and the upper screen leaves\n"},{"port":"// the box out meanwhile. The page shown is the one the printer is on (a \\p starts the next).\n"},{"port":"#define CTR_UNION_MSG_LEN 192\n"},{"port":"extern int CtrBottom_IsFieldCallback(void);\n"},{"port":"extern int CtrText_WaitsForButton(void);\n"},{"port":"extern const u8 *CtrTextPrinter_Position(u8 id);\n"},{"port":"extern void CtrBattle_FireRedText(const u8 *text, char *out, int size);\n"},{"port":"static u8 sCtrUnionMsg[CTR_UNION_MSG_LEN];\n"},{"port":"static u8 sCtrUnionPage[CTR_UNION_MSG_LEN];\n"},{"port":"static bool8 sCtrUnionMsgOn = FALSE;\n"},{"port":"\n"},{"port":"static void CtrUnionMsg_Note(const u8 *text)\n"},{"port":"{\n"},{"port":"    int i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < CTR_UNION_MSG_LEN - 1 && text[i] != EOS; i++)\n"},{"port":"        sCtrUnionMsg[i] = text[i];\n"},{"port":"    sCtrUnionMsg[i] = EOS;\n"},{"port":"    sCtrUnionMsgOn = TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The box's frame is on BG0 (its top left corner tile is not empty).\n"},{"port":"static bool8 CtrUnionMsg_BoxUp(void)\n"},{"port":"{\n"},{"port":"    u16 *map = GetBgTilemapBuffer(GetWindowAttribute(0, WINDOW_BG));\n"},{"port":"    s32 x = GetWindowAttribute(0, WINDOW_TILEMAP_LEFT) - 2, y = GetWindowAttribute(0, WINDOW_TILEMAP_TOP) - 1;\n"},{"port":"\n"},{"port":"    return map != NULL && x >= 0 && y >= 0 && map[y * 32 + x] != 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrUnionMsg_Active(void)\n"},{"port":"{\n"},{"port":"    if (!sCtrUnionMsgOn)\n"},{"port":"        return 0;\n"},{"port":"    if (!CtrBottom_IsFieldCallback() || !CtrUnionMsg_BoxUp())\n"},{"port":"    {\n"},{"port":"        sCtrUnionMsgOn = FALSE;   // the field cleared the box, or the room was left\n"},{"port":"        return 0;\n"},{"port":"    }\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrUnionMsg_Rect(int *x, int *y, int *w, int *h)\n"},{"port":"{\n"},{"port":"    if (!CtrUnionMsg_Active())\n"},{"port":"        return 0;\n"},{"port":"    *x = GetWindowAttribute(0, WINDOW_TILEMAP_LEFT) - 2;\n"},{"port":"    *y = GetWindowAttribute(0, WINDOW_TILEMAP_TOP) - 1;\n"},{"port":"    *w = GetWindowAttribute(0, WINDOW_WIDTH) + 4;\n"},{"port":"    *h = GetWindowAttribute(0, WINDOW_HEIGHT) + 2;\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The page the box shows: from the last \\p the printer has gone past up to the next one (or the end of the text).\n"},{"port":"int CtrUnionMsg_Text(char *out, int size)\n"},{"port":"{\n"},{"port":"    const u8 *pos = CtrTextPrinter_Position(0);\n"},{"port":"    int len = StringLength(sCtrUnionMsg), at = 0, start = 0, end, i;\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!CtrUnionMsg_Active())\n"},{"port":"        return 0;\n"},{"port":"    if (pos != NULL && pos >= gStringVar4 && pos <= gStringVar4 + len)\n"},{"port":"        at = pos - gStringVar4;\n"},{"port":"    else if (pos == NULL)\n"},{"port":"        at = len;\n"},{"port":"    end = len;\n"},{"port":"    for (i = 0; i < len; i++)\n"},{"port":"    {\n"},{"port":"        if (sCtrUnionMsg[i] != CHAR_PROMPT_CLEAR)\n"},{"port":"            continue;\n"},{"port":"        if (i + 1 < at)\n"},{"port":"        {\n"},{"port":"            start = i + 1;   // a page the printer has finished\n"},{"port":"            continue;\n"},{"port":"        }\n"},{"port":"        end = i;\n"},{"port":"        break;\n"},{"port":"    }\n"},{"port":"    if (start >= end && start > 0)\n"},{"port":"    {\n"},{"port":"        // The text ends on a \\p: the last page stays.\n"},{"port":"        end = start - 1;\n"},{"port":"        for (start = end; start > 0 && sCtrUnionMsg[start - 1] != CHAR_PROMPT_CLEAR; start--)\n"},{"port":"            ;\n"},{"port":"    }\n"},{"port":"    for (i = start; i < end && i - start < CTR_UNION_MSG_LEN - 1; i++)\n"},{"port":"        sCtrUnionPage[i - start] = sCtrUnionMsg[i];\n"},{"port":"    sCtrUnionPage[i - start] = EOS;\n"},{"port":"    CtrBattle_FireRedText(sCtrUnionPage, out, size);\n"},{"port":"    return out[0] != 0;\n"},{"port":"}\n"},{"port":"#endif\n"},{"span":[394,3487]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrUnionMsg_Note(gStringVar4);\n"},{"port":"#endif\n"},{"span":[3881,20]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"      
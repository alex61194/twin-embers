{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"2953af9bfabd0eaa900fe2af1bb68bbc7e9e742ac5f63ede9d68f629b6dce1e4","after_sha256":"8196a540f70c1015bd4035278ef5f479c0584667a20159e5275aa10200867bfb","remove":false,"lines":[{"span":[0,48]},{"port":"// ctr_poketouch_options.c: FireRed's own game options, for the native OPTIONS\n"},{"port":"// screen (3ds_port/src/3ds_poketouch_options.c): how many values an option\n"},{"port":"// has, its value in the save, and a new one (SOUND applies mono/stereo at once)\n"},{"port":"int CtrPokeTouch_OptionCount(int option);\n"},{"port":"int CtrPokeTouch_OptionGet(int option);\n"},{"port":"void CtrPokeTouch_OptionSet(int option, int value);\n"},{"line":74},{"span":[48,28]}]},{"path":"src/ctr_poketouch_options.c","before_sha256":null,"after_sha256":"c646941dbf6c30a650f35d94816c53e3489fa799968c3b62f697e2de57cdc8fe","remove":false,"lines":[{"port":"/* PokeTouch bridge: FireRed's own game options for the native OPTIONS screen.\n"},{"port":" *\n"},{"port":" * The values live in the save (gSaveBlock2Ptr), where FireRed's Options menu\n"},{"port":" * reads and writes them; nothing here keeps a copy. The ranges are the menu's\n"},{"port":" * (option_menu.c, sOptionMenuItemCounts). Changing SOUND does what the menu\n"},{"port":" * does when it saves: it applies the mono/stereo setting to the cries at once.\n"},{"port":" */\n"},{"port":"#include \"global.h\"\n"},{"port":"#include \"gba/m4a_internal.h\"\n"},{"port":"#include \"3ds_poketouch.h\"\n"},{"port":"#include \"ctr_poketouch.h\"\n"},{"port":"\n"},{"port":"int CtrPokeTouch_OptionCount(int option)\n"},{"port":"{\n"},{"port":"    switch (option)\n"},{"port":"    {\n"},{"port":"    case PT_OPT_TEXT_SPEED:   return 3;   // OPTIONS_TEXT_SPEED_SLOW, MID, FAST\n"},{"port":"    case PT_OPT_BATTLE_SCENE: return 2;   // on, off (optionsBattleSceneOff)\n"},{"port":"    case PT_OPT_BATTLE_STYLE: return 2;   // OPTIONS_BATTLE_STYLE_SHIFT, SET\n"},{"port":"    case PT_OPT_SOUND:        return 2;   // OPTIONS_SOUND_MONO, STEREO\n"},{"port":"    case PT_OPT_BUTTON_MODE:  return 3;   // OPTIONS_BUTTON_MODE_HELP, LR, L_EQUALS_A\n"},{"port":"    case PT_OPT_FRAME:        return 10;  // the menu's ten frame types\n"},{"port":"    }\n"},{"port":"    return 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrPokeTouch_OptionGet(int option)\n"},{"port":"{\n"},{"port":"    switch (option)\n"},{"port":"    {\n"},{"port":"    case PT_OPT_TEXT_SPEED:   return gSaveBlock2Ptr->optionsTextSpeed;\n"},{"port":"    case PT_OPT_BATTLE_SCENE: return gSaveBlock2Ptr->optionsBattleSceneOff;\n"},{"port":"    case PT_OPT_BATTLE_STYLE: return gSaveBlock2Ptr->optionsBattleStyle;\n"},{"port":"    case PT_OPT_SOUND:        return gSaveBlock2Ptr->optionsSound;\n"},{"port":"    case PT_OPT_BUTTON_MODE:  return gSaveBlock2Ptr->optionsButtonMode;\n"},{"port":"    case PT_OPT_FRAME:        return gSaveBlock2Ptr->optionsWindowFrameType;\n"},{"port":"    }\n"},{"port":"    return 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrPokeTouch_OptionSet(int option, int value)\n"},{"port":"{\n"},{"port":"    if (value < 0 || value >= CtrPokeTouch_OptionCount(option))\n"},{"port":"        return;\n"},{"port":"    switch (option)\n"},{"port":"    {\n"},{"port":"    case PT_OPT_TEXT_SPEED:   gSaveBlock2Ptr->optionsTextSpeed = value; break;\n"},{"port":"    case PT_OPT_BATTLE_SCENE: gSaveBlock2Ptr->optionsBattleSceneOff = value; break;\n"},{"port":"    case PT_OPT_BATTLE_STYLE: gSaveBlock2Ptr->optionsBattleStyle = value; break;\n"},{"port":"    case PT_OPT_SOUND:\n"},{"port":"        gSaveBlock2Ptr->optionsSound = value;\n"},{"port":"        SetPokemonCryStereo(gSaveBlock2Ptr->optionsSound);\n"},{"port":"        break;\n"},{"port":"    case PT_OPT_BUTTON_MODE:  gSaveBlock2Ptr->optionsButtonMode = value; break;\n"},{"port":"    case PT_OPT_FRAME:        gSaveBlock2Ptr->optionsWindowFrameType = value; break;\n"},{"port":"    }\n"},{"port":"}\n"}]}]}

iddle one, so a cell 13 or more\n"},{"port":"// tiles across or 8 or more tiles up and down from the player is off the screen, and the wild walks into view instead of appearing in it. 15 and 10 keep it\n"},{"port":"// close enough to be met in a few steps (and inside what the object events keep alive).\n"},{"port":"static bool8 CtrWild_PickNear(const struct ObjectEvent *player, int surfing, int *x, int *y, int *kind)\n"},{"port":"{\n"},{"port":"    int px = player->currentCoords.x;\n"},{"port":"    int py = player->currentCoords.y;\n"},{"port":"    int left = gSaveBlock1Ptr->pos.x - OBJECT_EVENT_VIEW_LEFT;\n"},{"port":"    int right = gSaveBlock1Ptr->pos.x + OBJECT_EVENT_VIEW_RIGHT;\n"},{"port":"    int top = gSaveBlock1Ptr->pos.y - OBJECT_EVENT_VIEW_TOP;\n"},{"port":"    int bottom = gSaveBlock1Ptr->pos.y + OBJECT_EVENT_VIEW_BOTTOM;\n"},{"port":"    int tries;\n"},{"port":"\n"},{"port":"    for (tries = 0; tries < 48; tries++)\n"},{"port":"    {\n"},{"port":"        int dx = (int)(CtrWildsCore_Rand(&gCtrWilds) % 31u) - 15;\n"},{"port":"        int dy = (int)(CtrWildsCore_Rand(&gCtrWilds) % 21u) - 10;\n"},{"port":"        int cx = px + dx, cy = py + dy, tile;\n"},{"port":"\n"},{"port":"        if (CtrWild_Abs(dx) < 13 && CtrWild_Abs(dy) < 8)\n"},{"port":"            continue;       // on the screen\n"},{"port":"        if (CtrWild_NearOther(cx, cy))\n"},{"port":"            continue;\n"},{"port":"        if (cx < left || cx > right || cy < top || cy > bottom)\n"},{"port":"            continue;\n"},{"port":"        tile = CtrWild_Cell((void *)player, cx, cy);\n"},{"port":"        if (tile == CTRW_TILE_NONE || !CtrWildsCore_AcceptKind(&gCtrWilds, tile, gCtrWilds.mapLand, gCtrWilds.mapWater, surfing))\n"},{"port":"            continue;\n"},{"port":"        *x = cx;\n"},{"port":"        *y = cy;\n"},{"port":"        *kind = tile;\n"},{"port":"        return TRUE;\n"},{"port":"    }\n"},{"port":"    return FALSE;\n"},{"port":"}\n"},{"port":"\n"},{"span":[9676,2]},{"span"
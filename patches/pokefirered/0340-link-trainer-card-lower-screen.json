{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/trainer_card.c","before_sha256":"c22882692f829627ab4da85c75748bc4375b96ab8f4fb839a59bf551164cf056","after_sha256":"88c92e5d0ba6abcf71f677be7657b9e01acecd57345b2338a31b055000436252","remove":false,"lines":[{"span":[0,668]},{"port":"/* 0: set up, fading, flipping, closing or waiting for the other trainer (no key does anything useful), 1: the\n"},{"port":" * front takes input (A flips it, B closes it), 2: the back does (B flips it back, A closes it; in a link B and A both\n"},{"port":" * close it, see CtrBottomCard_BackCloses). */\n"},{"span":[671,2]},{"port":"    if (sTrainerCardDataPtr == NULL || gPaletteFade.active)\n"},{"span":[675,19]},{"port":"/* What the lower screen draws for the card (3ds_bottom.c): which side is up, FireRed's labels, the numbers it\n"},{"span":[695,1]},{"port":" * The player's own card and another player's in a link both, whatever the card's type: the lower screen never shows the card inside the HOME frame. */\n"},{"span":[697,2]},{"port":"    return sTrainerCardDataPtr != NULL;\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* The card is shown in a link (another player's, or the own one in the Union Room): the lower screen says so. */\n"},{"port":"int CtrBottomCard_IsLink(void)\n"},{"port":"{\n"},{"port":"    return sTrainerCardDataPtr != NULL && (sTrainerCardDataPtr->isLink || gReceivedRemoteLinkPlayers);\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* In a link the back is left with B or A (it never turns back to the front): a tap on it sends a closing key. */\n"},{"port":"int CtrBottomCard_BackCloses(void)\n"},{"port":"{\n"},{"port":"    return sTrainerCardDataPtr != NULL && gReceivedRemoteLinkPlayers;\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* FireRed's \"waiting for the trainer to finish reading\" while the Union Room's card waits for the partner (empty otherwise). */\n"},{"port":"void CtrBottomCard_Wait(char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (sTrainerCardDataPtr != NULL\n"},{"port":"     && (sTrainerCardDataPtr->mainState == STATE_WAIT_LINK_PARTNER || sTrainerCardDataPtr->mainState == STATE_CLOSE_CARD_LINK))\n"},{"port":"        CtrBattle_FireRedText(gText_WaitingTrainerFinishReading, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* The upper screen keeps the room the players are in (the Union Room's, the Cable Club's) from the moment the card is\n"},{"port":" * asked for, before the screen fades, until the field is back. A start whose card never comes, or a card gone without\n"},{"port":" * the field returning, lets go after ten seconds. */\n"},{"port":"static EWRAM_DATA u8 sCtrCardHold = 0;\n"},{"port":"static EWRAM_DATA u8 sCtrCardHoldSeen = 0;\n"},{"port":"static EWRAM_DATA u32 sCtrCardHoldFrame = 0;\n"},{"port":"\n"},{"port":"extern int CtrBottom_IsFieldCallback(void);   // CB2_Overworld is private to overworld.c\n"},{"port":"\n"},{"port":"static void CtrBottomCard_LinkHoldStart(void)\n"},{"port":"{\n"},{"port":"    sCtrCardHold = TRUE;\n"},{"port":"    sCtrCardHoldSeen = FALSE;\n"},{"port":"    sCtrCardHoldFrame = gMain.vblankCounter2;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomCard_LinkHold(void)\n"},{"port":"{\n"},{"port":"    if (!sCtrCardHold)\n"},{"port":"        return FALSE;\n"},{"port":"    if (sTrainerCardDataPtr != NULL)\n"},{"port":"    {\n"},{"port":"        sCtrCardHoldSeen = TRUE;\n"},{"port":"        sCtrCardHoldFrame = gMain.vblankCounter2;\n"},{"port":"    }\n"},{"port":"    else if ((sCtrCardHoldSeen && CtrBottom_IsFieldCallback())\n"},{"port":"          || (s32)(gMain.vblankCounter2 - sCtrCardHoldFrame) > 60 * 10)\n"},{"port":"        sCtrCardHold = FALSE;\n"},{"port":"    return sCtrCardHold;\n"},{"span":[701,52]},{"port":"    if (sTrainerCardDataPtr->isLink)\n"},{"port":"    {\n"},{"port":"        // Another player's card: its own Pokedex and play time, not this save's.\n"},{"port":"        out[2] = card->hasPokedex != 0;\n"},{"port":"        out[4] = card->playTimeHours > 999 ? 999 : card->playTimeHours;\n"},{"port":"        out[5] = card->playTimeMinutes > 59 ? 59 : card->playTimeMinutes;\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"    {\n"},{"port":"        out[2] = FlagGet(FLAG_SYS_POKEDEX_GET) != 0;\n"},{"port":"        out[4] = gSaveBlock2Ptr->playTimeHours > 999 ? 999 : gSaveBlock2Ptr->playTimeHours;\n"},{"port":"        out[5] = gSaveBlock2Ptr->playTimeMinutes > 59 ? 59 : gSaveBlock2Ptr->playTimeMinutes;\n"},{"port":"    }\n"},{"span":[754,1]},{"span":[757,1313]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    if (sTrainerCardDataPtr->isLink || gReceivedRemoteLinkPlayers)\n"},{"port":"        CtrBottomCard_LinkHoldStart();\n"},{"port":"#endif\n"},{"span":[2070,10]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrBottomCard_LinkHoldStart();\n"},{"port":"#endif\n"},{"span":[2080,88]}]}]}
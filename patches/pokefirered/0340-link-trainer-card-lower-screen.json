{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/trainer_card.c","before_sha256":"c22882692f829627ab4da85c75748bc4375b96ab8f4fb839a59bf551164cf056","after_sha256":"9d6a2755f8d9a6cf90bf13c7efc84e10985cd1a75b1c74f3a6343174e38c844c","remove":false,"lines":[{"span":[0,668]},{"port":"/* 0: set up, fading, flipping, closing or waiting for the other trainer (no key does anything useful), 1: the\n"},{"port":" * front takes input (A flips it, B closes it), 2: the back does (B flips it back, A closes it; in a link B and A both\n"},{"port":" * close it, see CtrBottomCard_BackCloses). */\n"},{"span":[671,2]},{"port":"    if (sTrainerCardDataPtr == NULL || gPaletteFade.active)\n"},{"span":[675,19]},{"port":"/* What the lower screen draws for the card (3ds_bottom.c): which side is up, FireRed's labels, the numbers it\n"},{"line":695},{"port":" * The player's own card and another player's in a link both, whatever the card's type: the lower screen never shows the card inside the HOME frame. */\n"},{"span":[697,2]},{"line":665},{"line":457},{"line":27},{"port":"/* The card is shown in a link (another player's, or the own one in the Union Room): the lower screen says so. */\n"},{"port":"int CtrBottomCard_IsLink(void)\n"},{"line":30},{"port":"    return sTrainerCardDataPtr != NULL && (sTrainerCardDataPtr->isLink || gReceivedRemoteLinkPlayers);\n"},{"line":457},{"line":27},{"port":"/* In a link the back is left with B or A (it never turns back to the front): a tap on it sends a closing key. */\n"},{"port":"int CtrBottomCard_BackCloses(void)\n"},{"line":30},{"port":"    return sTrainerCardDataPtr != NULL && gReceivedRemoteLinkPlayers;\n"},{"line":457},{"line":27},{"port":"/* FireRed's \"waiting for the trainer to finish reading\" while the Union Room's card waits for the partner (empty otherwise). */\n"},{"port":"void CtrBottomCard_Wait(char *out, int size)\n"},{"line":30},{"line":716},{"port":"    if (sTrainerCardDataPtr != NULL\n"},{"port":"     && (sTrainerCardDataPtr->mainState == STATE_WAIT_LINK_PARTNER || sTrainerCardDataPtr->mainState == STATE_CLOSE_CARD_LINK))\n"},{"port":"        CtrBattle_FireRedText(gText_WaitingTrainerFinishReading, out, size);\n"},{"line":457},{"line":27},{"port":"/* The upper screen keeps the room the players are in (the Union Room's, the Cable Club's) from the moment the card is\n"},{"port":" * asked for, before the screen fades, until the field is back. A start whose card never comes, or a card gone without\n"},{"port":" * the field returning, lets go after ten seconds. */\n"},{"port":"static EWRAM_DATA u8 sCtrCardHold = 0;\n"},{"port":"static EWRAM_DATA u8 sCtrCardHoldSeen = 0;\n"},{"port":"static EWRAM_DATA u32 sCtrCardHoldFrame = 0;\n"},{"line":27},{"port":"static void CtrBottomCard_LinkHoldStart(void)\n"},{"line":30},{"port":"    sCtrCardHold = TRUE;\n"},{"port":"    sCtrCardHoldSeen = FALSE;\n"},{"port":"    sCtrCardHoldFrame = gMain.vblankCounter2;\n"},{"line":457},{"line":27},{"port":"int CtrBottomCard_LinkHold(void)\n"},{"line":30},{"port":"    if (!sCtrCardHold)\n"},{"line":1850},{"line":736},{"line":191},{"port":"        sCtrCardHoldSeen = TRUE;\n"},{"port":"        sCtrCardHoldFrame = gMain.vblankCounter2;\n"},{"line":226},{"port":"    else if ((sCtrCardHoldSeen && gMain.callback2 == CB2_Overworld)\n"},{"port":"          || (s32)(gMain.vblankCounter2 - sCtrCardHoldFrame) > 60 * 10)\n"},{"port":"        sCtrCardHold = FALSE;\n"},{"port":"    return sCtrCardHold;\n"},{"span":[701,52]},{"line":1416},{"line":191},{"port":"        // Another player's card: its own Pokedex and play time, not this save's.\n"},{"port":"        out[2] = card->hasPokedex != 0;\n"},{"port":"        out[4] = card->playTimeHours > 999 ? 999 : card->playTimeHours;\n"},{"port":"        out[5] = card->playTimeMinutes > 59 ? 59 : card->playTimeMinutes;\n"},{"line":226},{"line":1085},{"line":191},{"port":"        out[2] = FlagGet(FLAG_SYS_POKEDEX_GET) != 0;\n"},{"port":"        out[4] = gSaveBlock2Ptr->playTimeHours > 999 ? 999 : gSaveBlock2Ptr->playTimeHours;\n"},{"port":"        out[5] = gSaveBlock2Ptr->playTimeMinutes > 59 ? 59 : gSaveBlock2Ptr->playTimeMinutes;\n"},{"line":226},{"line":754},{"span":[757,1313]},{"line":1},{"port":"    if (sTrainerCardDataPtr->isLink || gReceivedRemoteLinkPlayers)\n"},{"port":"        CtrBottomCard_LinkHoldStart();\n"},{"line":6},{"span":[2070,10]},{"line":1},{"port":"    CtrBottomCard_LinkHoldStart();\n"},{"line":6},{"span":[2080,88]}]}]}

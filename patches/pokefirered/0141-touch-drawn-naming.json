{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/naming_screen.c","before_sha256":"577953b794ec9e57c3dae7d86a8671cd7a43cb75776d2bf3499a2053ac6719c1","after_sha256":"ac11fbbd8259f2715430ea3a6f395b03ee048da6aa49e0bb839611d28e65df91","remove":false,"lines":[{"span":[0,2526]},{"port":"\n"},{"port":"// The naming screen drawn by the lower screen (3ds_bottom.c) as a remote: whether it is open and takes a key, its page\n"},{"port":"// and columns, the key under each place (FireRed's own character codes, EOS for none), the text so far, its length, the\n"},{"port":"// question, the Pokemon being named, and the cursor. A touched key only moves FireRed's own cursor there; the lower\n"},{"port":"// screen then presses A, so the character goes in through the screen's own handler, its sound and its full-text rule.\n"},{"port":"int CtrBottomNaming_IsOpen(void)\n"},{"port":"{\n"},{"port":"    return sNamingScreen != NULL && gMain.callback2 == CB2_NamingScreen && sNamingScreen->template != NULL\n"},{"port":"        && sNamingScreen->state >= STATE_HANDLE_INPUT && sNamingScreen->state < STATE_FADE_OUT;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomNaming_Ready(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomNaming_IsOpen() && sNamingScreen->state == STATE_HANDLE_INPUT && !gPaletteFade.active\n"},{"port":"        && FuncIsActiveTask(Task_HandleInput)\n"},{"port":"        && gTasks[FindTaskIdByFunc(Task_HandleInput)].data[0] == INPUT_STATE_ENABLED;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomNaming_Page(void)\n"},{"port":"{\n"},{"port":"    return sNamingScreen->currentPage;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomNaming_Columns(void)\n"},{"port":"{\n"},{"port":"    return GetCurrentPageColumnCount();\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomNaming_Key(int row, int col)\n"},{"port":"{\n"},{"port":"    if (row < 0 || row >= KBROW_COUNT || col < 0 || col >= GetCurrentPageColumnCount())\n"},{"port":"        return EOS;\n"},{"port":"    return sKeyboardChars[CurrentPageToKeyboardId()][row][col];\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomNaming_MaxChars(void)\n"},{"port":"{\n"},{"port":"    return sNamingScreen->template->maxChars;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The text so far as FireRed's codes, `size` at most, ended by EOS.\n"},{"port":"void CtrBottomNaming_Text(u8 *out, int size)\n"},{"port":"{\n"},{"port":"    int i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < size - 1 && i < sNamingScreen->template->maxChars && sNamingScreen->textBuffer[i] != EOS; i++)\n"},{"port":"        out[i] = sNamingScreen->textBuffer[i];\n"},{"port":"    out[i] = EOS;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The question as the screen prints it (a Pokemon's is its species' name before it), as FireRed's codes.\n"},{"port":"void CtrBottomNaming_Title(u8 *out, int size)\n"},{"port":"{\n"},{"port":"    u8 buffer[32];\n"},{"port":"\n"},{"port":"    buffer[0] = EOS;\n"},{"port":"    if (sNamingScreen->template->addGenderIcon)\n"},{"port":"        StringCopy(buffer, gSpeciesNames[sNamingScreen->monSpecies]);\n"},{"port":"    StringAppendN(buffer, sNamingScreen->template->title, 15);\n"},{"port":"    StringCopyN(out, buffer, size - 1);\n"},{"port":"    out[size - 1] = EOS;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The Pokemon being named (0 for a player, a rival or a box) and its gender sign (1 male, 2 female, 0 none).\n"},{"port":"int CtrBottomNaming_Species(void)\n"},{"port":"{\n"},{"port":"    return sNamingScreen->template->iconFunction == 3 ? sNamingScreen->monSpecies : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomNaming_Gender(void)\n"},{"port":"{\n"},{"port":"    if (!sNamingScreen->template->addGenderIcon || sNamingScreen->monGender == MON_GENDERLESS)\n"},{"port":"        return 0;\n"},{"port":"    return sNamingScreen->monGender == MON_FEMALE ? 2 : 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// FireRed's cursor: its column (the column count for the buttons: page, back and OK on rows 0 to 2) and row.\n"},{"port":"void CtrBottomNaming_Cursor(int *col, int *row)\n"},{"port":"{\n"},{"port":"    s16 x, y;\n"},{"port":"\n"},{"port":"    GetCursorPos(&x, &y);\n"},{"port":"    *col = x;\n"},{"port":"    *row = y;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Puts FireRed's cursor on a key (or, at the column count, on a button), as its D-pad would.\n"},{"port":"int CtrBottomNaming_Touch(int col, int row)\n"},{"port":"{\n"},{"port":"    if (!CtrBottomNaming_Ready() || row < 0 || row >= KBROW_COUNT || col < 0 || col > GetCurrentPageColumnCount()\n"},{"port":"        || (col == GetCurrentPageColumnCount() && row >= BUTTON_COUNT))\n"},{"port":"        return 0;\n"},{"port":"    SetCursorPos(col, row);\n"},{"port":"    return 1;\n"},{"port":"}\n"}]}]}

{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/field_screen_effect.c","before_sha256":"a567daa99e68e748b9aac7e18d188d36bcc1a143873b931bf5e27c75a82cf6ad","after_sha256":"718630a77224c8f8790d8921a1d306c0195dc1b839050a7cf45d967085b5e6d7","remove":false,"lines":[{"span":[0,274]},{"port":"/* Encode only the barn-door wipe in 0..240 units: the native screen is\n"},{"port":" * wider than the 8-bit window registers. The compositor decodes this while\n"},{"port":" * the task is active; its timing and the saved registers remain unchanged. */\n"},{"port":"static void BarnDoorWipeSetWindowBounds(s16 lhs, s16 rhs)\n"},{"line":454},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    lhs = (lhs * 240 + DISPLAY_WIDTH / 2) / DISPLAY_WIDTH;\n"},{"port":"    rhs = (rhs * 240 + DISPLAY_WIDTH / 2) / DISPLAY_WIDTH;\n"},{"port":"    SetGpuReg(REG_OFFSET_WIN0H, WIN_RANGE(0, lhs));\n"},{"port":"    SetGpuReg(REG_OFFSET_WIN1H, WIN_RANGE(rhs, 240));\n"},{"port":"#else\n"},{"line":343},{"line":344},{"port":"#endif\n"},{"line":461},{"line":456},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"bool32 CtrField_BarnDoorWipeActive(void)\n"},{"line":454},{"port":"    return FuncIsActiveTask(Task_BarnDoorWipe);\n"},{"line":461},{"port":"#endif\n"},{"line":456},{"span":[274,11]},{"port":"                BarnDoorWipeSetWindowBounds(0, DISPLAY_WIDTH);\n"},{"span":[287,5]},{"port":"                BarnDoorWipeSetWindowBounds(DISPLAY_WIDTH / 2, DISPLAY_WIDTH / 2);\n"},{"span":[293,1]},{"span":[295,48]},{"port":"    BarnDoorWipeSetWindowBounds(lhs, rhs);\n"},{"span":[345,117]}]}]}

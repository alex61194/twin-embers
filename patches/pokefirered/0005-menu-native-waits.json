{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_transition.c","before_sha256":"e01b25dca81c1619001285344731492b74074a2d1517d65b3ec11baa8742c593","after_sha256":"0b31fa291ed381c9eeb34cadf004559087094fb163dc9a8777481f39a8a54eac","remove":false,"lines":[{"span":[0,632]},{"port":"        // Retire the transition's scanline callbacks and DMA before freeing\n"},{"port":"        // its state. Every VBlankCB_* variant dereferences sTransitionData\n"},{"port":"        // (e.g. vblankDma), as does HBlankCB_Mugshots, yet they stay\n"},{"port":"        // installed until the next screen installs its own callbacks. The\n"},{"port":"        // first VBlank after the free would otherwise touch freed state:\n"},{"port":"        // benign BIOS reads on GBA, MMU abort on ARM11 (e.g. rival battle\n"},{"port":"        // via VBlankCB_ClockwiseWipe). Same idiom as WhiteBarsFade's own\n"},{"port":"        // phase switch (DmaStop + NULL callbacks).\n"},{"line":2029},{"port":"        SetHBlankCallback(NULL);\n"},{"line":2725},{"span":[632,2405]}]},{"path":"src/item_menu.c","before_sha256":"155bd6b0943e8df179cbc9892e573cee52fd8f67a1d0dd39b962bdbec2e3546a","after_sha256":"e5f9815d9c073f9dde183359bbc987e5f8665eaddd4bd341a1e0f37cc700b17d","remove":false,"lines":[{"span":[0,374]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        TraceDma3MenuInit(\"bag\", gMain.state, sBagMenuDisplay->data[0]);\n"},{"port":"#endif\n"},{"span":[374,6]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        // ARM11 dispatches VBlank between callbacks, rather than interrupting\n"},{"port":"        // this loop. Let the real DMA manager finish queued graphics copies.\n"},{"port":"        if (WaitDma3Request(-1) == -1)\n"},{"line":2380},{"port":"#endif\n"},{"span":[380,2017]}]},{"path":"src/main_menu.c","before_sha256":"6662c42cb10a13c63bdc5efe53b88bbd7e3f602b3fe471868c28ece562d5f49c","after_sha256":"e25a94f17ffea69b68508390c1edbca355b05475c760b0238c16e729319fb9ce","remove":false,"lines":[{"span":[0,19]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_log.h\"\n"},{"port":"#endif\n"},{"span":[19,451]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrLog_Write(CTR_LOG_GAME, \"SAVE mainmenu path=newgame status=%u\", gSaveFileStatus);\n"},{"port":"#endif\n"},{"span":[470,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrLog_Write(CTR_LOG_GAME, \"HW MENU newgame windows freed\");\n"},{"port":"#endif\n"},{"span":[472,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrLog_Write(CTR_LOG_GAME, \"HW MENU newgame callback installed cb2=%p\", (void *)gMain.callback2);\n"},{"port":"#endif\n"},{"span":[474,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrLog_Write(CTR_LOG_GAME, \"SAVE mainmenu path=continue status=%u\", gSaveFileStatus);\n"},{"port":"#endif\n"},{"span":[476,4]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrLog_Write(CTR_LOG_GAME, \"HW MENU continue windows freed\");\n"},{"port":"#endif\n"},{"span":[480,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 09 continue callbacks cb1=%p cb2=%p\", (void *)gMain.callback1, (void *)gMain.callback2);\n"},{"port":"#endif\n"},{"span":[481,90]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW MENU A enter task=%u type=%d cursor=%d B1=%p B2=%p storage=%p\",\n"},{"port":"                     taskId, gTasks[taskId].tMenuType, gTasks[taskId].tCursorPos,\n"},{"port":"                     (void *)gSaveBlock1Ptr, (void *)gSaveBlock2Ptr, (void *)gPokemonStoragePtr);\n"},{"port":"#endif\n"},{"span":[571,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"SAVE mainmenu confirm cursor=%d status=%u\", gTasks[taskId].tCursorPos, gSaveFileStatus);\n"},{"port":"#endif\n"},{"span":[572,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW MENU A wireless returned\");\n"},{"port":"#endif\n"},{"span":[573,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW MENU A fade/task installed\");\n"},{"port":"#endif\n"},{"span":[575,213]}]},{"path":"src/naming_screen.c","before_sha256":"fbed8534a89a801f357fa04cfcbe91798fb80a4a1e24b127ad76eef0454bea13","after_sha256":"53e9827ae0353fd0d5512af861ac4596a2947fb005278d78fd020bac609c6f01","remove":false,"lines":[{"span":[0,724]},{"port":"        // Retire this screen's live callbacks before freeing its state.\n"},{"port":"        // The same CB2_NamingScreen frame continues into AnimateSprites(),\n"},{"port":"        // and VBlankCB_NamingScreen stays installed until the next screen\n"},{"port":"        // replaces it; both dereference sNamingScreen (e.g. currentPage).\n"},{"port":"        // On GBA the stale reads hit BIOS bytes benignly, on an MMU they\n"},{"port":"        // abort. Mirrors the ResetVHBlank/ResetSpriteData entry path.\n"},{"line":438},{"line":451},{"span":[724,1785]}]},{"path":"src/overworld.c","before_sha256":"df352e738b56856765aec65adc6fdea0a4b25fe567bc760d4ce2d34afc6ff7e2","after_sha256":"f5e4f7af7b03e29608e615b399443923073a7ccb821449537bd5232a848c3f46","remove":false,"lines":[{"span":[0,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_log.h\"\n"},{"line":1524},{"span":[1,1691]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 10 continue enter B1=%p B2=%p storage=%p\", (void *)gSaveBlock1Ptr, (void *)gSaveBlock2Ptr, (void *)gPokemonStoragePtr);\n"},{"line":1524},{"span":[1692,3]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 10 map header start map=%d.%d pos=%d,%d\",\n"},{"port":"                 gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum,\n"},{"port":"                 gSaveBlock1Ptr->pos.x, gSaveBlock1Ptr->pos.y);\n"},{"line":1524},{"span":[1695,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 10 map header/scripts ready\");\n"},{"line":1524},{"span":[1697,3]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 10 map initialized\");\n"},{"line":1524},{"span":[1700,11]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 10 warp callbacks installed\");\n"},{"line":1524},{"span":[1711,6]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrLog_Write(CTR_LOG_GAME, \"HW SAVE 10 field return cb2=%p\", (void *)gMain.callback2);\n"},{"line":1524},{"span":[1717,327]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    /* On the GBA this loop runs with the VBlank IRQ firing underneath it,\n"},{"port":"     * and step 9 (FreeTempTileDataBuffersIfPossible) waits for the DMA3\n"},{"port":"     * queue that only VBlankIntr's ProcessDma3Requests drains. ARM11 has no\n"},{"port":"     * asynchronous IRQ, so a step that makes no progress waits for the next\n"},{"port":"     * VBlank, as the GBA would have done there, instead of spinning forever. */\n"},{"port":"    for (;;)\n"},{"line":3558},{"port":"        u8 step = *state;\n"},{"port":"        if (LoadMapInStepsLocal(state, FALSE))\n"},{"line":2807},{"port":"        if (*state == step)\n"},{"port":"            VBlankIntrWait();\n"},{"line":3561},{"port":"#else\n"},{"span":[2044,1]},{"line":1524},{"span":[2045,196]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    /* Same wait as DoMapLoadLoop: step 8 needs VBlankIntr to drain DMA3. */\n"},{"port":"    for (;;)\n"},{"line":3558},{"port":"        u8 step = *state;\n"},{"port":"        if (LoadMap_QLPlayback(state))\n"},{"line":2807},{"port":"        if (*state == step)\n"},{"port":"            VBlankIntrWait();\n"},{"line":3561},{"port":"#else\n"},{"span":[2241,2]},{"line":1524},{"span":[2243,1320]}]},{"path":"src/party_menu.c","before_sha256":"8290dfd5b6444e743029ab76543ed5e4b5b32c1c2f475c686946545f934d5f9b","after_sha256":"ff134cdb00ff168c2cbe82776024355ddb15e294b8b4c8e20a155050749d4311","remove":false,"lines":[{"span":[0,478]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        TraceDma3MenuInit(\"party\", gMain.state, sPartyMenuInternal->data[0]);\n"},{"port":"#endif\n"},{"span":[478,2]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        // The native VBlank boundary can service DMA only after we return.\n"},{"port":"        if (WaitDma3Request(-1) == -1)\n"},{"line":6230},{"port":"#endif\n"},{"span":[480,5862]}]},{"path":"src/pokemon_summary_screen.c","before_sha256":"855a17fb555f5497dbb47f90a8c1b8cf620532d3bff96e8196d0790515508583","after_sha256":"995100fd2091104249c4d5cd4b5613456fa5750f9ebfa32be7fcbb803f4a8d3f","remove":false,"lines":[{"span":[0,2978]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // The next native VBlank occurs before the saved callback can initialize\n"},{"port":"    // its screen. Retire the summary handler before freeing its screen state.\n"},{"line":3134},{"port":"#endif\n"},{"span":[2978,1903]},{"port":"#ifndef PLATFORM_3DS\n"},{"span":[4881,1]},{"port":"#else\n"},{"port":"    // This setup step is the first creation in an AllocZeroed screen.\n"},{"port":"    // Updates reuse the sprite; PokeSum_DestroyMonMarkingsSprite owns teardown.\n"},{"port":"    // Destroying it here dereferences address 0x14 before any sprite exists.\n"},{"port":"#endif\n"},{"span":[4882,342]}]},{"path":"src/title_screen.c","before_sha256":"c2521f842e2f7385f429465330c50c663a88b24da7d419e6dbe77362643f56d5","after_sha256":"fc2e19836c815b43bd9b563f0e63d5217367189f516ac5090f58a97a8bab8d3b","remove":false,"lines":[{"span":[0,18]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_video.h\"\n"},{"line":645},{"span":[18,331]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        CtrVideo_SetNativeViewport(TRUE);\n"},{"line":645},{"span":[349,578]},{"line":1272},{"span":[927,1]},{"line":1309},{"span":[928,387]}]}]}

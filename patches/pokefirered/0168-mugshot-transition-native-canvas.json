{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_transition.c","before_sha256":"011ae1c1128f1ff1163a255d53e19d0538708ecd15cf7239b41f043915b7c4a9","after_sha256":"a45554e67da67d5c88a4de21d935ecdcbb31c2750daaa5a222c4f100df7e24a2","remove":false,"lines":[{"span":[0,644]},{"port":"\n"},{"port":"// Twin Embers: the banners of the trainer-pic transition (Elite Four, Champion, rival) are authored for 240x160, and\n"},{"port":"// the field under them is the 3DS's 400x240 canvas. The port draws the banners across all of it (BG0 repeated, WIN0H\n"},{"port":"// and BG0HOFS read per line, see CtrMugshot_Active/CtrMugshot_LineScroll), and the two pictures slide over the canvas\n"},{"port":"// centre: x2/y2 carry the 80/40 pixels that centre the 240x160 screen on 400x240, and the pictures start (and stop)\n"},{"port":"// past the canvas's own edges.\n"},{"port":"#define MUGSHOT_CANVAS_X 80\n"},{"port":"#define MUGSHOT_CANVAS_Y 40\n"},{"port":"#define MUGSHOT_CANVAS_W 400\n"},{"port":"\n"},{"port":"// The grid squares are one tile repeated over BG0's whole map, so the port repeats it over the canvas as well.\n"},{"port":"#define CANVAS_BG0_NONE    0\n"},{"port":"#define CANVAS_BG0_BANNERS 1\n"},{"port":"#define CANVAS_BG0_GRID    2\n"},{"port":"\n"},{"port":"static u8 sCanvasBg0;\n"},{"port":"\n"},{"port":"int CtrMugshot_Active(void)\n"},{"port":"{\n"},{"port":"    return sTransitionData != NULL && sCanvasBg0 == CANVAS_BG0_BANNERS;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// How the port repeats BG0 over the canvas: 0 as is, 1 the banners across it, 2 the grid across and down it.\n"},{"port":"int CtrTransition_Bg0Canvas(void)\n"},{"port":"{\n"},{"port":"    return sTransitionData != NULL ? sCanvasBg0 : CANVAS_BG0_NONE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// BG0's horizontal scroll of each of the 160 lines: the opponent's half on top, the player's below, as HBlankCB_Mugshots.\n"},{"port":"void CtrMugshot_LineScroll(u16 *lines)\n"},{"port":"{\n"},{"port":"    s32 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < DISPLAY_HEIGHT; i++)\n"},{"port":"        lines[i] = i < DISPLAY_HEIGHT / 2 ? sTransitionData->bg0HOfsOpponent : sTransitionData->bg0HOfsPlayer;\n"},{"port":"}\n"},{"span":[644,20]},{"port":"        sCanvasBg0 = CANVAS_BG0_NONE;\n"},{"span":[664,1288]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCanvasBg0 = CANVAS_BG0_BANNERS;\n"},{"port":"#endif\n"},{"span":[1952,256]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"                                                  sMugshotsOpponentCoords[mugshotId][0] - 112,\n"},{"port":"#else\n"},{"span":[2208,1]},{"port":"#endif\n"},{"span":[2209,3]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"                                                MUGSHOT_CANVAS_W - MUGSHOT_CANVAS_X + 32,\n"},{"port":"#else\n"},{"span":[2212,1]},{"port":"#endif\n"},{"span":[2213,6]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    opponentSprite->x2 = playerSprite->x2 = MUGSHOT_CANVAS_X;\n"},{"port":"    opponentSprite->y2 = playerSprite->y2 = MUGSHOT_CANVAS_Y;\n"},{"port":"#endif\n"},{"span":[2219,427]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCanvasBg0 = CANVAS_BG0_GRID;\n"},{"port":"#endif\n"},{"span":[2646,443]}]}]}
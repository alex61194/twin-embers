{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/librfu_stwi.c","before_sha256":"e9091ebbcc665b23b91244dd8575b5c7feab3b80c876f90f67e531fb4bcce037","after_sha256":"cc87bc7663978d7dc0ba3be681dbfcc45f019f45fcc11e27722c521437efea87","remove":false,"lines":[{"line":0},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The Wireless Adapter is emulated by the port (3ds_wl_glue.c): a command is answered at once, as the serial interrupt would have, and\n"},{"port":"// what the other consoles say is given to the console, once a frame, when the emulated adapter has something for it.\n"},{"port":"extern int CtrRfu_Command(const u32 *request, u32 *answer);\n"},{"port":"extern int CtrRfu_PollSlave(u32 *request);\n"},{"port":"extern void CtrRfu_Reset(void);\n"},{"port":"#endif\n"},{"span":[1,57]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // No serial port or GBA timer to wait on: the emulated adapter is reset, then the library's own state below.\n"},{"port":"    CtrRfu_Reset();\n"},{"port":"#else\n"},{"span":[58,15]},{"port":"#endif\n"},{"span":[73,519]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The command goes to the emulated adapter, which answers at once: what follows is what the serial interrupt did when the last word of the\n"},{"port":"// answer came in (librfu_intr.c, sio32intr_clock_master).\n"},{"port":"static s32 STWI_start_Command(void)\n"},{"port":"{\n"},{"port":"    u32 *request = (u32 *)gSTWIStatus->txPacket->rfuPacket8.data;\n"},{"port":"    u32 *answer = (u32 *)gSTWIStatus->rxPacket;\n"},{"port":"    u32 header;\n"},{"port":"\n"},{"port":"    request[0] = 0x99660000 | (gSTWIStatus->reqLength << 8) | gSTWIStatus->reqActiveCommand;\n"},{"port":"    gSTWIStatus->reqNext = gSTWIStatus->reqLength + 1;\n"},{"port":"    CtrRfu_Command(request, answer);\n"},{"port":"    header = answer[0];\n"},{"port":"    gSTWIStatus->ackActiveCommand = header;\n"},{"port":"    gSTWIStatus->ackLength = header >> 8;\n"},{"port":"    gSTWIStatus->ackNext = gSTWIStatus->ackLength + 1;\n"},{"port":"    if (gSTWIStatus->ackActiveCommand == (0x80 | ID_MS_CHANGE_REQ)\n"},{"port":"     || gSTWIStatus->ackActiveCommand == (0x80 | ID_DATA_TX_AND_CHANGE_REQ)\n"},{"port":"     || gSTWIStatus->ackActiveCommand == (0x80 | ID_UNK35_REQ)\n"},{"port":"     || gSTWIStatus->ackActiveCommand == (0x80 | ID_RESUME_RETRANSMIT_AND_CHANGE_REQ))\n"},{"port":"    {\n"},{"port":"        gSTWIStatus->msMode = AGB_CLK_SLAVE;\n"},{"port":"        gSTWIStatus->state = 5; // slave receive req init\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"    {\n"},{"port":"        gSTWIStatus->state = 4; // error\n"},{"port":"        if (gSTWIStatus->ackActiveCommand == 0xEE)\n"},{"port":"            gSTWIStatus->error = ERR_REQ_CMD_ACK_REJECTION;\n"},{"port":"    }\n"},{"port":"    gSTWIStatus->sending = 0;\n"},{"port":"    if (gSTWIStatus->callbackM != NULL)\n"},{"port":"        gSTWIStatus->callbackM(gSTWIStatus->reqActiveCommand, gSTWIStatus->error);\n"},{"port":"    return 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Once a frame, from the port: a console that is the clock slave (it sent data and changed roles) is told what the emulated adapter has\n"},{"port":"// for it, as the adapter's own request; the console acknowledges it and is the master again (librfu_intr.c, sio32intr_clock_slave).\n"},{"port":"void CtrStwi_SlaveTick(void)\n"},{"port":"{\n"},{"port":"    u32 *request, *ack;\n"},{"port":"    u8 command, length;\n"},{"port":"    bool8 accepted;\n"},{"port":"\n"},{"port":"    if (gSTWIStatus == NULL || gSTWIStatus->msMode != AGB_CLK_SLAVE || gSTWIStatus->sending == 1)\n"},{"port":"        return;\n"},{"port":"    request = (u32 *)gSTWIStatus->rxPacket;\n"},{"port":"    if (CtrRfu_PollSlave(request) <= 0)\n"},{"port":"        return;\n"},{"port":"    length = request[0] >> 8;\n"},{"port":"    command = request[0];\n"},{"port":"    gSTWIStatus->reqLength = length;\n"},{"port":"    gSTWIStatus->reqActiveCommand = command;\n"},{"port":"    gSTWIStatus->reqNext = length + 1;\n"},{"port":"    ack = (u32 *)gSTWIStatus->txPacket;\n"},{"port":"    accepted = command == ID_DATA_READY_AND_CHANGE_REQ || command == ID_DISCONNECTED_AND_CHANGE_REQ || command == ID_UNK36_REQ\n"},{"port":"            || (command == ID_MS_CHANGE_REQ && length == 0);\n"},{"port":"    if (accepted)\n"},{"port":"    {\n"},{"port":"        gSTWIStatus->ackActiveCommand = command + 0x80;\n"},{"port":"        ack[0] = 0x99660000 | gSTWIStatus->ackActiveCommand;\n"},{"port":"        gSTWIStatus->ackLength = 0;\n"},{"port":"        gSTWIStatus->ackNext = 1;\n"},{"port":"        gSTWIStatus->msMode = AGB_CLK_MASTER;\n"},{"port":"        gSTWIStatus->state = 0; // master send req\n"},{"port":"        if (gSTWIStatus->callbackS != NULL)\n"},{"port":"            gSTWIStatus->callbackS((length << 8) | command);\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"    {\n"},{"port":"        ack[0] = 0x996601EE;\n"},{"port":"        ack[1] = command >= 0x10 && command <= 0x3D ? 1 : 2;\n"},{"port":"        gSTWIStatus->ackLength = 1;\n"},{"port":"        gSTWIStatus->ackNext = 2;\n"},{"port":"        gSTWIStatus->state = 5; // slave receive req init\n"},{"port":"        gSTWIStatus->msMode = AGB_CLK_SLAVE;\n"},{"port":"        gSTWIStatus->reqLength = 0;\n"},{"port":"        gSTWIStatus->reqNext = 0;\n"},{"port":"        gSTWIStatus->reqActiveCommand = 0;\n"},{"port":"        gSTWIStatus->ackLength = 0;\n"},{"port":"        gSTWIStatus->ackNext = 0;\n"},{"port":"        gSTWIStatus->ackActiveCommand = 0;\n"},{"port":"        gSTWIStatus->timerState = 0;\n"},{"port":"        gSTWIStatus->timerActive = 0;\n"},{"port":"        gSTWIStatus->error = 0;\n"},{"port":"        gSTWIStatus->recoveryCount = 0;\n"},{"port":"        if (gSTWIStatus->callbackS != NULL)\n"},{"port":"            gSTWIStatus->callbackS(0x1EE);\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"#else\n"},{"span":[592,18]},{"port":"#endif\n"},{"span":[610,40]}]},{"path":"src/link.c","before_sha256":"e18b5ea22faccce387f5ff38485e54279fd031157526d3b8cf66b1e8fed4ff95","after_sha256":"fa9eb4957669e5173d58ff30eb139f63efc68ceff3f15c93bd36cf3d7c4fb41a","remove":false,"lines":[{"span":[0,242]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"extern u8 CtrWl_Available(void);\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[242,5]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // ARM11 has no GBA wireless adapter or advancing GBA serial timers: the adapter is emulated (3ds_wl_glue.c), and is there when the\n"},{"port":"    // console's radio can be used. Without it, use the ordinary no-adapter cleanup below without probing.\n"},{"port":"    if (CtrWl_Available())\n"},{"port":"    {\n"},{"port":"#endif\n"},{"span":[250,8]},{"port":"    }\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"span":[258,1948]}]},{"path":"src/link_rfu_2.c","before_sha256":"de97e19957f662244915de207e8bb535ac600b1e4df82dc9e9752fea04c4a2ae","after_sha256":"14ae762c06e06da6d32f0a1e427bad5488d22ded2769f80a46a1716014e4f46d","remove":false,"lines":[{"span":[0,302]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"extern u8 CtrWl_Available(void);\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[302,6]},{"port":"    /* The adapter is emulated (3ds_wl_glue.c): when the console's radio can be used the stopMode handshake is answered at once; without it\n"},{"port":"     * there is nothing to talk to, and the interrupt table setup below is harmless shadow state. */\n"},{"port":"    if (CtrWl_Available())\n"},{"port":"    {\n"},{"port":"        rfu_REQ_stopMode();\n"},{"port":"        rfu_waitREQComplete();\n"},{"port":"    }\n"},{"span":[311,2858]}]}]}
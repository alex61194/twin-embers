t CtrBottomDex_Flags(unsigned species)\n"},{"port":"{\n"},{"port":"    if (species == SPECIES_NONE || species >= NUM_SPECIES)\n"},{"port":"        return 0;\n"},{"port":"    return (DexScreen_GetSetPokedexFlag(species, FLAG_GET_SEEN, TRUE) ? 1 : 0)\n"},{"port":"         | (DexScreen_GetSetPokedexFlag(species, FLAG_GET_CAUGHT, TRUE) ? 2 : 0);\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrBottomDex_Number(unsigned species)\n"},{"port":"{\n"},{"port":"    return species != SPECIES_NONE && species < NUM_SPECIES ? SpeciesToNationalPokedexNum(species) : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomDex_Name(unsigned species, char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (species != SPECIES_NONE && species < NUM_SPECIES)\n"},{"port":"        CtrBattle_FireRedText(gSpeciesNames[species], out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomDex_Category(unsigned species, char *out, int size)\n"},{"port":"{\n"},{"port":"    u8 text[12 + 16];\n"},{"port":"    const u8 *name;\n"},{"port":"    int n = 0, i;\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!(CtrBottomDex_Flags(species) & 2))\n"},{"port":"        return;\n"},{"port":"    name = gPokedexEntries[SpeciesToNationalPokedexNum(species)].categoryName;\n"},{"port":"#if REVISION == 0\n"},{"port":"    while (n < 11 && name[n] != CHAR_SPACE && name[n] != EOS)\n"},{"port":"#else\n"},{"port":"    while (n < 11 && name[n] != EOS)\n"},{"span":[3656,1]},{"port":"    {\n"},{"port":"        text[n] = name[n];\n"},{"port":"        n++;\n"},{"port":"    }\n"},{"port":"    for (i = 0; gText_PokedexPokemon[i] != EOS && n < (int)sizeof(text) - 1; i++)\n"},{"port":"        text[n++] = gText_PokedexPokemon[i];\n"},{"port":"    text[n] = EOS;\n"},{"port":"    CtrBattle_FireRedText(text, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrBottomDex_Height(unsigned species)\n"},{"port":"{\n"},{"port":"    return CtrBottomDex_Flags(species) & 2 ? gPokedexEntries[SpeciesToNationalPokedexNum(species)].height : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrBottomDex_Weight(unsigned species)\n"},{"port":"{\n"},{"port":"    return CtrBottomDex_Flags(species) & 2 ? gPokedexEntries[SpeciesToNationalPokedexNum(species)].weight : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomDex_Description(unsigned species, char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (CtrBottomDex_Flags(species) & 2)\n"},{"port":"        CtrBattle_FireRedText(gPokedexEntries[SpeciesToNationalPokedexNum(species)].description, out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomDex_Types(unsigned species, int *types, char *first, char *second, int size)\n"},{"port":"{\n"},{"port":"    first[0] = second[0] = 0;\n"},{"port":"    types[0] = types[1] = -1;\n"},{"port":"    if (!(CtrBottomDex_Flags(species) & 2))\n"},{"port":"        return 0;\n"},{"port":"    types[0] = gSpeciesInfo[species].types[0];\n"},{"port":"    types[1] = gSpeciesInfo[species].types[1];\n"},{"port":"    CtrBattle_FireRedText(gTypeNames[types[0]], first, size);\n"},{"port":"    if (types[1] != types[0])\n"},{"port":"        CtrBattle_FireRedText(gTypeNames[types[1]], second, size);\n"},{"port":"    else\n"},{"port":"        types[1] = -1;\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Pictures, from FireRed's own tables: a species' front picture (4bpp, 8x8 tiles in rows of eight) and palette,\n"},{"port":"// a top menu row's icon (64x48, rows of eight tiles), the footprint (1bpp) and the caught marker.\n"},{"port":"static u32 sCtrDexPic[0x1000 / 4];\n"},{"port":"\n"},{"port":"int CtrPokeTouch_DexMonPic(unsigned species, unsigned char *tiles, unsigned short *palette)\n"},{"port":"{\n"},{"port":"    u32 personality;\n"},{"port":"    const u32 *pal;\n"},{"port":"\n"},{"port":"    if (species == SPECIES_NONE || species >= NUM_SPECIES)\n"},{"port":"        return 0;\n"},{"port":"    personality = DexScreen_GetDefaultPersonality(species);\n"},{"port":"    LoadSpecialPokePic(&gMonFrontPicTable[species], sCtrDexPic, species, personality, TRUE);\n"},{"port":"    memcpy(tiles, sCtrDexPic, 0x800);\n"},{"port":"    pal = GetMonSpritePalFromSpeciesAndPersonality(species, SHINY_ODDS, personality);\n"},{"port":"    if (pal == NULL)\n"},{"port":"        return 0;\n"},{"port":"    CTR_ASSET_READ(pal, 4);\n"},{"port":"    if (GetDecompressedDataSize((const u8 *)pal) > 32)\n"},{"port":"        return 0;\n"},{"port":"    LZ77UnCompWram(pal, palette);\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrPokeTouch_DexMenuIcon(int id, unsigned char *tiles, unsigned short *palette)\n"},{"port":"{\n"},{"port":"    const u32 *gfx;\n"},{"port":"    const u16 *pal;\n"},{"port":"\n"},{"port":"    if (id == LIST_CANCEL)\n"},{"port":"    {\n"},{"port":"        gfx = sTopMenuSelectionIconTiles_Cancel;\n"},{"port":"        pal = sTopMenuSelectionIconPals_Cancel;\n"},{"port":"    }\n"},{"port":"    else if (id >= 0 && id < (int)NELEMS(sTopMenuSelectionIconGfxPtrs) && sTopMenuSelectionIconGfxPtrs[id].tiles != NULL)\n"},{"port":"    {\n"},{"port":"        gfx = sTopMenuSelectionIconGfxPtrs[id].tiles;\n"},{"port":"        pal = sTopMenuSelectionIconGfxPtrs[id].pal;\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"        return 0;\n"},{"port":"    CTR_ASSET_READ(gfx, 4);\n"},{"port":"    CTR_ASSET_READ(pal, 32);\n"},{"port":"    if (GetDecompressedDataSize((const u8 *)gfx) > 64 * 48 / 2)\n"},{"port":"        return 0;\n"},{"port":"    LZ77UnCompWram(gfx, tiles);\n"},{"port":"    memcpy(palette, pal, 32);\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrPokeTouch_DexFootprint(unsigned species, unsigned char *bits)\n"},{"port":"{\n"},{"port":"    const u8 *footprint;\n"},{"port":"\n"},{"port":"    if (!(CtrBottomDex_Flags(species) & 2))\n"},{"port":"        return 0;\n"},{"port":"    footprint = gMonFootprintTable[spe
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"f14159a0a9b5d0d7a8f9d97096bd63c65fac7234ea82cea4a81d6cfe98e14990","after_sha256":"02eea0acf560c272a7dcea26ebafa18a7344fdc4e5f32d452a0a1ba7641048e3","remove":false,"lines":[{"span":[0,55]},{"port":"// trainer_card.c: the real Trainer Card, shown in the lower viewport. State: 0 not\n"},{"port":"// ready (setup, fade, flip, close), 1 front takes input, 2 back does.\n"},{"port":"int CtrBottomCard_IsOpen(void);\n"},{"port":"int CtrBottomCard_State(void);\n"},{"port":"const u16 *CtrTrainerCard_FlipScroll(void);\n"},{"port":"// start_menu.c: the Trainer Card opened directly (no START menu) and left\n"},{"line":39},{"port":"int CtrField_CanOpenCard(void);\n"},{"port":"int CtrField_TryOpenCard(void);\n"},{"span":[66,29]}]},{"path":"src/ctr_poketouch.c","before_sha256":"228bb61071f317c5200416ed9c568b95cb82c726ca8cff44769115eb3278a8d5","after_sha256":"116234a6593f53188b94abdefbb6fc09d437a75992ac5ef55b412ddcd97ea368","remove":false,"lines":[{"span":[0,181]},{"line":183},{"port":"        // The direct card has no link or Union Room version (their START entry does).\n"},{"port":"        return (field || menu) && InUnionRoom() != TRUE && CtrStartMenu_Has(entry);\n"},{"span":[181,2]},{"span":[184,115]}]},{"path":"src/ctr_poketouch_card.c","before_sha256":"3c4d5aa104c2ab5cb12376ecc3eba0b0308d2120e48eb2e8a348fc806dc33818","after_sha256":null,"remove":true,"lines":[]},{"path":"src/start_menu.c","before_sha256":"15b12207862ab668f05b1f749b0f4e2d770bb28b1e675cc84dbff85f2a26954e","after_sha256":"7014345022fee5b80a54529af24ddffce3354ae8a3a83097719403c2a6357422","remove":false,"lines":[{"span":[0,1149]},{"port":"/* The real Trainer Card, opened from the lower screen the way StartMenuPlayerCallback\n"},{"port":" * does it (the same cleanup, then ShowPlayerTrainerCard) but without the START menu,\n"},{"port":" * and with an exit that resumes the field instead of reopening START. The link\n"},{"port":" * and Union Room cards keep their own START entry. */\n"},{"port":"static void CB2_ReturnFromBottomCard(void)\n"},{"line":1227},{"line":1111},{"line":1112},{"line":1232},{"line":1224},{"port":"int CtrField_CanOpenCard(void)\n"},{"line":1227},{"port":"    return CtrField_CanOpenBag() && InUnionRoom() != TRUE && !gReceivedRemoteLinkPlayers;\n"},{"line":1232},{"line":1224},{"port":"int CtrField_TryOpenCard(void)\n"},{"line":1227},{"port":"    if (!CtrField_CanOpenCard())\n"},{"line":1139},{"line":1140},{"line":1141},{"line":1142},{"line":1143},{"line":1144},{"port":"    ShowPlayerTrainerCard(CB2_ReturnFromBottomCard);\n"},{"line":1146},{"line":1232},{"line":1224},{"span":[1149,85]}]},{"path":"src/trainer_card.c","before_sha256":"623f28c25a3359b9e5c436e566d6007519c6ccf42ecff9e20fd6714f7c5d13bb","after_sha256":"2ca2f8219764d0d60947b8acda5f9509e57a7eb7c1b4d250dd4ffdae71d05379","remove":false,"lines":[{"span":[0,653]},{"line":475},{"port":"/* PokeTouch (3ds_bottom.c) shows this very screen in its lower viewport and\n"},{"port":" * drives it with FireRed's own keys. These only answer questions; the card's\n"},{"port":" * state stays here. */\n"},{"port":"int CtrBottomCard_IsOpen(void)\n"},{"line":1960},{"port":"    return sTrainerCardDataPtr != NULL;\n"},{"line":1964},{"line":1957},{"port":"/* 0: set up, fading, flipping or closing (no key does anything useful), 1: the\n"},{"port":" * front takes input (A flips it, B closes it), 2: the back does (B flips it\n"},{"port":" * back, A closes it). The link cases keep their own inputs and are never ready. */\n"},{"port":"int CtrBottomCard_State(void)\n"},{"line":1960},{"port":"    if (sTrainerCardDataPtr == NULL || gPaletteFade.active || sTrainerCardDataPtr->isLink\n"},{"port":"     || gReceivedRemoteLinkPlayers)\n"},{"port":"        return 0;\n"},{"port":"    if (sTrainerCardDataPtr->mainState == STATE_HANDLE_INPUT_FRONT)\n"},{"port":"        return 1;\n"},{"port":"    if (sTrainerCardDataPtr->mainState == STATE_HANDLE_INPUT_BACK)\n"},{"port":"        return 2;\n"},{"port":"    return 0;\n"},{"line":1964},{"line":1957},{"port":"/* The flip's scanline effect: HBlankCB_TrainerCard sets BG0's vertical scroll\n"},{"port":" * from gScanlineEffectRegBuffers[1] at the end of each line. The 3DS has no\n"},{"port":" * HBlank, so the compositor takes that buffer as BG0's per-line scroll\n"},{"port":" * (CtrVideo_SetLineScroll) for as long as the callback is installed. */\n"},{"port":"const u16 *CtrTrainerCard_FlipScroll(void)\n"},{"line":1960},{"port":"    if (sTrainerCardDataPtr != NULL && gMain.hblankCallback == HBlankCB_TrainerCard)\n"},{"port":"        return gScanlineEffectRegBuffers[1];\n"},{"port":"    return NULL;\n"},{"line":1964},{"line":480},{"line":1957},{"span":[653,1312]}]}]}

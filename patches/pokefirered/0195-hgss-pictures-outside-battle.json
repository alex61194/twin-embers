:"    sNext = (sNext + 1) % 8;\n"},{"port":"    out[0] = 0x10;\n"},{"port":"    out[1] = PLTT_SIZE_4BPP;\n"},{"port":"    out[2] = 0;\n"},{"port":"    out[3] = 0;\n"},{"port":"    for (i = 0; i < 4; i++)\n"},{"port":"    {\n"},{"port":"        out[4 + i * 9] = 0;   // eight literal bytes follow\n"},{"port":"        memcpy(&out[5 + i * 9], (const u8 *)palette + i * 8, 8);\n"},{"port":"    }\n"},{"port":"    return sLz[(sNext + 7) % 8];\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[5949,14]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    {\n"},{"port":"        const u32 *gen4 = CtrGen4_PalLz(species, otId, personality);\n"},{"port":"\n"},{"port":"        if (gen4 != NULL)\n"},{"port":"            return gen4;\n"},{"port":"    }\n"},{"port":"#endif\n"},{"span":[5963,20]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    {\n"},{"port":"        static struct CompressedSpritePalette sGen4[8];\n"},{"port":"        static u8 sNext;\n"},{"port":"        const u32 *gen4 = CtrGen4_PalLz(species, otId, personality);\n"},{"port":"\n"},{"port":"        if (gen4 != NULL)\n"},{"port":"        {\n"},{"port":"            struct CompressedSpritePalette *palette = &sGen4[sNext];\n"},{"port":"\n"},{"port":"            sNext = (sNext + 1) % 8;\n"},{"port":"            palette->data = gen4;\n"},{"port":"            palette->tag = gMonPaletteTable[species].tag;\n"},{"port":"            return palette;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"#endif\n"},{"span":[5983,537]}]},{"path":"src/battle_gfx_sfx_util.c","before_sha256":"72db1901c0b1e045f84b063f7f6a2f3693c58bcc8ad5e9012b4d3e9577813982","after_sha256":"5f65891aae21f7ee9d77bc3baa3754071e9ce25bcf11003d5a226ec7a036c1ce","remove":false,"lines":[{"span":[0,111]},{"port":"\n"},{"port":"extern bool8 gCtrGen4KeepFireRed;\n"},{"span":[111,262]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    gCtrGen4KeepFireRed = TRUE;  // FireRed's picture: the port draws the battler whole (CtrGen4_TryLoad)\n"},{"port":"#endif\n"},{"span
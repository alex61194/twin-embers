rt":"        return FALSE;\n"},{"port":"    switch (target - 1)\n"},{"port":"    {\n"},{"port":"    case PT_POKEMON:\n"},{"port":"        InitPartyMenu(PARTY_MENU_TYPE_FIELD, PARTY_LAYOUT_SINGLE, PARTY_ACTION_CHOOSE_MON,\n"},{"port":"                      FALSE, PARTY_MSG_CHOOSE_MON, Task_HandleChooseMonInput, CB2_ReturnFromBottomParty);\n"},{"port":"        break;\n"},{"port":"    case PT_BAG:\n"},{"port":"        GoToBagMenu(ITEMMENULOCATION_FIELD, OPEN_BAG_LAST, CB2_ReturnFromBottomBag);\n"},{"port":"        break;\n"},{"port":"    case PT_CARD:\n"},{"port":"        ShowPlayerTrainerCard(CB2_ReturnFromBottomCard);\n"},{"port":"        break;\n"},{"port":"    case PT_POKEDEX:\n"},{"port":"        IncrementGameStat(GAME_STAT_CHECKED_POKEDEX);\n"},{"port":"        SetMainCallback2(CB2_OpenPokedexFromBottom);\n"},{"port":"        break;\n"},{"port":"    default:\n"},{"port":"        return FALSE;               // OPTIONS, SAVE: the field, where PokeTouch shows them\n"},{"port":"    }\n"},{"port":"    sCtrSwitched = TRUE;\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The Summary of the Party PokeTouch opened leaves for the switch's screen rather than back to that Party.\n"},{"port":"static void CB2_CtrSwitchFromSummary(void)\n"},{"port":"{\n"},{"port":"    if (CtrMenu_Switch())\n"},{"port":"        return;\n"},{"port":"    gFieldCallback2 = CtrFieldCB_ReturnFromBottomParty;\n"},{"port":"    CB2_ReturnToField();\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrField_PartyIsBottom(void)\n"},{"port":"{\n"},{"port":"    return gPartyMenu.exitCallback == CB2_ReturnFromBottomParty;\n"},{"port":"}\n"},{"port":"\n"},{"port":"MainCallback CtrMenu_SummaryExit(void)\n"},{"port":"{\n"},{"port":"    return CB2_CtrSwitchFromSummary;\n"},{"span":[1203,177]}]},{"path":"src/pokemon_summary_screen.c","before_sha256":"bfb0d6571af429bff6fa646ab04e9ad719ae3396d0237a27720b8d7c848f8e2c","after_sha256":"49910162b27aca2f420aac2a36ee209d0d02acb11750fbb42aeb5130047a
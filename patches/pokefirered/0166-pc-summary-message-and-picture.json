ryScreen->currentMon;\n"}, {"port": "    species = GetMonData(mon, MON_DATA_SPECIES_OR_EGG);\n"}, {"port": "    if (species == SPECIES_NONE || species > SPECIES_EGG)\n"}, {"port": "        return 0;\n"}, {"port": "    personality = GetMonData(mon, MON_DATA_PERSONALITY);\n"}, {"port": "    LoadSpecialPokePic(&gMonFrontPicTable[species], sCtrSummaryPic, species, personality, TRUE);\n"}, {"port": "    memcpy(tilesOut, sCtrSummaryPic, 0x800);\n"}, {"port": "    pal = GetMonSpritePalFromSpeciesAndPersonality(species, GetMonData(mon, MON_DATA_OT_ID), personality);\n"}, {"port": "    if (pal == NULL)\n"}, {"port": "        return 0;\n"}, {"port": "    CTR_ASSET_READ(pal, 4);\n"}, {"port": "    if (GetDecompressedDataSize((const u8 *)pal) > 32)\n"}, {"port": "        return 0;\n"}, {"port": "    LZ77UnCompWram(pal, palOut);\n"}, {"port": "    *flipOut = !IsMonSpriteNotFlipped(species);\n"}, {"port": "    return 1;\n"}, {"span": [1106, 4609]}]}]}
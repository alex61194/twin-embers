T_PAGE + page) and the\n"},{"port":"// controls hint, split at its {A_BUTTON} (CTR_SUMMARY_HIT_BUTTON_A) from the\n"},{"port":"// page part before it (CTR_SUMMARY_HIT_CONTROLS); on the moves pages a move\n"},{"port":"// row (CTR_SUMMARY_HIT_MOVE + row, 4 is CANCEL), 28 pixels each from the top\n"},{"port":"// of the moves windows. -1 elsewhere.\n"},{"port":"int CtrBottomSummary_HitAt(int x, int y)\n"},{"line":5385},{"port":"    const struct WindowTemplate *name = &sWindowTemplates_Permanent_Bg1[POKESUM_WIN_PAGE_NAME];\n"},{"port":"    const struct WindowTemplate *controls = &sWindowTemplates_Permanent_Bg1[POKESUM_WIN_CONTROLS];\n"},{"port":"    const struct WindowTemplate *moves = &sWindowTemplates_Moves[POKESUM_WIN_MOVES_5 - 3];\n"},{"line":1000},{"port":"    int page, row;\n"},{"line":5382},{"port":"    if (!CtrBottomSummary_IsActive() || x < 0 || y < 0 || x >= DISPLAY_WIDTH || y >= DISPLAY_HEIGHT)\n"},{"line":5204},{"port":"    page = screen->curPageIndex;\n"},{"port":"    if (y < (name->tilemapTop + name->height) * 8)\n"},{"line":5346},{"port":"        if (x < (name->tilemapLeft + name->width) * 8)\n"},{"port":"            return screen->isEgg ? -1 : CTR_SUMMARY_HIT_PAGE_NAME;\n"},{"port":"        if (x < controls->tilemapLeft * 8)\n"},{"line":5314},{"port":"            if (screen->isEgg)\n"},{"port":"                return -1;\n"},{"port":"            page = (x / 8 - 13) / 2;\n"},{"port":"            return page <= PSS_PAGE_MOVES ? CTR_SUMMARY_HIT_PAGE + page : -1;\n"},{"line":5318},{"port":"        if (sBottomSummaryControls != NULL)\n"},{"line":5314},{"port":"            const u8 *button = sBottomSummaryControls;\n"},{"port":"            while (*button != EOS && !(button[0] == CHAR_KEYPAD_ICON && button[1] == CHAR_A_BUTTON))\n"},{"port":"                button += *button == CHAR_KEYPAD_ICON ? 2 : 1;\n"},{"port":"            if (*button != EOS\n"},{"port":"                && x >= controls->tilemapLeft * 8 + 0x54 - GetStringWidth(FONT_SMALL, button, 0))\n"},{"port":"                return CTR_SUMMARY_HIT_BUTTON_A;\n"},{"port":"            if (button != sBottomSummaryControls)\n"},{"port":"                return CTR_SUMMARY_HIT_CONTROLS;\n"},{"line":5318},{"line":5204},{"line":5351},{"port":"    if ((page != PSS_PAGE_MOVES && page != PSS_PAGE_MOVES_INFO) || x < moves->tilemapLeft * 8\n"},{"port":"        || y < moves->tilemapTop * 8)\n"},{"line":5204},{"port":"    row = (y - moves->tilemapTop * 8) / 28;\n"},{"port":"    if (row < 4)\n"},{"port":"        return screen->moveIds[row] != 0 ? CTR_SUMMARY_HIT_MOVE + row : -1;\n"},{"port":"    if (row == 4 && page == PSS_PAGE_MOVES_INFO && !screen->isSwappingMoves)\n"},{"port":"        return CTR_SUMMARY_HIT_MOVE + 4;\n"},{"line":5148},{"span":[996,20]},{"port":"    out->ready = CtrBottomSummary_InputReady();\n"},{"span":[1021,71]},{"port":"    sBottomSummaryControls = NULL;\n"},{"span":[1092,1452]},{"line":3933},{"port":"    sBottomSummaryControls = str;\n"},{"line":5045},{"span":[2544,2844]}]}]}

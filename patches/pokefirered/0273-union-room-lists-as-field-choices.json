{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/menu.c","before_sha256":"f292d03b7b02695504a6ef54cdc3f4e2b12c47aeb16d960aa8e06f5f945f82b5","after_sha256":"65aeac7ae18e2db88b4a9d27a222e4e36315af8086541b1d0415c92a0f0757d9","remove":false,"lines":[{"span":[0,10]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"list_menu.h\"\n"},{"port":"extern bool32 InUnionRoom(void);\n"},{"port":"#endif\n"},{"span":[10,352]},{"port":"// The Union Room's list menus as field choices (CtrListChoice_* below).\n"},{"port":"extern void CtrListMenu_Ask(int row);\n"},{"port":"static EWRAM_DATA u8 sCtrListOpen = FALSE;\n"},{"span":[362,93]},{"port":"    if (sCtrListOpen)\n"},{"port":"        CtrListMenu_Ask(row);   // the Union Room's list reads it on its next input\n"},{"span":[455,20]},{"port":"// The Union Room's list menus (the activity to ask a player for, the players of a group to join or to take in) are lists, not\n"},{"port":"// menus: while one is read in the Union Room it is a field choice too. A list of at most CTR_MENU_ROWS rows that does not scroll;\n"},{"port":"// each row's label is the text printed on its row (the leftmost: the name of a player, not the ID after it).\n"},{"port":"static EWRAM_DATA u8 sCtrListTask = TASK_NONE;\n"},{"port":"static EWRAM_DATA u32 sCtrListFrame = 0;\n"},{"port":"static EWRAM_DATA u16 sCtrListSerial = 0;\n"},{"port":"\n"},{"port":"void CtrListMenu_Seen(u8 listTaskId)\n"},{"port":"{\n"},{"port":"    if (!InUnionRoom())\n"},{"port":"        return;                 // only the Union Room's lists (the Bag's, the Pokedex's... have screens of their own)\n"},{"port":"    if (sCtrListTask != listTaskId || gMain.vblankCounter2 - sCtrListFrame > 30)\n"},{"port":"    {\n"},{"port":"        sCtrListSerial++;\n"},{"port":"        sCtrMenuLabels = 0;\n"},{"port":"    }\n"},{"port":"    sCtrListTask = listTaskId;\n"},{"port":"    sCtrListFrame = gMain.vblankCounter2;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static const struct ListMenu *CtrListChoice_Current(void)\n"},{"port":"{\n"},{"port":"    const struct ListMenu *list;\n"},{"port":"\n"},{"port":"    if (sCtrListTask == TASK_NONE || !gTasks[sCtrListTask].isActive || gMain.vblankCounter2 - sCtrListFrame > 8 || !InUnionRoom())\n"},{"port":"        return NULL;\n"},{"port":"    list = (const struct ListMenu *)gTasks[sCtrListTask].data;\n"},{"port":"    if (list->template.totalItems == 0 || list->template.totalItems > CTR_MENU_ROWS || list->template.totalItems > list->template.maxShowed\n"},{"port":"        || list->template.windowId == WINDOW_NONE || GetWindowAttribute(list->template.windowId, WINDOW_BG) != 0)\n"},{"port":"        return NULL;\n"},{"port":"    return list;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The labels of the list's rows: for each, the texts noted in its window at its row, the leftmost first (newest of those at the\n"},{"port":"// same place); a row the window shows nothing on ends the list (the empty places of a group). Rows already read keep their label\n"},{"port":"// when a newer print has left the notes (the notes are few).\n"},{"port":"static int CtrListChoice_TakeLabels(const struct ListMenu *list)\n"},{"port":"{\n"},{"port":"    int row, i, shown = 0;\n"},{"port":"    int height = GetFontAttribute(list->template.fontId, FONTATTR_MAX_LETTER_HEIGHT) + list->template.itemVerticalPadding;\n"},{"port":"\n"},{"port":"    if (height == 0)\n"},{"port":"        return 0;\n"},{"port":"    for (row = 0; row < list->template.totalItems; row++)\n"},{"port":"    {\n"},{"port":"        int y = row * height + list->template.upText_Y, bestX = 1000, n = 0;\n"},{"port":"        u8 text[CTR_MENU_LABEL];\n"},{"port":"        bool8 found = FALSE;\n"},{"port":"\n"},{"port":"        text[0] = EOS;\n"},{"port":"        for (i = 1; i <= CTR_MENU_NOTES; i++)\n"},{"port":"        {\n"},{"port":"            const struct CtrMenuNote *note = &sCtrMenuNote[(sCtrMenuNoteNext + CTR_MENU_NOTES - i) % CTR_MENU_NOTES];\n"},{"port":"            int dy = y - note->y + height / 2;\n"},{"port":"\n"},{"port":"            if (!note->used || note->windowId != list->template.windowId || dy < 0 || dy >= height)\n"},{"port":"                continue;\n"},{"port":"            if (CtrMenu_NoteLine(note, 0, text) && (!found || note->x < bestX))\n"},{"port":"            {\n"},{"port":"                bestX = note->x;\n"},{"port":"                found = TRUE;\n"},{"port":"                for (n = 0; text[n] != EOS; n++)\n"},{"port":"                    sCtrMenuLabel[row][n] = text[n];\n"},{"port":"                sCtrMenuLabel[row][n] = EOS;\n"},{"port":"            }\n"},{"port":"        }\n"},{"port":"        if (!found && !(sCtrMenuLabels > row))\n"},{"port":"            break;\n"},{"port":"        shown = row + 1;\n"},{"port":"    }\n"},{"port":"    return shown;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrListChoice_IsOpen(void)\n"},{"port":"{\n"},{"port":"    const struct ListMenu *list = CtrListChoice_Current();\n"},{"port":"    int shown;\n"},{"port":"\n"},{"port":"    sCtrListOpen = FALSE;\n"},{"port":"    if (list == NULL || !CtrBottom_IsFieldCallback())\n"},{"port":"        return FALSE;\n"},{"port":"    shown = CtrListChoice_TakeLabels(list);\n"},{"port":"    if (shown == 0)\n"},{"port":"        return FALSE;\n"},{"port":"    sCtrMenuLabels = shown;\n"},{"port":"    sCtrMenuInputFrame = sCtrMenuInitFrame = sCtrListFrame;\n"},{"port":"    sCtrListOpen = TRUE;\n"},{"port":"    CtrMenu_NoteShown(list->template.windowId, TRUE);\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"span":[475,3]},{"port":"        && GetWindowAttribute(sMenu.windowId, WINDOW_BG) != 0xFF && gMain.vblankCounter2 - sCtrMenuInputFrame <= 8\n"},{"port":"        && !sCtrListOpen;\n"},{"span":[479,2]},{"port":"    {\n"},{"line":481},{"port":"        return open;\n"},{"port":"    }\n"},{"port":"    return CtrListChoice_IsOpen();\n"},{"span":[483,51]},{"port":"    return sCtrListOpen ? 0 : sCtrMenuGrid ? sMenu.columns : 0;\n"},{"span":[535,4]},{"port":"    const struct ListMenu *list = sCtrListOpen ? CtrListChoice_Current() : NULL;\n"},{"port":"\n"},{"port":"    return list != NULL ? list->cursorPos + list->itemsAbove : sMenu.cursorPos;\n"},{"span":[540,633]}]},{"path":"src/list_menu.c","before_sha256":"de5fae2744e5aecff74d68efe027776c415a5ff8e471c3daba885d1862971d8f","after_sha256":"dcad1308491b5929a607ea83d2e33f48f310c80de866b93d7e6f2a2fc0266e33","remove":false,"lines":[{"span":[0,166]},{"port":"extern void CtrListMenu_Seen(u8 listTaskId);\n"},{"port":"\n"},{"span":[166,15]},{"port":"    CtrListMenu_Seen(listTaskId);   // the list is being read: the lower screen may draw it (menu.c, CtrFieldChoice_*)\n"},{"span":[181,599]}]}]}
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/pokemon_storage_system_tasks.c","before_sha256":"6f3766d8b8a921bf425da2a9f99ad9a13f6d607abb13a8f322110afb956ffa42","after_sha256":"71ced7c4aaa79febc530048e58dddd78e331ea92910d7b19b50ae05107eba0ea","remove":false,"lines":[{"span":[0,2575]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"static bool8 sCtrStorageMessage;    // the box's message window shows gStorage->actionText (the lower screen's box)\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[2575,40]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCtrStorageMessage = TRUE;\n"},{"port":"#endif\n"},{"span":[2615,10]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCtrStorageMessage = FALSE;\n"},{"port":"#endif\n"},{"span":[2625,275]},{"port":"\n"},{"port":"/* The box drawn by the lower screen (3ds_field_box_impl.h): FireRed's own state, read only. While the box moves\n"},{"port":" * items, carries several Pokemon or marks one, it keeps FireRed's own picture (0). */\n"},{"port":"#include \"3ds_poketouch.h\"\n"},{"port":"#include \"3ds_assets.h\"\n"},{"port":"\n"},{"port":"static void CtrBoxCopy(u8 *dst, const u8 *src, int size)\n"},{"port":"{\n"},{"port":"    int i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < size - 1 && src[i] != EOS; i++)\n"},{"port":"        dst[i] = src[i];\n"},{"port":"    for (; i < size; i++)\n"},{"port":"        dst[i] = EOS;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrBoxMon(CtrPokeTouchBoxMon *m, u16 species, bool8 egg, u32 personality)\n"},{"port":"{\n"},{"port":"    m->species = species;\n"},{"port":"    m->egg = egg != 0;\n"},{"port":"    m->personality = personality;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrPokeTouch_MonIcon(unsigned species, unsigned personality, int egg, unsigned char *tilesOut, unsigned short *palOut)\n"},{"port":"{\n"},{"port":"    u16 iconSpecies;\n"},{"port":"    const u8 *tiles;\n"},{"port":"    const u16 *pal;\n"},{"port":"\n"},{"port":"    if (species == SPECIES_NONE || species > SPECIES_EGG || tilesOut == NULL || palOut == NULL)\n"},{"port":"        return 0;\n"},{"port":"    iconSpecies = egg ? SPECIES_EGG : GetIconSpecies(species, personality);\n"},{"port":"    tiles = GetMonIconTiles(iconSpecies, FALSE);\n"},{"port":"    pal = GetValidMonIconPalettePtr(egg ? SPECIES_EGG : species);\n"},{"port":"    if (tiles == NULL || pal == NULL)\n"},{"port":"        return 0;\n"},{"port":"    CtrAssets_RequireRange(tiles, 512);\n"},{"port":"    CtrAssets_RequireRange(pal, 32);\n"},{"port":"    memcpy(tilesOut, tiles, 512);\n"},{"port":"    memcpy(palOut, pal, 32);\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomStorage_BoxFill(CtrPokeTouchBox *b)\n"},{"port":"{\n"},{"port":"    u8 box = StorageGetCurrentBox();\n"},{"port":"    int i;\n"},{"port":"    TaskFunc fn;\n"},{"port":"\n"},{"port":"    memset(b, 0, sizeof(*b));\n"},{"port":"    b->pressed = -1;\n"},{"port":"    if (!CtrBottomStorage_BoxPresented() || gStorage->boxOption == OPTION_MOVE_ITEMS || CtrBottomStorage_MultiMove())\n"},{"port":"        return 0;\n"},{"port":"    fn = gTasks[gStorage->taskId].func;\n"},{"port":"    if (fn == Task_ShowMarkMenu)\n"},{"port":"        return 0;\n"},{"port":"    b->on = 1;\n"},{"port":"    if (CtrBottomStorage_YesNo())\n"},{"port":"        b->state = PT_BOX_STATE_YESNO;\n"},{"port":"    else if (CtrBottomStorage_ContextMenu())\n"},{"port":"        b->state = PT_BOX_STATE_MENU;\n"},{"port":"    else if (CtrBottomStorage_BoxChoose())\n"},{"port":"        b->state = PT_BOX_STATE_CHOOSE;\n"},{"port":"    else if (CtrBottomStorage_BoxReady())\n"},{"port":"        b->state = PT_BOX_STATE_BOX;\n"},{"port":"    else if (sCtrStorageMessage && !gPaletteFade.active)\n"},{"port":"        b->state = PT_BOX_STATE_MESSAGE;\n"},{"port":"    else\n"},{"port":"        b->state = PT_BOX_STATE_BUSY;\n"},{"port":"    b->area = (s8)CtrBottomStorage_CursorArea();\n"},{"port":"    b->pos = (s8)CtrBottomStorage_CursorPos();\n"},{"port":"    b->holding = IsMonBeingMoved() != 0;\n"},{"port":"    b->box = box;\n"},{"port":"    CtrBoxCopy(b->boxName, GetBoxNamePtr(box), sizeof(b->boxName));\n"},{"port":"    for (i = 0; i < IN_BOX_COUNT && i < PT_BOX_SLOTS; i++)\n"},{"port":"        CtrBoxMon(&b->slot[i], GetBoxMonDataAt(box, i, MON_DATA_SPECIES),\n"},{"port":"                  GetBoxMonDataAt(box, i, MON_DATA_IS_EGG), GetBoxMonDataAt(box, i, MON_DATA_PERSONALITY));\n"},{"port":"    for (i = 0; i < PARTY_SIZE; i++) {\n"},{"port":"        u8 name[POKEMON_NAME_LENGTH + 1];\n"},{"port":"\n"},{"port":"        CtrBoxMon(&b->party[i], GetMonData(&gPlayerParty[i], MON_DATA_SPECIES),\n"},{"port":"                  GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG), GetMonData(&gPlayerParty[i], MON_DATA_PERSONALITY));\n"},{"port":"        if (b->party[i].species) {\n"},{"port":"            GetMonData(&gPlayerParty[i], MON_DATA_NICKNAME, name);\n"},{"port":"            name[POKEMON_NAME_LENGTH] = EOS;\n"},{"port":"            CtrBoxCopy(b->partyName[i], name, sizeof(b->partyName[i]));\n"},{"port":"            b->partyLevel[i] = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);\n"},{"port":"        } else\n"},{"port":"            memset(b->partyName[i], EOS, sizeof(b->partyName[i]));\n"},{"port":"    }\n"},{"port":"    if (b->holding)\n"},{"port":"        CtrBoxMon(&b->held, GetMonData(&gStorage->movingMon, MON_DATA_SPECIES),\n"},{"port":"                  GetMonData(&gStorage->movingMon, MON_DATA_IS_EGG), GetMonData(&gStorage->movingMon, MON_DATA_PERSONALITY));\n"},{"port":"    CtrBoxMon(&b->mon, gStorage->displayMonSpecies, gStorage->displayMonIsEgg, gStorage->displayMonPersonality);\n"},{"port":"    for (i = 0; i < 4; i++)\n"},{"port":"        CtrBoxCopy(b->monText[i], gStorage->displayMonTexts[i], sizeof(b->monText[i]));\n"},{"port":"    if (b->state == PT_BOX_STATE_MENU) {\n"},{"port":"        b->menuCount = gStorage->menuItemsCount > PT_BOX_MENU_MAX ? PT_BOX_MENU_MAX : gStorage->menuItemsCount;\n"},{"port":"        b->menuCursor = (s8)Menu_GetCursorPos();\n"},{"port":"        for (i = 0; i < b->menuCount; i++)\n"},{"port":"            CtrBoxCopy(b->menu[i], gStorage->menuItems[i].text, sizeof(b->menu[i]));\n"},{"port":"    } else if (b->state == PT_BOX_STATE_YESNO) {\n"},{"port":"        b->menuCount = 2;\n"},{"port":"        b->menuCursor = (s8)Menu_GetCursorPos();\n"},{"port":"    } else if (b->state == PT_BOX_STATE_CHOOSE) {\n"},{"port":"        u8 chosen = gStorage->chooseBoxMenu.curBox;\n"},{"port":"\n"},{"port":"        CtrBoxCopy(b->chooseName, GetBoxNamePtr(chosen), sizeof(b->chooseName));\n"},{"port":"        for (i = 0; i < IN_BOX_COUNT; i++)\n"},{"port":"            if (GetBoxMonDataAt(chosen, i, MON_DATA_SPECIES) != SPECIES_NONE)\n"},{"port":"                b->chooseCount++;\n"},{"port":"    }\n"},{"port":"    if (sCtrStorageMessage)\n"},{"port":"        CtrBoxCopy(b->message, gStorage->actionText, sizeof(b->message));\n"},{"port":"    else\n"},{"port":"        memset(b->message, EOS, sizeof(b->message));\n"},{"port":"    return 1;\n"},{"port":"}\n"}]}]}

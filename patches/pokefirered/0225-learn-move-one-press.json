{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/party_menu.c","before_sha256":"1cfea7eabdf8878f596215fc2bfa50f5613b389df4307c698d0818f0a98c2de1","after_sha256":"c189a7e185e53a8600643dd0490e28bdc189ec3866b5c3acff19ebb7408ee5b8","remove":false,"lines":[{"span":[0,4952]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The lower screen shows a party message whole, but the game turns its pages one button press at a time, so the same text\n"},{"port":"// stayed there for each press. The text that asks to replace a move has three pages (who wants to learn it, that the\n"},{"port":"// Pokemon knows four, the question): only the last, the question, is shown, and the YES/NO box follows at once.\n"},{"port":"static void CtrLearn_KeepLastPage(u8 *text)\n"},{"port":"{\n"},{"port":"    u8 *page = text, *p;\n"},{"port":"\n"},{"port":"    for (p = text; *p != EOS; p++)\n"},{"port":"    {\n"},{"port":"        if (*p == CHAR_PROMPT_SCROLL || *p == CHAR_PROMPT_CLEAR)\n"},{"port":"            page = p + 1;\n"},{"port":"        else if (*p == EXT_CTRL_CODE_BEGIN)\n"},{"port":"        {\n"},{"port":"            u8 length = GetExtCtrlCodeLength(p[1]);\n"},{"port":"\n"},{"port":"            p += length != 0 ? length : 1;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"    if (page != text)\n"},{"port":"        StringCopy(text, page);\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[4952,3]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    if (str == gText_PkmnNeedsToReplaceMove)\n"},{"port":"        CtrLearn_KeepLastPage(gStringVar4);\n"},{"port":"#endif\n"},{"span":[4955,116]},{"port":"#ifndef PLATFORM_3DS\n"},{"port":"        // The Summary asks which move to forget itself (the lower screen shows the question): no message to press through.\n"},{"line":5071},{"port":"#endif\n"},{"span":[5072,1820]}]}]}
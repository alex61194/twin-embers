{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_setup.c","before_sha256":"3e6490b7d544f03d3cbbf47c7d74397366310cffd8ec780e8e48d2c9778ff689","after_sha256":"b4995d3e7aecd731d7ee3d664cfb7a8b71e93ccba02a3c1768aec8c7780d5201","remove":false,"lines":[{"span":[0,249]},{"port":" * the next ones the balls are blocked (CtrNuzlocke_CanCatch), except for the optional duplicates and shiny clauses (see\n"},{"port":" * CtrNuzlocke_BeginWild). Scripted and legendary battles, the Safari Zone and trainers never\n"},{"span":[250,2]},{"port":"extern int CtrOptions_NuzDuplicates(void);\n"},{"port":"extern int CtrOptions_NuzShiny(void);\n"},{"port":"extern int CtrOptions_NuzLevelCap(void);\n"},{"port":"extern s8 GetSetPokedexFlag(u16 nationalNum, u8 caseId);   // caseId 1 is FLAG_GET_CAUGHT\n"},{"span":[252,13]},{"port":"    /* The two optional clauses: a species the Pokedex already has as caught (DUPLICATES) and a shiny Pokemon (SHINY) never use up\n"},{"port":"     * the area's catch. They may always be caught and the area stays free for its own first encounter. */\n"},{"port":"    if ((CtrOptions_NuzDuplicates()\n"},{"port":"         && GetSetPokedexFlag(SpeciesToNationalPokedexNum(GetMonData(&gEnemyParty[0], MON_DATA_SPECIES, NULL)), 1))\n"},{"port":"     || (CtrOptions_NuzShiny() && IsMonShiny(&gEnemyParty[0])))\n"},{"port":"        return;\n"},{"span":[265,9]},{"port":"}\n"},{"port":"\n"},{"port":"/* LEVEL CAPS: the cap is the level of the ace of the next Gym Leader (the Elite Four and the Champion for the last badge), by the\n"},{"port":" * number of badges. A Pokemon at or above it gets no experience (battle_script_commands.c). */\n"},{"port":"bool8 CtrNuzlocke_AtLevelCap(u8 level)\n"},{"port":"{\n"},{"port":"    static const u8 sCtrNzLevelCaps[NUM_BADGES + 1] = {14, 21, 24, 29, 43, 43, 47, 50, 65};\n"},{"port":"    u8 badges = 0, i;\n"},{"port":"\n"},{"port":"    if (!CtrOptions_Nuzlocke() || !CtrOptions_NuzLevelCap())\n"},{"port":"        return FALSE;\n"},{"port":"    for (i = 0; i < NUM_BADGES; ++i)\n"},{"port":"        if (FlagGet(FLAG_BADGE01_GET + i))\n"},{"port":"            ++badges;\n"},{"port":"    return level >= sCtrNzLevelCaps[badges];\n"},{"span":[274,833]}]},{"path":"src/battle_script_commands.c","before_sha256":"36f1dd74ce85f2a0f7296e920532a104e13db8be15575249e877eda103012e1a","after_sha256":"a170a0db7e3ed581be7d81b50490dd5b3ac645b7851a32acf4d8642ebc795411","remove":false,"lines":[{"span":[0,3119]},{"port":"extern bool8 CtrNuzlocke_AtLevelCap(u8 level);   // the NUZLOCKE LEVEL CAPS option: no experience at or above the badge's cap\n"},{"span":[3119,108]},{"port":"            else if (GetMonData(&gPlayerParty[gBattleStruct->expGetterMonId], MON_DATA_LEVEL) == MAX_LEVEL\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"                  || CtrNuzlocke_AtLevelCap(GetMonData(&gPlayerParty[gBattleStruct->expGetterMonId], MON_DATA_LEVEL))\n"},{"port":"#endif\n"},{"port":"                  )\n"},{"span":[3228,6715]}]}]}
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/field_camera.c","before_sha256":"fe78af68148914980f999f313f678f43a978595d0594a5f88929a342008603b9","after_sha256":"c1083bfcca7e0d05d1c6bb1a8ae352b4a0beeb3c6e9facf396f4f911ccca00ed","remove":false,"lines":[{"span":[0,8]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_map_edge.h\"\n"},{"port":"#endif\n"},{"span":[8,298]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"static unsigned GetEdgeMapMetatile(void *ctx, int x, int y)\n"},{"port":"{\n"},{"port":"    (void)ctx;\n"},{"port":"    return VMap.map[(x + MAP_OFFSET) + VMap.Xsize * (y + MAP_OFFSET)];\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* Visual fallback for positions the backup map leaves undefined and no connection\n"},{"port":" * covers: where a closed edge is a plain continuation (3ds_map_edge.h) the picture\n"},{"port":" * carries on, otherwise the border block is drawn exactly as before. Drawing only. */\n"},{"port":"static bool8 GetEdgeExtensionMetatile(const struct MapLayout *layout, int x, int y, u16 *metatile, u8 *layer)\n"},{"port":"{\n"},{"port":"    const struct MapConnections *connections = gMapHeader.connections;\n"},{"port":"    int mapX = x - MAP_OFFSET, mapY = y - MAP_OFFSET;\n"},{"port":"    int closed = CTR_EDGE_WEST | CTR_EDGE_EAST | CTR_EDGE_NORTH | CTR_EDGE_SOUTH;\n"},{"port":"    int srcX, srcY, i;\n"},{"port":"    if (!CtrEdge_MapTypeExtends(gMapHeader.mapType))\n"},{"port":"        return FALSE;\n"},{"port":"    if (mapX >= 0 && mapX < layout->width && mapY >= 0 && mapY < layout->height)\n"},{"port":"        return FALSE;\n"},{"port":"    if (x >= 0 && x < VMap.Xsize && y >= 0 && y < VMap.Ysize\n"},{"port":"        && VMap.map[x + VMap.Xsize * y] != MAPGRID_UNDEFINED)\n"},{"port":"        return FALSE;\n"},{"port":"    if (connections != NULL && connections->connections != NULL)\n"},{"port":"    {\n"},{"port":"        for (i = 0; i < connections->count; ++i)\n"},{"port":"        {\n"},{"port":"            switch (connections->connections[i].direction)\n"},{"port":"            {\n"},{"port":"            case CONNECTION_WEST:  closed &= ~CTR_EDGE_WEST; break;\n"},{"port":"            case CONNECTION_EAST:  closed &= ~CTR_EDGE_EAST; break;\n"},{"port":"            case CONNECTION_NORTH: closed &= ~CTR_EDGE_NORTH; break;\n"},{"port":"            case CONNECTION_SOUTH: closed &= ~CTR_EDGE_SOUTH; break;\n"},{"port":"            }\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"    if (!CtrEdge_Resolve(GetEdgeMapMetatile, NULL, layout->width, layout->height, closed, mapX, mapY, &srcX, &srcY))\n"},{"port":"        return FALSE;\n"},{"port":"    if (!CtrEdge_Accept(GetEdgeMapMetatile(NULL, srcX, srcY),\n"},{"port":"                        MapGridGetMetatileBehaviorAt(srcX + MAP_OFFSET, srcY + MAP_OFFSET),\n"},{"port":"                        MapGridGetMetatileBehaviorAt(x, y)))\n"},{"port":"        return FALSE;\n"},{"port":"    *metatile = MapGridGetMetatileIdAt(srcX + MAP_OFFSET, srcY + MAP_OFFSET);\n"},{"port":"    *layer = MapGridGetMetatileLayerTypeAt(srcX + MAP_OFFSET, srcY + MAP_OFFSET);\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[306,6]},{"port":"    if (!GetViewportConnectionMetatile(&mapLayout, x, y, &metatileId, &layer)\n"},{"port":"        && !GetEdgeExtensionMetatile(mapLayout, x, y, &metatileId, &layer))\n"},{"span":[313,346]}]}]}

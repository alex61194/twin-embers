u16 sCtrCompanionGfx;            // who it is now: CTR_NPC_FOLLOWER + national dex (+ CTR_NPC_FOLLOWER_FEMALE), or 0\n"},{"port":"static u8 sCtrFollowerId = OBJECT_EVENTS_COUNT;\n"},{"port":"static s16 sCtrTrailX[CTR_FOLLOWER_TRAIL];\n"},{"port":"static s16 sCtrTrailY[CTR_FOLLOWER_TRAIL];\n"},{"port":"static u8 sCtrTrailElevation[CTR_FOLLOWER_TRAIL];\n"},{"port":"static u8 sCtrTrailCount;\n"},{"port":"static s16 sCtrPlayerX;\n"},{"port":"static s16 sCtrPlayerY;\n"},{"port":"static bool8 sCtrFollowerWaiting;       // made or hidden: it shows itself at the player's next step\n"},{"port":"\n"},{"port":"static u16 CtrCompanion_Pick(void)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < PARTY_SIZE; i++)\n"},{"port":"    {\n"},{"port":"        struct Pokemon *mon = &gPlayerParty[i];\n"},{"port":"        u16 species = GetMonData(mon, MON_DATA_SPECIES_OR_EGG);\n"},{"port":"        u16 dex;\n"},{"port":"\n"},{"port":"        if (species == SPECIES_NONE || species == SPECIES_EGG || GetMonData(mon, MON_DATA_HP) == 0)\n"},{"port":"            continue;\n"},{"port":"        dex = SpeciesToNationalPokedexNum(species);\n"},{"port":"        if (dex < 1 || dex > CTR_FOLLOWER_SPECIES)\n"},{"port":"            continue;\n"},{"port":"        if (GetMonGender(mon) == MON_FEMALE && CtrFollower_Has(dex, TRUE))\n"},{"port":"            return CTR_NPC_FOLLOWER + CTR_NPC_FOLLOWER_FEMALE + dex;\n"},{"port":"        if (CtrFollower_Has(dex, FALSE))\n"},{"port":"            return CTR_NPC_FOLLOWER + dex;\n"},{"port":"    }\n"},{"port":"    return 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static struct ObjectEvent *CtrFollower_Get(void)\n"},{"port":"{\n"},{"port":"    if (sCtrFollowerId < OBJECT_EVENTS_COUNT && gObjectEvents[sCtrFollowerId].active\n"},{"port":"     && gObjectEvents[sCtrFollowerId].localId == LOCALID_CTR_FOLLOWER)\n"},{"port":"        return &gObjectEvents[sCtrFollowerId];\n"},{"port":"    return NULL;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Every follower there is: one made on this map, or one that a save kept (the object events are saved).\n"},{"port":"static void CtrFollower_Remove(void)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)\n"},{"port":"        if (gObjectEvents[i].active && gObjectEvents[i].localId == LOCALID_CTR_FOLLOWER)\n"},{"port":"            RemoveObjectEvent(&gObjectEvents[i]);\n"},{"port":"    sCtrFollowerId = OBJECT_EVENTS_COUNT;\n"},{"port":"    sCtrTrailCount = 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrFollower_Place(struct ObjectEvent *follower, s16 x, s16 y, u8 elevation)\n"},{"port":"{\n"},{"port":"    struct Sprite *sprite = &gSprites[follower->spriteId];\n"},{"port":"\n"},{"port":"    MoveObjectEventToMapCoords(follower, x, y);\n"},{"port":"    sprite->x2 = 0;\n"},{"port":"    sprite->y2 = 0;\n"},{"port":"    follower->currentElevation = elevation;\n"},{"port":"    follower->previousElevation = elevation;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrFollower_Hide(struct ObjectEvent *follower)\n"},{"port":"{\n"},{"port":"    ObjectEventClearHeldMovementIfActive(follower);\n"},{"port":"    follower->invisible = TRUE;\n"},{"port":"    sCtrFollowerWaiting = TRUE;\n"},{"port":"    sCtrTrailCount = 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrFollower_Update(void)\n"},{"port":"{\n"},{"port":"    struct ObjectEvent *player, *follower;\n"},{"port":"    int mode = CtrOptions_Companion();\n"},{"port":"    bool8 hide;\n"},{"port":"\n"},{"port":"    if (gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT)\n"},{"port":"        return;\n"},{"port":"    player = &gObjectEvents[gPlayerAvatar.objectEventId];\n"},{"port":"    if (!player->active || player->spriteId >= MAX_SPRITES)\n"},{"port":"        return;     // a map is being made\n"},{"port":"    sCtrCompanionGfx = 0;\n"},{"port":"    if (mode != 0 && gQuestLogState != QL_STATE_PLAYBACK && InUnionRoom() != TRUE)\n"},{"port":"        sCtrCompanionGfx = CtrCompanion_Pick();\n"},{"port":"    follower = CtrFollower_Get();\n"},{"port":"    if (mode != 1 || sCtrCompanionGfx == 0)\n"},{"port":"    {\n"},{"port":"        CtrFollower_Remove();\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    hide = (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE | PLAYER_AVATAR_FLAG_SURFING\n"},{"port":"                                 | PLAYER_AVATAR_FLAG_UNDERWATER)) || player->invisible;\n"},{"port":"    if (follower == NULL)\n"},{"port":"    {\n"},{"port":"        u8 id;\n"},{"port":"\n"},{"port":"        CtrFollower_Remove();       // one a save kept\n"},{"port":"        if (hide)\n"},{"port":"            return;\n"},{"port":"        id = SpawnSpecialObjectEventParameterized(CTR_FOLLOWER_GFX, MOVEMENT_TYPE_NONE, LOCALID_CTR_FOLLOWER,\n"},{"port":"                                                  player->currentCoords.x, player->currentCoords.y, player->currentElevation);\n"},{"port":"        if (id == OBJECT_EVENTS_COUNT)\n"},{"port":"            return;\n"},{"port":"        sCtrFollowerId = id;\n"},{"port":"        follower = &gObjectEvents[id];\n"},{"port":"        follower->invisible = TRUE;\n"},{"port":"        sCtrFollowerWaiting = TRUE;\n"},{"port":"        sCtrTrailCount = 0;\n"},{"port":"        sCtrPlayerX = player->currentCoords.x;\n"},{"port":"        sCtrPlayerY = player->currentCoords.y;\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    if (hide)\n"},{"port":"    {\n"},{"port":"        if (!follower->invisible || !sCtrFollowerWaiting)\n"},{"port":"            CtrFollower_Hide(follower);\n"},{"port":"        sCtrPlayerX = player->currentCoords.x;\n"},{"port":"        sCtrPlayerY = player->currentCoords.y;\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    if (player->currentCoords.x != sCtrPlayerX || player->currentCoords.y != sCtrPlayerY)\n"},{"port":"    {\n"},{"port":"        // The player began a step: the tile it left is the follower's next one. When it did not leave the tile\n"},{"port":"        // that was seen last (the camera moved the map, a warp, a jump away), the follower starts again from there.\n"},{"port":"        if (player->previousCoords.x == sCtrPlayerX && player->previousCoords.y == sCtrPlayerY)\n"},{"port":"        {\n"},{"port":"            if (sCtrTrailCount == CTR_FOLLOWER_TRAIL)\n"},{"port":"            {\n"},{"port":"                u8 n;\n"},{"port":"\n"},{"port":"                for (n = 1; n < CTR_FOLLOWER_TRAIL; n++)\n"},{"port":"                {\n"},{"port":"                    sCtrTrailX[n - 1] = sCtrTrailX[n];\n"},{"port":"                    sCtrTrailY[n - 1] = sCtrTrailY[n];\n"},{"port":"                    sCtrTrailElevation[n - 1] = sCtrTrailElevation[n];\n"},{"port":"                }\n"},{"port":"                sCtrTrailCount--;\n"},{"port":"            }\n"},{"port":"            sCtrTrailX[sCtrTrailCount] = player->previousCoords.x;\n"},{"port":"            sCtrTrailY[sCtrTrailCount] = player->previousCoords.y;\n"},{"port":"            sCtrTrailElevation[sCtrTrailCount] = player->previousElevation;\n"},{"port":"            sCtrTrailCount++;\n"},{"port":"            if (sCtrFollowerWaiting)\n"},{"port":"            {\n"},{"port":"                // It shows itself on the tile the player left, facing as the player does.\n"},{"port":"                CtrFollower_Place(follower, sCtrTrailX[0], sCtrTrailY[0], sCtrTrailElevation[0]);\n"},{"port":"                ObjectEventTurn(follower, player->facingDirection);\n"},{"port":"                follower->invisible = FALSE;\n"},{"port":"                sCtrFollowerWaiting = FALSE;\n"},{"port":"                sCtrTrailCount = 0;\n"},{"port":"            }\n"},{"port":"        }\n"},{"port":"        else\n"},{"port":"        {\n"},{"port":"            CtrFollower_Hide(follower);\n"},{"port":"        }\n"},{"port":"        sCtrPlayerX = player->currentCoords.x;\n"},{"port":"        sCtrPlayerY = player->currentCoords.y;\n"},{"port":"    }\n"},{"port":"    if (sCtrFollowerWaiting)\n"},{"port":"        return;\n"},{"port":"    ObjectEventClearHeldMovementIfFinished(follower);\n"},{"port":"    if (!ObjectEventIsMovementOverridden(follower) && sCtrTrailCount != 0)\n"},{"port":"    {\n"},{"port":"        s16 x = sCtrTrailX[0], y = sCtrTrailY[0];\n"},{"port":"        s16 dx = x - follower->currentCoords.x, dy = y - follower->currentCoords.y;\n"},{"port":"        u8 elevation = sCtrTrailElevation[0], n;\n"},{"port":"        bool8 fast = (gPlayerAvatar.flags & PLAYER_AVATAR_FLAG_DASH) || sCtrTrailCount > 1;\n"},{"port":"\n"},{"port":"        for (n = 1; n < sCtrTrailCount; n++)\n"},{"port":"        {\n"},{"port":"            sCtrTrailX[n - 1] = sCtrTrailX[n];\n"},{"port":"            sCtrTrailY[n - 1] = sCtrTrailY[n];\n"},{"port":"            sCtrTrailElevation[n - 1] = sCtrTrailElevation[n];\n"},{"port":"        }\n"},{"port":"        sCtrTrailCount--;\n"},{"port":"        if (dx == 0 && dy == 0)\n"},{"port":"            return;\n"},{"port":"        if ((dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy) == 1)\n"},{"port":"        {\n"},{"port":"            u8 direction = dx > 0 ? DIR_EAST : dx < 0 ? DIR_WEST : dy > 0 ? DIR_SOUTH : DIR_NORTH;\n"},{"port":"\n"},{"port":"            follower->currentElevation = elevation;\n"},{"port":"            follower->previousElevation = elevation;\n"},{"port":"            ObjectEventSetHeldMovement(follower, fast ? GetWalkFastMovementAction(direction)\n"},{"port":"                                                       : GetWalkNormalMovementAction(direction));\n"},{"port":"        }\n"},{"port":"        else\n"},{"port":"        {\n"},{"port":"            CtrFollower_Place(follower, x, y, elevation);       // farther than a step (a ledge, stairs): it is there\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The compositor (CtrNpc_Sprite below) asks who an object event is drawn as: the follower is its Pokemon, and the player\n"},{"port":"// on foot is the Pokemon when the player chose BE IT.\n"},{"port":"static void CtrFollower_Override(const struct ObjectEvent *objectEvent, unsigned *graphicsId)\n"},{"port":"{\n"},{"port":"    if (sCtrCompanionGfx == 0)\n"},{"port":"        return;\n"},{"port":"    if (objectEvent->localId == LOCALID_CTR_FOLLOWER)\n"},{"port":"        *graphicsId = sCtrCompanionGfx;\n"},{"port":"    else if (objectEvent->localId == LOCALID_PLAYER && CtrOptions_Companion() == 2\n"},{"port":"          && (*graphicsId == OBJ_EVENT_GFX_RED_NORMAL || *graphicsId == OBJ_EVENT_GFX_GREEN_NORMAL))\n"},{"port":"        *graphicsId = sCtrCompanionGfx;\n"},{"port":"}\n"},{"port":"\n"},{"span":[9442,22]},{"port":"        CtrFollower_Override(objectEvent, graphicsId);\n"},{"span":[9464,27]}]},{"path":"src/overworld.c","before_sha256":"e70cc5bbcb6868a47d6c4d388285bae53d976df2754974482532f233e75f91af","after_sha256":"dee42e5f030b21648eec079b6de5b5853d5a390a88c79b8cbef9cedc32928216","remove":false,"lines":[{"span":[0,1556]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrFollower_Update();\n"},{"port":"#endif\n"},{"span":[1556,2210]}]},{"path":"src/field_control_avatar.c","before_sha256":"35734b9a2408edd9daa48eb25e7ce53185a5deb3fb712c4ad8d2c7038eac5277","after_sha256":"64ccdea0fb61b5febb071a3c9f3759e1c436572f3eff6a5826dc3c3fa1af74df","remove":false,"lines":[{"span":[0,456]},{"port":"    if (objectEventId == OBJECT_EVENTS_COUNT || gObjectEvents[objectEventId].localId == LOCALID_PLAYER\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"     || gObjectEvents[objectEventId].localId == LOCALID_CTR_FOLLOWER\n"},{"port":"#endif\n"},{"port":"        )\n"},{"span":[457,6]},{"port":"        if (objectEventId == OBJECT_EVENTS_COUNT || gObjectEvents[objectEventId].localId == LOCALID_PLAYER\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"         || gObjectEvents[objectEventId].localId == LOCALID_CTR_FOLLOWER\n"},{"port":"#endif\n"},{"port":"            )\n"},{"span":[464,737]}]},{"pat
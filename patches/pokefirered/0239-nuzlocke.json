{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_setup.c","before_sha256":"f33e6cdd3ff22ab9fe0f43219dfc795a9abfcc5f01c04e96809b98ddf5b952fd","after_sha256":"3e6490b7d544f03d3cbbf47c7d74397366310cffd8ec780e8e48d2c9778ff689","remove":false,"lines":[{"span":[0,246]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"/* NUZLOCKE (the OPTIONS row): a random wild encounter is the first of its area (the map's region map section) or it is not. The areas\n"},{"port":" * already used are bits in SaveBlock2's spare filler, so they belong to the save. The first encounter of an area may be caught; in\n"},{"port":" * the next ones the balls are blocked (CtrNuzlocke_CanCatch). Scripted and legendary battles, the Safari Zone and trainers never\n"},{"port":" * come through here. */\n"},{"port":"extern int CtrOptions_Nuzlocke(void);\n"},{"port":"\n"},{"port":"static bool8 sCtrNzBlocked;\n"},{"port":"\n"},{"port":"#define CTR_NZ_AREA_BIT(section) (1 << ((section) & 7))\n"},{"port":"#define CTR_NZ_AREA_BYTE(section) (gSaveBlock2Ptr->filler_B20[(section) >> 3])\n"},{"port":"\n"},{"port":"static void CtrNuzlocke_BeginWild(void)\n"},{"port":"{\n"},{"port":"    u8 section = gMapHeader.regionMapSectionId;\n"},{"port":"\n"},{"port":"    sCtrNzBlocked = FALSE;\n"},{"port":"    if (!CtrOptions_Nuzlocke())\n"},{"port":"        return;\n"},{"port":"    if (CTR_NZ_AREA_BYTE(section) & CTR_NZ_AREA_BIT(section))\n"},{"port":"        sCtrNzBlocked = TRUE;\n"},{"port":"    else\n"},{"port":"        CTR_NZ_AREA_BYTE(section) |= CTR_NZ_AREA_BIT(section);\n"},{"port":"}\n"},{"port":"\n"},{"port":"bool8 CtrNuzlocke_CanCatch(void)\n"},{"port":"{\n"},{"port":"    return !sCtrNzBlocked;\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[246,7]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrNuzlocke_BeginWild();\n"},{"port":"#endif\n"},{"span":[253,170]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCtrNzBlocked = FALSE;\n"},{"port":"#endif\n"},{
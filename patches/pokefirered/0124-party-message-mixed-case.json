{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/party_menu.c","before_sha256":"f00fbab6e296c46ea3a4f04297e714b4c8272756ba4e0b495476f660ef9b571c","after_sha256":"81cb8bc8c930332d08b65b8628d59bda61d16dbb49677fee48be872e4dbad30d","remove":false,"lines":[{"span":[0,1601]},{"port":"/* The Party's message for the lower screen as FireRed prints it: mixed case, its accent (POK\\xc3\\xa9MON, in UTF-8),\n"},{"port":" * its punctuation; control codes left out, line breaks and prompts as spaces. */\n"},{"port":"static void CtrBottomParty_RecordMessage(const u8 *str)\n"},{"port":"{\n"},{"port":"    unsigned i = 0, o = 0, size = sizeof(sBottomPartyMsg);\n"},{"port":"\n"},{"port":"    while (str[i] != EOS && o + 4 < size)\n"},{"port":"    {\n"},{"port":"        u8 c = str[i++];\n"},{"port":"\n"},{"port":"        if (c == EXT_CTRL_CODE_BEGIN)\n"},{"port":"        {\n"},{"port":"            u8 n = GetExtCtrlCodeLength(str[i]);\n"},{"port":"            i += n ? n : 1;\n"},{"port":"            continue;\n"},{"port":"        }\n"},{"port":"        if (c >= CHAR_A && c <= CHAR_Z)\n"},{"port":"            sBottomPartyMsg[o++] = (char)('A' + (c - CHAR_A));\n"},{"port":"        else if (c >= CHAR_a && c <= CHAR_z)\n"},{"port":"            sBottomPartyMsg[o++] = (char)('a' + (c - CHAR_a));\n"},{"port":"        else if (c >= CHAR_0 && c <= CHAR_9)\n"},{"port":"            sBottomPartyMsg[o++] = (char)('0' + (c - CHAR_0));\n"},{"port":"        else if (c == CHAR_e_ACUTE)\n"},{"port":"        {\n"},{"port":"            sBottomPartyMsg[o++] = (char)0xC3;\n"},{"port":"            sBottomPartyMsg[o++] = (char)0xA9;\n"},{"port":"        }\n"},{"port":"        else if (c == CHAR_E_ACUTE)\n"},{"port":"            sBottomPartyMsg[o++] = 'E';\n"},{"port":"        else if (c == CHAR_ELLIPSIS)\n"},{"port":"        {\n"},{"port":"            sBottomPartyMsg[o++] = '.';\n"},{"port":"            sBottomPartyMsg[o++] = '.';\n"},{"port":"            sBottomPartyMsg[o++] = '.';\n"},{"port":"        }\n"},{"port":"        else\n"},{"port":"        {\n"},{"port":"            char ch = c == CHAR_PERIOD ? '.' : c == CHAR_COMMA ? ',' : c == CHAR_EXCL_MARK ? '!' : c == CHAR_QUESTION_MARK ? '?'\n"},{"port":"                    : c == CHAR_HYPHEN ? '-' : c == CHAR_SLASH ? '/' : c == CHAR_COLON ? ':' : c == CHAR_PERCENT ? '%'\n"},{"port":"                    : c == CHAR_LEFT_PAREN ? '(' : c == CHAR_RIGHT_PAREN ? ')' : ' ';\n"},{"port":"\n"},{"port":"            if (ch != ' ' || (o > 0 && sBottomPartyMsg[o - 1] != ' '))\n"},{"port":"                sBottomPartyMsg[o++] = ch;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"    while (o > 0 && sBottomPartyMsg[o - 1] == ' ')\n"},{"port":"        --o;\n"},{"port":"    sBottomPartyMsg[o] = 0;\n"},{"port":"}\n"},{"span":[1606,5151]}]}]}

{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"8196a540f70c1015bd4035278ef5f479c0584667a20159e5275aa10200867bfb","after_sha256":"f14159a0a9b5d0d7a8f9d97096bd63c65fac7234ea82cea4a81d6cfe98e14990","remove":false,"lines":[{"span":[0,55]},{"port":"// ctr_poketouch_card.c: what the front of FireRed's Trainer Card shows, for the\n"},{"port":"// native TRAINER CARD screen (3ds_port/src/3ds_poketouch_card.c)\n"},{"port":"int CtrPokeTouch_CardGender(void);\n"},{"port":"unsigned CtrPokeTouch_CardTrainerId(void);\n"},{"port":"unsigned CtrPokeTouch_CardMoney(void);\n"},{"port":"unsigned CtrPokeTouch_CardPlayHours(void);\n"},{"port":"unsigned CtrPokeTouch_CardPlayMinutes(void);\n"},{"port":"int CtrPokeTouch_CardHasPokedex(void);\n"},{"port":"unsigned CtrPokeTouch_CardDexCaught(void);\n"},{"port":"unsigned CtrPokeTouch_CardDexSeen(void);\n"},{"port":"unsigned CtrPokeTouch_CardBadgeMask(void);\n"},{"line":81},{"span":[55,28]}]},{"path":"src/ctr_poketouch_card.c","before_sha256":null,"after_sha256":"3c4d5aa104c2ab5cb12376ecc3eba0b0308d2120e48eb2e8a348fc806dc33818","remove":false,"lines":[{"port":"/* PokeTouch bridge: the facts FireRed's Trainer Card (trainer_card.c) shows on\n"},{"port":" * its front, read from the save and the game's own counters for the native\n"},{"port":" * TRAINER CARD screen. Read-only; nothing is copied or kept here. The caps and\n"},{"port":" * the Pokedex's scope are the card's own (SetPlayerCardData, GetCaughtMonsCount,\n"},{"port":" * PrintTimeOnCard).\n"},{"port":" */\n"},{"port":"#include \"global.h\"\n"},{"port":"#include \"event_data.h\"\n"},{"port":"#include \"money.h\"\n"},{"port":"#include \"pokedex.h\"\n"},{"port":"#include \"constants/flags.h\"\n"},{"port":"#include \"ctr_poketouch.h\"\n"},{"port":"\n"},{"port":"int CtrPokeTouch_CardGender(void)\n"},{"port":"{\n"},{"port":"    return gSaveBlock2Ptr->playerGender;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The card's ID No.: the low 16 bits of the trainer ID, shown as five digits.\n"},{"port":"unsigned CtrPokeTouch_CardTrainerId(void)\n"},{"port":"{\n"},{"port":"    return (gSaveBlock2Ptr->playerTrainerId[1] << 8) | gSaveBlock2Ptr->playerTrainerId[0];\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrPokeTouch_CardMoney(void)\n"},{"port":"{\n"},{"port":"    return GetMoney(&gSaveBlock1Ptr->money);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The card caps the clock at 999 hours and 59 minutes.\n"},{"port":"unsigned CtrPokeTouch_CardPlayHours(void)\n"},{"port":"{\n"},{"port":"    return gSaveBlock2Ptr->playTimeHours > 999 ? 999 : gSaveBlock2Ptr->playTimeHours;\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrPokeTouch_CardPlayMinutes(void)\n"},{"port":"{\n"},{"port":"    return gSaveBlock2Ptr->playTimeMinutes > 59 ? 59 : gSaveBlock2Ptr->playTimeMinutes;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The card shows the Pokedex line only once the player has the Pokedex.\n"},{"port":"int CtrPokeTouch_CardHasPokedex(void)\n"},{"port":"{\n"},{"port":"    return FlagGet(FLAG_SYS_POKEDEX_GET) != 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The same Pokedex as the card's count: the National one when it is enabled, else Kanto's.\n"},{"port":"unsigned CtrPokeTouch_CardDexCaught(void)\n"},{"port":"{\n"},{"port":"    return IsNationalPokedexEnabled() ? GetNationalPokedexCount(FLAG_GET_CAUGHT) : GetKantoPokedexCount(FLAG_GET_CAUGHT);\n"},{"port":"}\n"},{"port":"\n"},{"port":"unsigned CtrPokeTouch_CardDexSeen(void)\n"},{"port":"{\n"},{"port":"    return IsNationalPokedexEnabled() ? GetNationalPokedexCount(FLAG_GET_SEEN) : GetKantoPokedexCount(FLAG_GET_SEEN);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Bit n: the nth Kanto badge (FLAG_BADGE01_GET + n), as the card's hasBadge[].\n"},{"port":"unsigned CtrPokeTouch_CardBadgeMask(void)\n"},{"port":"{\n"},{"port":"    unsigned mask = 0;\n"},{"port":"    int i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < NUM_BADGES; i++)\n"},{"port":"        if (FlagGet(FLAG_BADGE01_GET + i))\n"},{"port":"            mask |= 1u << i;\n"},{"port":"    return mask;\n"},{"port":"}\n"}]}]}

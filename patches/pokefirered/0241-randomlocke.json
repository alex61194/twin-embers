e Pokemon of the ball.\n"},{"port":"static u16 CtrRandomStarter(u16 species)\n"},{"port":"{\n"},{"port":"    if (CtrOptions_Randomlocke()\n"},{"port":"     && (species == SPECIES_BULBASAUR || species == SPECIES_CHARMANDER || species == SPECIES_SQUIRTLE)\n"},{"port":"     && species == VarGet(VAR_TEMP_2)\n"},{"port":"     && gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_PALLET_TOWN_PROFESSOR_OAKS_LAB)\n"},{"port":"     && gSaveBlock1Ptr->location.mapNum == MAP_NUM(MAP_PALLET_TOWN_PROFESSOR_OAKS_LAB)\n"},{"port":"     && !FlagGet(FLAG_SYS_POKEDEX_GET))\n"},{"port":"        species = CtrOptions_RandomSpecies(T1_READ_32(gSaveBlock2Ptr->playerTrainerId), 0x20000, species);\n"},{"port":"    return species;\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[1519,6]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    species = CtrRandomStarter(species);\n"},{"port":"#endif\n"},{"span":[1525,74]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    species = CtrRandomStarter(species);\n"},{"port":"#endif\n"},{"span":[1599,143]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    species = CtrRandomStarter(species);\n"},{"port":"#endif\n"},{"span":[1742,522]}]}]}
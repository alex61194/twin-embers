;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomItemPc_IsOpen(void)\n"},{"port":"{\n"},{"port":"    return gMain.callback2 == ItemPc_MainCB && sStateDataPtr != NULL;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomItemPc_State(void)\n"},{"port":"{\n"},{"port":"    u8 taskId;\n"},{"port":"    TaskFunc func;\n"},{"port":"\n"},{"port":"    if (!CtrBottomItemPc_IsOpen() || !ItemPcTask(&taskId) || gPaletteFade.active || IsPCScreenEffectRunning_TurnOn())\n"},{"port":"        return CTR_BAG_BUSY;\n"},{"port":"    func = gTasks[taskId].func;\n"},{"port":"    if (func == Task_ItemPcMain || func == Task_ItemPcMoveItemModeRun)\n"},{"port":"        return CTR_BAG_LIST;\n"},{"port":"    if (func == Task_ItemPcSubmenuRun)\n"},{"port":"        return CTR_BAG_ACTIONS;\n"},{"port":"    if (func == Task_ItemPcHandleWithdrawMultiple)\n"},{"port":"        return CTR_BAG_QUANTITY;\n"},{"port":"    if (func == Task_ItemPcWaitButtonAndFinishWithdrawMultiple || func == Task_ItemPcWaitButtonWithdrawMultipleFailed\n"},{"port":"        || func == gTask_ItemPcWaitButtonAndExitSubmenu || CtrMenuHelpers_InMessage(taskId))\n"},{"port":"        return CTR_BAG_MESSAGE;\n"},{"port":"    return CTR_BAG_BUSY;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomItemPc_Count(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomItemPc_IsOpen() ? sStateDataPtr->nItems : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomItemPc_MaxShowed(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomItemPc_IsOpen() ? sStateDataPtr->maxShowed : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrBottomItemPc_Cursor(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomItemPc_IsOpen() ? sListMenuState.scroll + sListMenuState.row : -1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Changes when the input state, the list or the move mode do.\n"},{"port":"unsigned CtrBottomItemPc_Serial(void)\n"},{"port":"{\n"},{"port":"    if (!CtrBottomItemPc_IsOpen())\n"},{"port":"        return 0;\n"},{"port
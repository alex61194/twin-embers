{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/menu.c","before_sha256":"3808291958d449fa253d152f6f5049e463fc551661f0ed4958c025ad015c2fd4","after_sha256":"76bae59a8826edf8bc0bc5e1b765097b84b104679ca30bcae78aad3a491b16d5","remove":false,"lines":[{"span":[0,7]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"ctr_poketouch.h\"\n"},{"port":"#include \"field_message_box.h\"\n"},{"port":"#endif\n"},{"span":[7,22]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"static EWRAM_DATA bool8 sCtrMenuGrid = FALSE;   // the menu set up last is a grid (MultichoiceGrid_InitCursor)\n"},{"port":"static void CtrMenu_TakeLabels(u8 windowId, u8 left, u8 top, u8 optionWidth, u8 optionHeight, u8 cols, u8 count);\n"},{"port":"#endif\n"},{"span":[29,251]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCtrMenuGrid = FALSE;\n"},{"port":"    CtrMenu_TakeLabels(windowId, left, top, 0, cursorHeight, 0, numChoices);\n"},{"port":"#endif\n"},{"span":[280,30]},{"port":"// The field's choices (a script's multichoice, YES/NO or grid, the PC's menus) are drawn by the lower screen\n"},{"port":"// (3ds_bottom.c MODE_CHOICE): every text printed in a window is noted (the last CTR_MENU_NOTES of them, cursor arrows\n"},{"port":"// aside), and when a menu's cursor is set up its rows take their labels from the texts printed in its window at their\n"},{"port":"// places, one line of a text a row (YES/NO is one text). A menu whose every row has a label is the one drawn below.\n"},{"port":"#define CTR_MENU_NOTES 16\n"},{"port":"#define CTR_MENU_ROWS 8\n"},{"port":"#define CTR_MENU_LABEL 24\n"},{"port":"struct CtrMenuNote\n"},{"port":"{\n"},{"port":"    u8 windowId, x, y, used;\n"},{"port":"    u8 text[CTR_MENU_LABEL];\n"},{"port":"};\n"},{"port":"static EWRAM_DATA struct CtrMenuNote sCtrMenuNote[CTR_MENU_NOTES] = {0};\n"},{"port":"static EWRAM_DATA u8 sCtrMenuNoteNext = 0;\n"},{"port":"static EWRAM_DATA u8 sCtrMenuLabel[CTR_MENU_ROWS][CTR_MENU_LABEL] = {0};\n"},{"port":"static EWRAM_DATA u8 sCtrMenuLabels = 0;\n"},{"port":"static EWRAM_DATA u32 sCtrMenuInitFrame = 0;\n"},{"port":"static EWRAM_DATA u32 sCtrMenuInputFrame = 0;\n"},{"port":"\n"},{"port":"static void MultichoiceGrid_RedrawCursor(u8 oldCursorPos, u8 newCursorPos);\n"},{"port":"extern int CtrBottom_IsFieldCallback(void);\n"},{"port":"\n"},{"port":"void CtrMenu_NoteText(u8 windowId, u8 x, u8 y, const u8 *str)\n"},{"port":"{\n"},{"port":"    struct CtrMenuNote *note = &sCtrMenuNote[sCtrMenuNoteNext];\n"},{"port":"    int n = 0;\n"},{"port":"\n"},{"port":"    if (str == NULL || str == gText_SelectorArrow2)\n"},{"port":"        return;\n"},{"port":"    note->windowId = windowId;\n"},{"port":"    note->x = x;\n"},{"port":"    note->y = y;\n"},{"port":"    note->used = TRUE;\n"},{"port":"    while (*str != EOS && n < CTR_MENU_LABEL - 1)\n"},{"port":"    {\n"},{"port":"        if (*str == PLACEHOLDER_BEGIN && str[1] != EOS)\n"},{"port":"        {\n"},{"port":"            const u8 *var = str[1] == PLACEHOLDER_ID_PLAYER ? gSaveBlock2Ptr->playerName\n"},{"port":"                          : str[1] == PLACEHOLDER_ID_STRING_VAR_1 ? gStringVar1\n"},{"port":"                          : str[1] == PLACEHOLDER_ID_STRING_VAR_2 ? gStringVar2\n"},{"port":"                          : str[1] == PLACEHOLDER_ID_STRING_VAR_3 ? gStringVar3 : NULL;\n"},{"port":"\n"},{"port":"            str += 2;\n"},{"port":"            while (var != NULL && *var != EOS && n < CTR_MENU_LABEL - 1)\n"},{"port":"                note->text[n++] = *var++;\n"},{"port":"            continue;\n"},{"port":"        }\n"},{"port":"        note->text[n++] = *str++;\n"},{"port":"    }\n"},{"port":"    note->text[n] = EOS;\n"},{"port":"    sCtrMenuNoteNext = (sCtrMenuNoteNext + 1) % CTR_MENU_NOTES;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Line `line` of a noted text into a row's label; FALSE when it has no such line or it is empty.\n"},{"port":"static bool8 CtrMenu_NoteLine(const struct CtrMenuNote *note, int line, u8 *out)\n"},{"port":"{\n"},{"port":"    const u8 *s = note->text;\n"},{"port":"    int n = 0;\n"},{"port":"\n"},{"port":"    while (line > 0 && *s != EOS)\n"},{"port":"        if (*s++ == CHAR_NEWLINE)\n"},{"port":"            line--;\n"},{"port":"    if (line > 0)\n"},{"port":"        return FALSE;\n"},{"port":"    while (*s != EOS && *s != CHAR_NEWLINE)\n"},{"port":"        out[n++] = *s++;\n"},{"port":"    out[n] = EOS;\n"},{"port":"    return n != 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The labels of the menu just set up in windowId: row r at (left + its column * optionWidth, top + its row *\n"},{"port":"// optionHeight); for each, the newest noted text of that window that has a line there.\n"},{"port":"static void CtrMenu_TakeLabels(u8 windowId, u8 left, u8 top, u8 optionWidth, u8 optionHeight, u8 cols, u8 count)\n"},{"port":"{\n"},{"port":"    int row, i;\n"},{"port":"\n"},{"port":"    sCtrMenuLabels = 0;\n"},{"port":"    sCtrMenuInitFrame = sCtrMenuInputFrame = gMain.vblankCounter2;\n"},{"port":"    if (count == 0 || count > CTR_MENU_ROWS || optionHeight == 0)\n"},{"port":"        return;\n"},{"port":"    for (row = 0; row < count; row++)\n"},{"port":"    {\n"},{"port":"        int x = cols ? (row % cols) * optionWidth + left : 0;\n"},{"port":"        int y = (cols ? row / cols : row) * optionHeight + top;\n"},{"port":"        bool8 found = FALSE;\n"},{"port":"\n"},{"port":"        for (i = 1; i <= CTR_MENU_NOTES && !found; i++)\n"},{"port":"        {\n"},{"port":"            const struct CtrMenuNote *note = &sCtrMenuNote[(sCtrMenuNoteNext + CTR_MENU_NOTES - i) % CTR_MENU_NOTES];\n"},{"port":"            int dy = y - note->y + optionHeight / 2;\n"},{"port":"\n"},{"port":"            if (!note->used || note->windowId != windowId || dy < 0)\n"},{"port":"                continue;\n"},{"port":"            if (cols && (note->x < x || note->x >= x + optionWidth))\n"},{"port":"                continue;\n"},{"port":"            found = CtrMenu_NoteLine(note, dy / optionHeight, sCtrMenuLabel[row]);\n"},{"port":"        }\n"},{"port":"        if (!found)\n"},{"port":"            return;\n"},{"port":"    }\n"},{"port":"    sCtrMenuLabels = count;\n"},{"port":"}\n"},{"port":"\n"},{"span":[310,9]},{"port":"    sCtrMenuInputFrame = gMain.vblankCounter2;\n"},{"span":[319,3]},{"port":"        if (sCtrMenuGrid)\n"},{"port":"            MultichoiceGrid_RedrawCursor(oldPos, sMenu.cursorPos);\n"},{"port":"        else\n"},{"port":"            Menu_RedrawCursor(oldPos, sMenu.cursorPos);\n"},{"span":[323,2]},{"port":"}\n"},{"port":"\n"},{"port":"// The field's choice the lower screen draws: open while its window is up and its input was read in the last few\n"},{"port":"// frames (a YES/NO waits 5 before its first), ready when it was read on the last one.\n"},{"port":"int CtrFieldChoice_IsOpen(void)\n"},{"port":"{\n"},{"port":"    return sCtrMenuLabels != 0 && CtrBottom_IsFieldCallback() && sMenu.windowId != WINDOW_NONE\n"},{"port":"        && GetWindowAttribute(sMenu.windowId, WINDOW_BG) != 0xFF && gMain.vblankCounter2 - sCtrMenuInputFrame <= 8;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrFieldChoice_Ready(void)\n"},{"port":"{\n"},{"port":"    return CtrFieldChoice_IsOpen() && gMain.vblankCounter2 - sCtrMenuInputFrame <= 1 && !gPaletteFade.active;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrFieldChoice_Count(void)\n"},{"port":"{\n"},{"port":"    return CtrFieldChoice_IsOpen() ? sCtrMenuLabels : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrFieldChoice_Columns(void)\n"},{"port":"{\n"},{"port":"    return sCtrMenuGrid ? sMenu.columns : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrFieldChoice_Cursor(void)\n"},{"port":"{\n"},{"port":"    return sMenu.cursorPos;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// Changes with every menu set up.\n"},{"port":"unsigned CtrFieldChoice_Serial(void)\n"},{"port":"{\n"},{"port":"    return (sCtrMenuInitFrame & 0xFFFF) | (unsigned)sMenu.windowId << 16 | (unsigned)sCtrMenuLabels << 24;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrFieldChoice_Label(int index, char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (index >= 0 && index < sCtrMenuLabels)\n"},{"port":"        CtrBattle_FireRedText(sCtrMenuLabel[index], out, size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The question in the field's message box, if it shows one.\n"},{"port":"int CtrFieldChoice_Prompt(char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (IsFieldMessageBoxHidden())\n"},{"port":"        return 0;\n"},{"port":"    CtrBattle_FireRedText(gStringVar4, out, size);\n"},{"port":"    return out[0] != 0;\n"},{"span":[325,337]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    sCtrMenuGrid = TRUE;\n"},{"port":"    CtrMenu_TakeLabels(windowId, left, top, optionWidth, cursorHeight, cols, numChoices);\n"},{"port":"#endif\n"},{"span":[662,126]},{"port":"    u8 oldPos;\n"},{"port":"\n"},{"port":"    CTR_MENU_TAKE_ASK();\n"},{"port":"    oldPos = sMenu.cursorPos;\n"},{"span":[789,139]}]},{"path":"src/text_printer.c","before_sha256":"267932d7f04018fd579a5e431699d1639f30ed2ca7c7548c86ba6e06b98b562e","after_sha256":"61760b6db8bbf439c383339062c928aa8f9eb7faac412a883da1f309b745761d","remove":false,"lines":[{"span":[0,3]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"extern void CtrMenu_NoteText(u8 windowId, u8 x, u8 y, const u8 *str);\n"},{"port":"#endif\n"},{"span":[3,72]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrMenu_NoteText(textSubPrinter->windowId, textSubPrinter->x, textSubPrinter->y, textSubPrinter->currentChar);\n"},{"port":"#endif\n"},{"span":[75,270]}]}]}
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/easy_chat_2.c","before_sha256":"e8be3cd5e59ab6698e9e7f062f0e48bdbe9498504606f4dcd6c36ddd911625fd","after_sha256":"805e5f5b55c59a8ff438c4d624c481c7a337f01d2dbb1d2ec0cd482b3eb2bb89","remove":false,"lines":[{"span":[0,1371]},{"port":"\n"},{"port":"// The lower screen draws Easy Chat itself (3ds_field_easychat_impl.h), a remote for this screen: the phrase as chips, the groups, the\n"},{"port":"// word list, the Yes/No questions. It only reads the screen's own state (below) and answers with the game's own keys, so the game\n"},{"port":"// decides everything. The screen exists once its task runs Task_RunEasyChat (the setup has allocated everything by then).\n"},{"port":"extern void CtrText_CopyFireRed(const u8 *text, char *out, unsigned size);\n"},{"port":"\n"},{"port":"int CtrBottomEasyChat_IsOpen(void)\n"},{"port":"{\n"},{"port":"    return gMain.callback2 == CB2_EasyChatScreen && FindTaskIdByFunc(Task_RunEasyChat) != TASK_NONE && sEasyChatScreen != NULL;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// It waits for a key now (not setting up, not running a command of its own, not fading out).\n"},{"port":"int CtrBottomEasyChat_Ready(void)\n"},{"port":"{\n"},{"port":"    return CtrBottomEasyChat_IsOpen() && gTasks[FindTaskIdByFunc(Task_RunEasyChat)].data[EZCHAT_TASK_STATE] == 1 && !gPaletteFade.active;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// One number of its state, or -1 while it is not open: 0 type, 1 columns, 2 rows, 3 state (0 field, 1 footer, 2 group, 3 word,\n"},{"port":"// 4 quit, 5 delete all, 6 confirm), 4 main cursor column, 5 its row, 6 words, 7 alphabetical, 8 group cursor x (-1: the blue box),\n"},{"port":"// 9 its y, 10 group rows above, 11 group rows (last index), 12 word rows above, 13 word rows (last index), 14 word cursor x, 15 its\n"},{"port":"// y, 16 groups, 17 words in the list (the list's state only), 18 the state the question came from, 19 the question's cursor.\n"},{"port":"__attribute__((optimize(\"no-jump-tables\", \"no-tree-switch-conversion\")))\n"},{"port":"int CtrBottomEasyChat_Get(int what)\n"},{"port":"{\n"},{"port":"    if (!CtrBottomEasyChat_IsOpen())\n"},{"port":"        return -1;\n"},{"port":"    switch (what)\n"},{"port":"    {\n"},{"port":"    case 0: return sEasyChatScreen->type;\n"},{"port":"    case 1: return sEasyChatScreen->numColumns;\n"},{"port":"    case 2: return sEasyChatScreen->numRows;\n"},{"port":"    case 3: return sEasyChatScreen->state;\n"},{"port":"    case 4: return sEasyChatScreen->mainCursorColumn;\n"},{"port":"    case 5: return sEasyChatScreen->mainCursorRow;\n"},{"port":"    case 6: return sEasyChatScreen->numWords;\n"},{"port":"    case 7: return sEasyChatScreen->isAlphaMode;\n"},{"port":"    case 8: return sEasyChatScreen->selectGroupCursorX;\n"},{"port":"    case 9: return sEasyChatScreen->selectGroupCursorY;\n"},{"port":"    case 10: return sEasyChatScreen->selectGroupRowsAbove;\n"},{"port":"    case 11: return sEasyChatScreen->selectGroupNumRows;\n"},{"port":"    case 12: return sEasyChatScreen->selectWordRowsAbove;\n"},{"port":"    case 13: return sEasyChatScreen->selectWordNumRows;\n"},{"port":"    case 14: return sEasyChatScreen->selectWordCursorX;\n"},{"port":"    case 15: return sEasyChatScreen->selectWordCursorY;\n"},{"port":"    case 16: return GetNumDisplayableGroups();\n"},{"port":"    case 17: return sEasyChatScreen->state == 3 ? GetNumDisplayedWords() : 0;\n"},{"port":"    case 18: return sEasyChatScreen->stateBackup;\n"},{"port":"    case 19: return Menu_GetCursorPos();\n"},{"port":"    }\n"},{"port":"    return -1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A word of the phrase being written (\"\" while the slot is empty), a group's name (by its place in the menu), a word of the open list.\n"},{"port":"void CtrBottomEasyChat_Phrase(int slot, char *out, int size)\n"},{"port":"{\n"},{"port":"    u8 text[64];\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!CtrBottomEasyChat_IsOpen() || slot < 0 || slot >= sEasyChatScreen->numWords)\n"},{"port":"        return;\n"},{"port":"    CopyEasyChatWord(text, sEasyChatScreen->ecWordBuffer[slot]);\n"},{"port":"    CtrText_CopyFireRed(text, out, (unsigned)size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomEasyChat_GroupName(int index, char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!CtrBottomEasyChat_IsOpen() || index < 0 || index >= GetNumDisplayableGroups())\n"},{"port":"        return;\n"},{"port":"    CtrText_CopyFireRed(GetEasyChatWordGroupName(GetSelectedGroupByIndex(index)), out, (unsigned)size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomEasyChat_ListWord(int index, char *out, int size)\n"},{"port":"{\n"},{"port":"    u8 text[64];\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!CtrBottomEasyChat_IsOpen() || sEasyChatScreen->state != 3 || index < 0 || index >= GetNumDisplayedWords())\n"},{"port":"        return;\n"},{"port":"    CopyEasyChatWord(text, GetDisplayedWordByIndex(index));\n"},{"port":"    CtrText_CopyFireRed(text, out, (unsigned)size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The screen's own title, and the two lines of a question: 0 quit editing, 1 delete all, 2 is it as shown.\n"},{"port":"void CtrBottomEasyChat_Title(char *out, int size)\n"},{"port":"{\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (CtrBottomEasyChat_IsOpen())\n"},{"port":"        CtrText_CopyFireRed(GetTitleText(), out, (unsigned)size);\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrBottomEasyChat_Question(int which, int line, char *out, int size)\n"},{"port":"{\n"},{"port":"    const u8 *str1 = NULL, *str2 = NULL;\n"},{"port":"\n"},{"port":"    out[0] = 0;\n"},{"port":"    if (!CtrBottomEasyChat_IsOpen())\n"},{"port":"        return;\n"},{"port":"    if (which == 0)\n"},{"port":"        GetEasyChatConfirmCancelText(&str1, &str2);\n"},{"port":"    else if (which == 1)\n"},{"port":"        GetEasyChatConfirmDeletionText(&str1, &str2);\n"},{"port":"    else\n"},{"port":"        GetEasyChatConfirmText(&str1, &str2);\n"},{"port":"    if (line != 0)\n"},{"port":"        str1 = str2;\n"},{"port":"    if (str1 != NULL)\n"},{"port":"        CtrText_CopyFireRed(str1, out, (unsigned)size);\n"},{"port":"}\n"},{"line":1371}]}]}
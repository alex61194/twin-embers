{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/credits.c","before_sha256":"96690b500af63cc588b2ca8060f4af5b1a69a99797870099831d77a32027af25","after_sha256":"368ee0c2a3878abd4cae7f2c773f2357766c01d4a3e37e096786428741742177","remove":false,"lines":[{"span":[0,191]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// A CREDITS_MAP scene's map is being loaded, one step a frame (RollCredits). In the port's own data.\n"},{"port":"static bool8 sCtrCreditsMapLoading __attribute__((section(\".data\"))) = FALSE;\n"},{"port":"#endif\n"},{"span":[191,764]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"        // ARM11 dispatches VBlank between callbacks, rather than interrupting this\n"},{"port":"        // scene: the map's loader waits for its tileset copy\n"},{"port":"        // (FreeTempTileDataBuffersIfPossible), which only the VBlank finishes, so\n"},{"port":"        // looping here until the map was up froze the credits on their first\n"},{"port":"        // CREDITS_MAP (Cerulean, after Charizard). Load it one step a frame, as\n"},{"port":"        // CREDITS_MAPNEXT does; the map's own fade-in starts during the load.\n"},{"port":"        if (!sCtrCreditsMapLoading)\n"},{"port":"        {\n"},{"port":"            if (gPaletteFade.active)\n"},{"port":"                return 0;\n"},{"port":"            DestroyCreditsWindow();\n"},{"port":"            sCreditsMgr->subseqno = 0;\n"},{"port":"            sCtrCreditsMapLoading = TRUE;\n"},{"port":"        }\n"},{"port":"        if (!DoOverworldMapScrollScene(sCreditsMgr->whichMon))\n"},{"port":"            return 0;\n"},{"port":"        sCtrCreditsMapLoading = FALSE;\n"},{"port":"        {\n"},{"port":"#else\n"},{"span":[955,6]},{"port":"#endif\n"},{"span":[961,485]}]}]}
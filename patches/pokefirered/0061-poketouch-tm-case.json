,{"port":"int CtrBottomTMCase_MaxShowed(void)\n"},{"line":1739},{"port":"    return CtrBottomTMCase_IsOpen() && gMain.callback2 == CB2_Idle ? sTMCaseDynamicResources->maxTMsShown : 0;\n"},{"line":1748},{"line":1741},{"port":"// The selection as Task_HandleListInput keeps it: first shown row + cursor row.\n"},{"port":"int CtrBottomTMCase_Cursor(void)\n"},{"line":1739},{"port":"    return sTMCaseStaticResources.scrollOffset + sTMCaseStaticResources.selectedRow;\n"},{"line":1748},{"line":1741},{"port":"// Changes when the input state, the list or the context menu do.\n"},{"port":"unsigned CtrBottomTMCase_Serial(void)\n"},{"line":1739},{"port":"    return (unsigned)CtrBottomTMCase_State() | (unsigned)CtrBottomTMCase_Count() << 8\n"},{"port":"        | (unsigned)sCtrTMCaseTask << 16\n"},{"port":"        | (unsigned)(CtrBottomTMCase_IsOpen() && gMain.callback2 == CB2_Idle ? sTMCaseDynamicResources->contextMenuWindowId : 0xFF) << 24;\n"},{"line":1748},{"line":1741},{"port":"unsigned CtrBottomTMCase_Item(int index)\n"},{"line":1739},{"port":"    if (index < 0 || index >= CtrBottomTMCase_Count())\n"},{"port":"        return ITEM_NONE;\n"},{"port":"    return BagGetItemIdByPocketPosition(POCKET_TM_CASE, index);\n"},{"line":1748},{"line":1741},{"port":"void CtrBottomTMCase_Title(char *out, int size)\n"},{"line":1739},{"port":"    CtrPokeTouch_Text(gText_TMCase, 32, out, size);\n"},{"line":1748},{"line":1741},{"port":"// The move a TM/HM teaches.\n"},{"port":"void CtrBottomTMCase_MoveName(unsigned item, char *out, int size)\n"},{"line":1739},{"port":"    CtrPokeTouch_Text(gMoveNames[ItemIdToBattleMoveId(item)], MOVE_NAME_LENGTH + 1, out, size);\n"},{"line":1748},{"line":1741},{"port":"/* What the TM Case shows under GBA pixel (x, y): a list row (its index;\n"},{"port":" * CANCEL is CtrBottomTMCase_Count), the scroll arrows above and below the\n"},{"port":" * list (CreateListScrollArrows: x 160, y 8 and 88), or a row of the open\n"},{"port":" * context menu. -1 for nothing. */\n
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"e403905286bec0f244eb58969136ef8c11cef2d7805e64406715903fe0b391dc","after_sha256":"884b16eeccaf2b4aab450d7516ec00888dbcf5b9e2876bc73b5592d880ab4d71","remove":false,"lines":[{"span":[0,127]},{"port":"// battle_controller_player.c: PokeTouch's battle screen follows the player's controller. InBattle is the battle's own\n"},{"port":"// callback (not a menu opened from it); State is CTR_BATTLE_ACTION while the controller waits at the action menu,\n"},{"port":"// CTR_BATTLE_MOVE at the move list (the handlers that take A and B), else CTR_BATTLE_BUSY. The cursors are the\n"},{"port":"// controller's (action 0 FIGHT, 1 BAG, 2 POKeMON, 3 RUN; move slots 0-3, two to a row), -1 outside their state.\n"},{"port":"enum { CTR_BATTLE_BUSY = 0, CTR_BATTLE_ACTION, CTR_BATTLE_MOVE };\n"},{"port":"int CtrBattle_InBattle(void);\n"},{"port":"int CtrBattle_State(void);\n"},{"port":"int CtrBattle_ActionCursor(void);\n"},{"port":"int CtrBattle_MoveCursor(void);\n"},{"line":126},{"span":[127,1]}]},{"path":"src/battle_controller_player.c","before_sha256":"1fc12b9ed3e5f598eb1fc3761db3d57d44b5b68d6e432042d13d1679d76efa05","after_sha256":"395bd62bb18381fe746829d7d06b4413be5aef4cbe36139780b389eeea81fcbd","remove":false,"lines":[{"span":[0,2966]},{"line":2898},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"/* PokeTouch's battle screen (3ds_bottom.c) follows this controller and drives it with FireRed's own keys.\n"},{"port":" * These only answer questions; the choice, its legality and what follows stay here. */\n"},{"port":"#include \"ctr_poketouch.h\"\n"},{"line":2898},{"port":"// The player's battler waiting at the action menu or the move list; the controller is set to its input\n"},{"port":"// handler only once the screen behind it is built, and leaves it the moment A or B is taken.\n"},{"port":"static int CtrChooser(int *state)\n"},{"line":2889},{"port":"    int i;\n"},{"line":2898},{"port":"    if (gMain.callback2 != BattleMainCB2)\n"},{"port":"        return -1;\n"},{"port":"    for (i = 0; i < gBattlersCount && i < MAX_BATTLERS_COUNT; i++)\n"},{"line":2894},{"port":"        if (gBattlerControllerFuncs[i] == HandleInputChooseAction)\n"},{"line":2911},{"port":"            *state = CTR_BATTLE_ACTION;\n"},{"port":"            return i;\n"},{"line":2962},{"port":"        if (gBattlerControllerFuncs[i] == HandleInputChooseMove)\n"},{"line":2911},{"port":"            *state = CTR_BATTLE_MOVE;\n"},{"port":"            return i;\n"},{"line":2962},{"line":2964},{"port":"    return -1;\n"},{"line":2965},{"line":2898},{"port":"// The battle is on screen (its own main callback): not set up before it, not a menu opened from it.\n"},{"port":"int CtrBattle_InBattle(void)\n"},{"line":2889},{"port":"    return gMain.callback2 == BattleMainCB2;\n"},{"line":2965},{"line":2898},{"port":"int CtrBattle_State(void)\n"},{"line":2889},{"port":"    int state = CTR_BATTLE_BUSY;\n"},{"line":2898},{"port":"    return CtrChooser(&state) >= 0 ? state : CTR_BATTLE_BUSY;\n"},{"line":2965},{"line":2898},{"port":"int CtrBattle_ActionCursor(void)\n"},{"line":2889},{"port":"    int state, battler = CtrChooser(&state);\n"},{"line":2898},{"port":"    return battler >= 0 && state == CTR_BATTLE_ACTION ? gActionSelectionCursor[battler] : -1;\n"},{"line":2965},{"line":2898},{"port":"int CtrBattle_MoveCursor(void)\n"},{"line":2889},{"port":"    int state, battler = CtrChooser(&state);\n"},{"line":2898},{"port":"    return battler >= 0 && state == CTR_BATTLE_MOVE ? gMoveSelectionCursor[battler] : -1;\n"},{"line":2965},{"line":830}]}]}

    {
     "port": "        return;\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "    if ((str[0] == CHAR_T || str[0] == CHAR_V) && str[1] == CHAR_M)\n"
    },
    {
     "port": "        return;\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "    for (j = 0; j < maxLen && str[j] != EOS; j++)\n"

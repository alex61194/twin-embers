{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/field_screen_effect.c","before_sha256":"8a671c35b3953e91e94e5c09eb7c1d3b723173a221fd754e7427adda4f43702a","after_sha256":"a567daa99e68e748b9aac7e18d188d36bcc1a143873b931bf5e27c75a82cf6ad","remove":false,"lines":[{"span":[0,53]},{"port":" * Draws a circle by approximating xy\u00b2 + yx\u00b2 = radius\u00b2.\n"},{"span":[54,1]},{"port":" * error is approximately xy\u00b2 - yx\u00b2. Negative values mean the circle is\n"},{"span":[56,4]},{"port":" * The subtractive terms compute yx\u00b2 - (yx - 1)\u00b2, and therefore the sum\n"},{"port":" * is yx\u00b2 - 1:\n"},{"span":[62,2]},{"port":" *   yx\u00b2 - (yx - 1)\u00b2  | -1 |  1 |  3 |  5 |  7 |  9 | 11 | 13\n"},{"span":[65,1]},{"port":" *   yx\u00b2              |  0 |  1 |  4 |  9 | 16 | 25 | 36 | 49\n"},{"span":[67,1]},{"port":" * The additive terms compute xy\u00b2 - (xy - 1)\u00b2 - 1, and therefore the sum\n"},{"port":" * (badly) approximates \u03a3i\u00b2 - (i - 1)\u00b2, i \u2208 (xy, r), consider r = 18:\n"},{"span":[70,1]},{"port":" *   xy\u00b2 - (xy - 1)\u00b2  | 35 | 33 | 31 |  29 |  27 |  25 | ... |  -1\n"},{"span":[72,2]},{"port":" *   \u03a3i\u00b2 - (i - 1)\u00b2   | 35 | 68 | 99 | 128 | 155 | 180 | ... | 323\n"},{"port":" * 18\u00b2 = 324, so if the iterations ran until xy = 0 the cumulative error\n"},{"port":" * would be xy\u00b2 - r.\n"},{"span":[77,4]},{"port":" * error and an approximation of the midpoint between r\u00b2 and (r + 1)\u00b2.\n"},{"span":[82,3]},{"port":" * directions *in* from centerY \u00b1 radius (using xy for y). Because xy\n"},{"span":[86,376]}]},{"path":"src/item_menu.c","before_sha256":"90cd510373385dd48e5dbbfca005a4a17e28af81fbd49129cdaf24e81dac4e33","after_sha256":"f4a2435e73fe6e2ef44f6e2c09976e0c79490722343b40fe5a17c939fd4d3da4","remove":false,"lines":[{"span":[0,574]},{"port":"            u16 listTiles[18 * 13];\n"},{"port":"            u16 descriptionTiles[25 * 6];\n"},{"spa
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/party_menu.c","before_sha256":"f4851850ab9c57925a19a5e55e575264012ed95df860ff914f61347f225758ba","after_sha256":"4e36c694948e59fef7ee41af4d81ebe0b3fd521f14a502796e3ce51ba10564e9","remove":false,"lines":[{"span":[0,6637]},{"port":"/* A slot's place in the picks of several Pokemon, as FireRed's own box says it: 0 NOT ABLE, 1 ABLE, 2-4 its\n"},{"port":" * entry FIRST to THIRD; -1 when the Party is not picking several or the slot is empty. */\n"},{"port":"int CtrBottomParty_EntryState(int slot)\n"},{"port":"{\n"},{"port":"    struct Pokemon *mon;\n"},{"port":"\n"},{"port":"    if (!CtrBottomParty_ChooseMultiple() || slot < 0 || slot >= PARTY_SIZE)\n"},{"port":"        return -1;\n"},{"port":"    mon = &gPlayerParty[slot];\n"},{"port":"    if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE)\n"},{"port":"        return -1;\n"},{"port":"    if (!GetBattleEntryEligibility(mon))\n"},{"port":"        return 0;\n"},{"port":"    for (int i = 0; i < 3; ++i)\n"},{"port":"        if (gSelectedOrderFromParty[i] != 0 && gSelectedOrderFromParty[i] - 1 == slot)\n"},{"port":"            return 2 + i;\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"span":[6637,132]}]}]}

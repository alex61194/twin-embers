{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/field_weather_effects.c","before_sha256":"28ac11dd8d3cf66bb4e6d7e663cfc2411e8bfc82fec13bb2f2ec55d9c51ec67d","after_sha256":"a55e622051dacc5e8ef56a90d013d607d4262badfc5b90a81255204ae9afd273","remove":false,"lines":[{"span":[0,1]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_video.h\"\n"},{"port":"#endif\n"},{"span":[1,1386]},{"port":"#define tSpriteRow    data[1]\n"},{"span":[1387,3]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    /* The fog is one 64x64 picture drawn at double size, 128x128 on the screen, and it tiles. The GBA overlaps them\n"},{"port":"     * every 64 pixels and wraps the rows round the OAM's 8-bit y; the wide screen does neither, and a semi-transparent\n"},{"port":"     * sprite blends with the one beneath it. So: NUM_FOG_HORIZONTAL_COLUMNS x NUM_FOG_HORIZONTAL_ROWS sprites side by\n"},{"port":"     * side, 128 apart, placed from the scroll modulo 128 and at their true screen position (the stage's authored\n"},{"port":"     * sprites, CtrWeather_FogSprite), so nothing overlaps and the whole 400x240 is covered. */\n"},{"port":"    sprite->y2 = 0;\n"},{"port":"    sprite->x = ((u8)gWeatherPtr->fogHScrollPosX & 127) + sprite->tSpriteColumn * 128 - 128\n"},{"port":"              - sprite->centerToCornerVecX - CTR_STAGE_X;\n"},{"port":"    sprite->y = ((u8)gSpriteCoordOffsetY & 127) + sprite->tSpriteRow * 128 - 128\n"},{"port":"              - sprite->centerToCornerVecY - CTR_STAGE_Y;\n"},{"port":"}\n"},{"port":"\n"},{"port":"bool8 CtrWeather_FogSprite(const struct Sprite *sprite)\n"},{"port":"{\n"},{"port":"    return sprite->callback == FogHorizontalSpriteCallback;\n"},{"port":"}\n"},{"port":"#else\n"},{"span":[1390,8]},{"port":"#endif\n"},{"span":[1398,21]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"                sprite->tSpriteColumn = i % NUM_FOG_HORIZONTAL_COLUMNS;\n"},{"port":"                sprite->tSpriteRow = i / NUM_FOG_HORIZONTAL_COLUMNS;\n"},{"port":"#else\n"},{"span":[1419,3]},{"port":"#endif\n"},{"span":[1422,30]},{"port":"#undef tSpriteRow\n"},{"span":[1452,894]}]},{"path":"src/field_effect.c","before_sha256":"01bf5161196dcfc17ec971b4d312548c70f330e8fcaefae341584262bb9e8249","after_sha256":"72b7138f6ed2ba2482819577a436f87389cab6f68bae9863e27ab229f5ac5f48","remove":false,"lines":[{"span":[0,4080]},{"port":"extern bool8 CtrWeather_FogSprite(const struct Sprite *sprite);\n"},{"span":[4080,11]},{"port":"    if (CtrWeather_FogSprite(sprite))\n"},{"port":"        return TRUE;\n"},{"span":[4091,15]}]},{"path":"include/constants/field_weather.h","before_sha256":"24518565778cd43ce060d190bd72d9796508d173a13ea402591f493862ce390d","after_sha256":"46484ca4bed74264ee84eb4c2044024c221da7a220128140a965d3357ac845be","remove":false,"lines":[{"span":[0,5]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#define NUM_FOG_HORIZONTAL_COLUMNS   5   // the fog's picture, 128 pixels on the screen, over the 400x240 screen\n"},{"port":"#define NUM_FOG_HORIZONTAL_ROWS      3\n"},{"port":"#define NUM_FOG_HORIZONTAL_SPRITES   (NUM_FOG_HORIZONTAL_COLUMNS * NUM_FOG_HORIZONTAL_ROWS)\n"},{"port":"#else\n"},{"span":[5,1]},{"port":"#endif\n"},{"span":[6,18]}]}]}

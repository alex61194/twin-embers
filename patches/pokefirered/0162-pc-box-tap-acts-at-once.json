{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/menu.c","before_sha256":"32b88f67ebca02829671742d9f099b309718ec7ce93ca691742b7c8fe32b4547","after_sha256":"3808291958d449fa253d152f6f5049e463fc551661f0ed4958c025ad015c2fd4","remove":false,"lines":[{"span":[0,315]},{"port":"void CtrMenu_TakeAsk(void)\n"},{"span":[316,612]}]},{"path":"src/pokemon_storage_system_data.c","before_sha256":"cc9546a246b9a4330d9473220db82206978ea61966f268fade465ec1b1e1c5b5","after_sha256":"c639f4c4f077b2c684e3a4a6aa54a4c93c03dd88617d214cbceaeebb39bc26b3","remove":false,"lines":[{"span":[0,1167]},{"port":"// A tap on the lower screen's box (CtrStorage_Tap), done on the next HandleInput in one go: the cursor is put on the\n"},{"port":"// place it touched at once (no glide, none of the D-pad's cell-by-cell walk) and the place's own A runs there, as if\n"},{"port":"// A had been pressed on it. The title's arrows (title positions 1 and 2) scroll and the PARTY and CLOSE BOX buttons\n"},{"port":"// act without the cursor going to them. Area -1: none. Only in the box's normal mode, and never across the Party's edge\n"},{"port":"// (the Party slides in and out by its own inputs).\n"},{"port":"static s8 sCtrTapArea = -1, sCtrTapPos;\n"},{"span":[1170,1]},{"port":"void CtrMenu_TakeAsk(void);     // menu.c: the open menu's cursor onto the row the lower screen asked for\n"},{"line":13},{"port":"void CtrStorage_Tap(int area, int position)\n"},{"span":[1172,1]},{"port":"    sCtrTapArea = area;\n"},{"port":"    sCtrTapPos = position;\n"},{"span":[1174,2]},{"port":"int CtrStorage_TapPending(void)\n"},{"span":[1177,1]},{"port":"    return sCtrTapArea >= 0;\n"},{"line":84},{"span":[1179,1]},{"port":"// The cursor straight onto (area, position), its glide already over.\n"},{"port":"static void CtrSnapCursor(u8 area, u8 position)\n"},{"line":61},{"port":"    if ((sCursorArea == CURSOR_AREA_BUTTONS) != (area == CURSOR_AREA_BUTTONS))\n"},{"port":"        gStorage->cursorSprite->vFlip = !gStorage->cursorSprite->vFlip;\n"},{"port":"    if (sCursorArea == CURSOR_AREA_BOX_TITLE && area != CURSOR_AREA_BOX_TITLE)\n"},{"port":"        AnimateBoxScrollArrows(FALSE);\n"},{"span":[1183,3]},{"port":"    SetCursorPosition(area, position);\n"},{"port":"    gStorage->cursorMoveSteps = 0;\n"},{"port":"    gStorage->cursorSprite->x = gStorage->cursorTargetX;\n"},{"port":"    gStorage->cursorSprite->y = gStorage->cursorTargetY;\n"},{"port":"    DoCursorNewPosUpdate();\n"},{"line":84},{"line":13},{"port":"static bool8 CtrTakeTap(u8 *input)\n"},{"line":61},{"port":"    int area = sCtrTapArea, position = sCtrTapPos, count;\n"},{"port":"    u16 newKeys = gMain.newKeys, heldKeys = gMain.heldKeys, repeated = gMain.newAndRepeatedKeys;\n"},{"port":"    bool8 moved;\n"},{"line":13},{"port":"    sCtrTapArea = -1;\n"},{"port":"    if (area < 0 || gStorage->inBoxMovingMode != MOVE_MODE_NORMAL)\n"},{"line":455},{"port":"    if ((area == CURSOR_AREA_IN_PARTY) != (sCursorArea == CURSOR_AREA_IN_PARTY))\n"},{"line":455},{"port":"    if (area == CURSOR_AREA_BUTTONS)\n"},{"line":93},{"port":"        *input = position == 0 ? INPUT_SHOW_PARTY : INPUT_CLOSE_BOX;\n"},{"line":712},{"line":96},{"port":"    if (area == CURSOR_AREA_BOX_TITLE && position != 0)\n"},{"line":93},{"port":"        *input = position == 1 ? INPUT_SCROLL_LEFT : INPUT_SCROLL_RIGHT;\n"},{"line":712},{"line":96},{"port":"    count = area == CURSOR_AREA_IN_BOX ? IN_BOX_COUNT : area == CURSOR_AREA_IN_PARTY ? PARTY_SIZE + 1 : 1;\n"},{"port":"    if (area > CURSOR_AREA_BOX_TITLE || position < 0 || position >= count)\n"},{"line":455},{"port":"    moved = area != sCursorArea || position != sCursorPosition;\n"},{"port":"    if (moved)\n"},{"port":"        CtrSnapCursor(area, position);\n"},{"port":"    gMain.newKeys = gMain.heldKeys = gMain.newAndRepeatedKeys = A_BUTTON;\n"},{"port":"    *input = HandleInput();\n"},{"port":"    gMain.newKeys = newKeys;\n"},{"port":"    gMain.heldKeys = heldKeys;\n"},{"port":"    gMain.newAndRepeatedKeys = repeated;\n"},{"port":"    if (*input == INPUT_NONE && moved)\n"},{"port":"        *input = INPUT_MOVE_CURSOR;     // an empty cell: the cursor is there, as a D-pad would have left it\n"},{"span":[1187,24]},{"span":[1215,268]},{"span":[1487,272]},{"line":1166},{"port":"    u8 tapInput;\n"},{"line":13},{"port":"    if (CtrTakeTap(&tapInput))\n"},{"port":"        return tapInput;\n"},{"line":1189},{"span":[1759,400]},{"line":1166},{"port":"    CtrMenu_TakeAsk();          // a tapped row: the cursor straight on it, then the tap's A chooses it\n"},{"line":1189},{"span":[2159,50]}]}]}

{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_controller_player.c","before_sha256":"e9bde86426254e6f04ade7ce63c699805766a1ec31a431fe4b2225035b540556","after_sha256":"fcab22ebc4d6e807ace4524547f23039c93fcd0ff7132b928bb09e990f35e6e4","remove":false,"lines":[{"span":[0,3574]},{"port":"\n"},{"port":"// Whether RUN can work at the action menu: not against a trainer (the Safari Zone has its own RUN), and not under a\n"},{"port":"// trapping ability or move; the lower screen greys the button when it cannot. IsRunningFromBattleImpossible is the\n"},{"port":"// game's own check; it leaves messages behind for the battle script, so what it sets is put back.\n"},{"port":"u8 IsRunningFromBattleImpossible(void);     // battle_main.c\n"},{"port":"\n"},{"port":"int CtrBattle_CanRun(void)\n"},{"port":"{\n"},{"port":"    u8 battler = gBattleScripting.battler, chooser = gBattleCommunication[MULTISTRING_CHOOSER];\n"},{"port":"    u8 ability = gLastUsedAbility, potential = gPotentialItemEffectBattler;\n"},{"port":"    int can;\n"},{"port":"\n"},{"port":"    if (gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_SAFARI))\n"},{"port":"        return 0;\n"},{"port":"    can = IsRunningFromBattleImpossible() == BATTLE_RUN_SUCCESS;\n"},{"port":"    gBattleScripting.battler = battler;\n"},{"port":"    gBattleCommunication[MULTISTRING_CHOOSER] = chooser;\n"},{"port":"    gLastUsedAbility = ability;\n"},{"port":"    gPotentialItemEffectBattler = potential;\n"},{"port":"    return can;\n"},{"port":"}\n"},{"span":[3574,55]}]}]}
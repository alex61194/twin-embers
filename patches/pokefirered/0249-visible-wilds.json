{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/event_object_movement.c","before_sha256":"347c4520419278aaf587d2c1e1e2151d7ee52267cdd1b329c9e088deded43a87","after_sha256":"d6d49acad068725db78638b773b6c17e3a860622c554b433e27a7b7247e1b842","remove":false,"lines":[{"span":[0,21]},{"port":"#include \"item.h\"\n"},{"port":"#include \"sound.h\"\n"},{"port":"#include \"3ds_wilds_core.h\"\n"},{"span":[21,3]},{"port":"#include \"constants/field_effects.h\"\n"},{"port":"#include \"constants/items.h\"\n"},{"port":"#include \"constants/songs.h\"\n"},{"span":[24,1838]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"static void CtrWild_Sweep(bool8 drawn);\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[1862,4]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrWild_Sweep(FALSE);       // a loaded game: the wilds it kept are not the table's (their sprites are made just below)\n"},{"port":"#endif\n"},{"span":[1866,7606]},{"port":"// VISIBLE WILDS (OPTIONS: WILD POKEMON, WILD DISPLAY, AGGRESSIVE; all off by default): wild Pokemon are seen walking in the grass and\n"},{"port":"// on the water of the maps that have an encounter table, and the battle starts when the player walks into one, presses A facing it,\n"},{"port":"// or an aggressive one that noticed them catches up. This is the game's side, thin on purpose: the rules (how many may be out, where\n"},{"port":"// one appears, its temperament, the state machine of each, the Repel, whether the step encounters give way) are the port's\n"},{"port":"// 3ds_wilds_core.c, which the host tests run; this file reads the map and the object events, asks it, and does what it answers.\n"},{"port":"// Each wild is an object event of its own (local id CTR_WILD_LOCALID + slot) that the game never moves by itself (no movement\n"},{"port":"// type): the object is the Boy's (his palette, so no object palette is spent) and the compositor shows the Pokemon's picture from\n"},{"port":"// the pack in its place (CtrNpc_Sprite, below), the female one when it is female and the pack has it, as a silhouette when the\n"},{"port":"// option says so and in the Pokemon Tower without the Silph Scope. Species, level, personality (nature, gender, shininess) and\n"},{"port":"// roamer are rolled once by the encounter picker (wild_encounter.c, CtrWilds_Roll) from the map's own table, with the game's own\n"},{"port":"// routines (so the LeafGreen and night variants are the ones a step in the grass would give) and the battle starts with that very\n"},{"port":"// Pokemon (CtrWilds_Start). The table keeps each wild's object event index, so nothing here scans the 16 object events per frame.\n"},{"port":"// Object events: a wild is made only while 4 stay free, and is removed when fewer are, so the map's NPCs and objects never lose\n"},{"port":"// their place to one. With the option off and nothing out, the per-frame update returns at once. Design ideas of overworld wild\n"},{"port":"// Pokemon after PR #83 by mcl5500/Sh3ld0r (MIT); the code is our own.\n"},{"port":"_Static_assert(CTR_WILD_MAX == CTRW_SLOTS, \"one local id for each slot of the table\");\n"},{"port":"_Static_assert(CTR_WILD_LOCALID == CTRW_LOCALID, \"the core knows the local id of the first slot\");\n"},{"port":"_Static_assert(OBJECT_EVENTS_COUNT == CTRW_OBJECTS, \"the core knows FireRed's object event count\");\n"},{"port":"_Static_assert(DIR_SOUTH == CTRW_DIR_SOUTH && DIR_NORTH == CTRW_DIR_NORTH && DIR_WEST == CTRW_DIR_WEST && DIR_EAST == CTRW_DIR_EAST,\n"},{"port":"               \"the core uses the game's directions\");\n"},{"port":"\n"},{"port":"extern int CtrOptions_WildDensity(void);\n"},{"port":"extern int CtrOptions_WildSilhouette(void);\n"},{"port":"extern int CtrOptions_WildAggro(void);\n"},{"port":"extern int CtrOptions_Randomlocke(void);\n"},{"port":"extern int CtrWilds_Max(void);                  // 3ds_game_bridge.c: 2 on an Old 3DS, 6 on a New 3DS\n"},{"port":"extern bool8 CtrWilds_Disabled(void);           // wild_encounter.c\n"},{"port":"extern void CtrWilds_Log(const char *line);          // 3ds_game_bridge.c: one line in port.log (nothing when the log is off)\n"},{"port":"extern void CtrWilds_Probe(u8 *land, u8 *water);\n"},{"port":"extern bool8 CtrWilds_Roll(bool8 isWater, CtrWildMon *mon, u16 *gfx, u8 *gender, u8 *shiny);\n"},{"port":"extern bool8 CtrWilds_Start(const CtrWild *wild);\n"},{"port":"extern bool8 CtrWilds_LevelAllowed(u8 level);\n"},{"port":"\n"},{"port":"static u8 sCtrWildCharge;                       // slot + 1 of a chaser that stands next to the player\n"},{"port":"static u8 sCtrWildElev;                         // the height of the cell the last tile question found\n"},{"port":"static u32 sCtrWildLeadPower;                   // the Pokemon that would fight: level x base stats, refreshed every CTRW_TICK frames\n"},{"port":"static u8 sCtrWildLeadLevel;\n"},{"port":"\n"},{"port":"static struct ObjectEvent *CtrWild_Get(u8 slot)\n"},{"port":"{\n"},{"port":"    u8 id = gCtrWilds.wild[slot].obj;\n"},{"port":"\n"},{"port":"    if (id < OBJECT_EVENTS_COUNT && gObjectEvents[id].active && gObjectEvents[id].localId == CTR_WILD_LOCALID + slot)\n"},{"port":"        return &gObjectEvents[id];\n"},{"port":"    return NULL;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWild_Remove(u8 slot)\n"},{"port":"{\n"},{"port":"    struct ObjectEvent *wild = CtrWild_Get(slot);\n"},{"port":"\n"},{"port":"    if (wild != NULL)\n"},{"port":"        RemoveObjectEvent(wild);\n"},{"port":"    if (sCtrWildCharge == slot + 1)\n"},{"port":"        sCtrWildCharge = 0;\n"},{"port":"    CtrWildsCore_Forget(&gCtrWilds, slot);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWild_RemoveAll(void)\n"},{"port":"{\n"},{"port":"    u8 slot;\n"},{"port":"\n"},{"port":"    for (slot = 0; slot < CTR_WILD_MAX; slot++)\n"},{"port":"        if (gCtrWilds.wild[slot].state != CTRW_S_FREE)\n"},{"port":"            CtrWild_Remove(slot);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static int CtrWild_FreeObjects(void *ctx)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"    int free = 0;\n"},{"port":"\n"},{"port":"    (void)ctx;\n"},{"port":"    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)\n"},{"port":"        if (!gObjectEvents[i].active)\n"},{"port":"            free++;\n"},{"port":"    return free;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static s16 CtrWild_Abs(s16 v)\n"},{"port":"{\n"},{"port":"    return v < 0 ? -v : v;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_InMap(s16 x, s16 y)\n"},{"port":"{\n"},{"port":"    return x >= MAP_OFFSET && y >= MAP_OFFSET && x < gMapHeader.mapLayout->width + MAP_OFFSET && y < gMapHeader.mapLayout->height + MAP_OFFSET;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// What a cell is for a wild that would appear there: land (the tiles the game rolls land encounters on) or water (its water\n"},{"port":"// encounters, at the height of the sea) that is free, or nothing. The height of the cell is left in sCtrWildElev.\n"},{"port":"static int CtrWild_Cell(void *ctx, int x, int y)\n"},{"port":"{\n"},{"port":"    const struct ObjectEvent *player = ctx;\n"},{"port":"    u8 encType, elev;\n"},{"port":"\n"},{"port":"    if (!CtrWild_InMap(x, y))\n"},{"port":"        return CTRW_TILE_NONE;\n"},{"port":"    encType = MapGridGetMetatileAttributeAt(x, y, METATILE_ATTRIBUTE_ENCOUNTER_TYPE);\n"},{"port":"    if (encType == TILE_ENCOUNTER_LAND)\n"},{"port":"    {\n"},{"port":"        elev = MapGridGetElevationAt(x, y);\n"},{"port":"        if (elev == 0)\n"},{"port":"            elev = 3;\n"},{"port":"        if (MapGridGetCollisionAt(x, y) != 0 || !AreElevationsCompatible(player->currentElevation, elev))\n"},{"port":"            return CTRW_TILE_NONE;\n"},{"port":"    }\n"},{"port":"    else if (encType == TILE_ENCOUNTER_WATER && MapGridGetElevationAt(x, y) == 1)\n"},{"port":"        elev = 1;\n"},{"port":"    else\n"},{"port":"        return CTRW_TILE_NONE;\n"},{"port":"    if (GetObjectEventIdByPosition(x, y, elev) != OBJECT_EVENTS_COUNT)\n"},{"port":"        return CTRW_TILE_NONE;\n"},{"port":"    sCtrWildElev = elev;\n"},{"port":"    return encType == TILE_ENCOUNTER_WATER ? CTRW_TILE_WATER : CTRW_TILE_LAND;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A step for a wild that stays on what it is made for: grass for a land Pokemon, the sea for a water one; the game's own collision\n"},{"port":"// decides on land (walls, ledges, other objects), a free sea cell on the water.\n"},{"port":"static bool8 CtrWild_StepOk(struct ObjectEvent *wild, u8 dir, bool8 water)\n"},{"port":"{\n"},{"port":"    s16 x = wild->currentCoords.x, y = wild->currentCoords.y;\n"},{"port":"    u8 encType;\n"},{"port":"\n"},{"port":"    MoveCoords(dir, &x, &y);\n"},{"port":"    if (!CtrWild_InMap(x, y))\n"},{"port":"        return FALSE;\n"},{"port":"    encType = MapGridGetMetatileAttributeAt(x, y, METATILE_ATTRIBUTE_ENCOUNTER_TYPE);\n"},{"port":"    if (water)\n"},{"port":"        return encType == TILE_ENCOUNTER_WATER && MapGridGetElevationAt(x, y) == 1\n"},{"port":"            && GetObjectEventIdByPosition(x, y, wild->currentElevation) == OBJECT_EVENTS_COUNT;\n"},{"port":"    return encType == TILE_ENCOUNTER_LAND && GetCollisionInDirection(wild, dir) == COLLISION_NONE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The Pokemon that would fight, as the Repel looks at it (the first one that can), and how strong it is.\n"},{"port":"static void CtrWild_Lead(void)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"    u16 species;\n"},{"port":"    const struct SpeciesInfo *info;\n"},{"port":"\n"},{"port":"    sCtrWildLeadPower = 0;\n"},{"port":"    sCtrWildLeadLevel = 0;\n"},{"port":"    for (i = 0; i < PARTY_SIZE; i++)\n"},{"port":"    {\n"},{"port":"        if (GetMonData(&gPlayerParty[i], MON_DATA_HP) && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))\n"},{"port":"        {\n"},{"port":"            species = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES);\n"},{"port":"            info = &gSpeciesInfo[species];\n"},{"port":"            sCtrWildLeadLevel = GetMonData(&gPlayerParty[i], MON_DATA_LEVEL);\n"},{"port":"            sCtrWildLeadPower = CtrWildsCore_Power(sCtrWildLeadLevel, info->baseHP + info->baseAttack + info->baseDefense + info->baseSpeed\n"},{"port":"                                                                      + info->baseSpAttack + info->baseSpDefense);\n"},{"port":"            return;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The pass every CTRW_TICK frames: the lead Pokemon, wilds a Repel keeps off, and wilds to give back object events (the farthest first).\n"},{"port":"static void CtrWild_Refresh(int shed)\n"},{"port":"{\n"},{"port":"    u8 slot;\n"},{"port":"    bool8 repel = VarGet(VAR_REPEL_STEP_COUNT) != 0;\n"},{"port":"\n"},{"port":"    CtrWild_Lead();\n"},{"port":"    for (slot = 0; slot < CTR_WILD_MAX; slot++)\n"},{"port":"        if (gCtrWilds.wild[slot].state != CTRW_S_FREE && CtrWildsCore_RepelBlocks(repel, gCtrWilds.wild[slot].level, sCtrWildLeadLevel))\n"},{"port":"            CtrWild_Remove(slot);\n"},{"port":"    while (shed-- > 0)\n"},{"port":"    {\n"},{"port":"        slot = CtrWildsCore_FarthestSlot(&gCtrWilds);\n"},{"port":"        if (slot == CTRW_NONE)\n"},{"port":"            break;\n"},{"port":"        CtrWild_Remove(slot);\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWild_Spawn(const struct ObjectEvent *player)\n"},{"port":"{\n"},{"port":"    CtrWildRing ring;\n"},{"port":"    CtrWildMon mon;\n"},{"port":"    u16 gfx;\n"},{"port":"    u8 slot, gender, shiny, id, surfing;\n"},{"port":"    int x = 0, y = 0, kind = 0;\n"},{"port":"\n"},{"port":"    slot = CtrWildsCore_FreeSlot(&gCtrWilds);\n"},{"port":"    if (slot == CTRW_NONE)\n"},{"port":"        return;\n"},{"port":"    surfing = (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER)) != 0;\n"},{"port":"    ring.px = player->currentCoords.x;\n"},{"port":"    ring.py = player->currentCoords.y;\n"},{"port":"    ring.halfW = DISPLAY_WIDTH / 32 + 1;        // the screen, with a tile for the partial one\n"},{"port":"    ring.halfH = DISPLAY_HEIGHT / 32 + 1;\n"},{"port":"    ring.left = gSaveBlock1Ptr->pos.x - OBJECT_EVENT_VIEW_LEFT;\n"},{"port":"    ring.right = gSaveBlock1Ptr->pos.x + OBJECT_EVENT_VIEW_RIGHT;\n"},{"port":"    ring.top = gSaveBlock1Ptr->pos.y + OBJECT_EVENT_VIEW_TOP;\n"},{"port":"    ring.bottom = gSaveBlock1Ptr->pos.y + OBJECT_EVENT_VIEW_BOTTOM;\n"},{"port":"    if (!CtrWildsCore_PickCell(&gCtrWilds, &ring, CtrWild_Cell, (void *)player, gCtrWilds.mapLand, gCtrWilds.mapWater, surfing, &x, &y, &kind))\n"},{"port":"    {\n"},{"port":"        CtrWildsCore_NoteFail(&gCtrWilds, CTRW_FAIL_NOCELL);\n"},{"port":"        CtrWildsCore_SpawnDone(&gCtrWilds, FALSE);\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    if (!CtrWilds_Roll(kind == CTRW_TILE_WATER, &mon, &gfx, &gender, &shiny))      // the species is picked once there is a cell for it\n"},{"port":"    {\n"},{"port":"        CtrWildsCore_NoteFail(&gCtrWilds, CTRW_FAIL_ROLL);\n"},{"port":"        CtrWildsCore_SpawnDone(&gCtrWilds, FALSE);\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    id = SpawnSpecialObjectEventParameterized(OBJ_EVENT_GFX_BOY, MOVEMENT_TYPE_NONE, CTR_WILD_LOCALID + slot, x, y, sCtrWildElev);\n"},{"port":"    if (id == OBJECT_EVENTS_COUNT)\n"},{"port":"    {\n"},{"port":"        CtrWildsCore_NoteFail(&gCtrWilds, CTRW_FAIL_NOOBJ);\n"},{"port":"        CtrWildsCore_SpawnDone(&gCtrWilds, FALSE);\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    gObjectEvents[id].trainerRange_berryTreeId = CTRW_MARK;     // the Boy has no use for it: the save keeps it, to tell a wild's object from a map's\n"},{"port":"    CtrWildsCore_Commit(&gCtrWilds, slot, &mon, gender, shiny, gfx);\n"},{"port":"    CtrWildsCore_SetObject(&gCtrWilds, slot, id);\n"},{"port":"    CtrWildsCore_SpawnDone(&gCtrWilds, TRUE);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static u8 CtrWild_DirTo(s16 dx, s16 dy)\n"},{"port":"{\n"},{"port":"    if (CtrWild_Abs(dx) >= CtrWild_Abs(dy))\n"},{"port":"        return dx > 0 ? DIR_EAST : DIR_WEST;\n"},{"port":"    return dy > 0 ? DIR_SOUTH : DIR_NORTH;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_InDarkTower(void)\n"},{"port":"{\n"},{"port":"    return gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_POKEMON_TOWER_1F)\n"},{"port":"        && gSaveBlock1Ptr->location.mapNum >= MAP_NUM(MAP_POKEMON_TOWER_1F)\n"},{"port":"        && gSaveBlock1Ptr->location.mapNum <= MAP_NUM(MAP_POKEMON_TOWER_7F)\n"},{"port":"        && !CheckBagHasItem(ITEM_SILPH_SCOPE, 1);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// One field frame of one wild: the core decides, this does it. (No switch conversion: a chain of comparisons would become a lookup\n"},{"port":"// table, which the clean-release audit counts as a FireRed table, as in recipe 0255.)\n"},{"port":"__attribute__((optimize(\"no-jump-tables\", \"no-tree-switch-conversion\")))\n"},{"port":"static void CtrWild_Run(u8 slot, struct ObjectEvent *wild, const struct ObjectEvent *player)\n"},{"port":"{\n"},{"port":"    CtrWild *w = &gCtrWilds.wild[slot];\n"},{"port":"    CtrWildSense sense;\n"},{"port":"    CtrWildAct act;\n"},{"port":"    u8 i;\n"},{"port":"    bool8 ok = FALSE;\n"},{"port":"\n"},{"port":"    if (ObjectEventIsHeldMovementActive(wild))\n"},{"port":"        ObjectEventClearHeldMovementIfFinished(wild);\n"},{"port":"    sense.dx = player->currentCoords.x - wild->currentCoords.x;\n"},{"port":"    sense.dy = player->currentCoords.y - wild->currentCoords.y;\n"},{"port":"    sense.fast = (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_DASH | PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE)) != 0;\n"},{"port":"    sense.sameElev = w->water || AreElevationsCompatible(player->currentElevation, wild->currentElevation);    // the sea is below the shore\n"},{"port":"    sense.busy = ObjectEventIsMovementOverridden(wild);\n"},{"port":"    if (w->shiny && w->age % 75 == 15 && !CtrOptions_WildSilhouette() && !CtrWild_InDarkTower())     // a shiny sparkles now and then\n"},{"port":"    {\n"},{"port":"        gFieldEffectArguments[0] = wild->currentCoords.x - MAP_OFFSET;\n"},{"port":"        gFieldEffectArguments[1] = wild->currentCoords.y - MAP_OFFSET;\n"},{"port":"        gFieldEffectArguments[2] = 2;\n"},{"port":"        FieldEffectStart(FLDEFF_SPARKLE);\n"},{"port":"    }\n"},{"port":"    CtrWildsCore_Think(&gCtrWilds, slot, &sense, &act);\n"},{"port":"    if (act.kind == CTRW_A_TURN)\n"},{"port":"        ObjectEventSetHeldMovement(wild, GetFaceDirectionMovementAction(act.dir[0]));\n"},{"port":"    else if (act.kind == CTRW_A_STEP)\n"},{"port":"    {\n"},{"port":"        for (i = 0; i < act.n && !ok; i++)\n"},{"port":"        {\n"},{"port":"            if (CtrWild_StepOk(wild, act.dir[i], w->water))\n"},{"port":"            {\n"},{"port":"                ObjectEventSetHeldMovement(wild, act.fast ? GetWalkFastMovementAction(act.dir[i]) : GetWalkNormalMovementAction(act.dir[i]));\n"},{"port":"                ok = TRUE;\n"},{"port":"            }\n"},{"port":"        }\n"},{"port":"        CtrWildsCore_StepResult(&gCtrWilds, slot, ok);\n"},{"port":"    }\n"},{"port":"    else if (act.kind == CTRW_A_ALERT)\n"},{"port":"    {\n"},{"port":"        ObjectEventTurn(wild, CtrWild_DirTo(sense.dx, sense.dy));\n"},{"port":"        gFieldEffectArguments[0] = wild->localId;\n"},{"port":"        gFieldEffectArguments[1] = wild->mapNum;\n"},{"port":"        gFieldEffectArguments[2] = wild->mapGroup;\n"},{"port":"        FieldEffectStart(FLDEFF_EXCLAMATION_MARK_ICON);\n"},{"port":"        PlaySE(SE_PIN);\n"},{"port":"    }\n"},{"port":"    else if (act.kind == CTRW_A_CHARGE)\n"},{"port":"        sCtrWildCharge = slot + 1;              // it has caught up: the field input starts the battle\n"},{"port":"    else if (act.kind == CTRW_A_LEAVE)\n"},{"port":"        CtrWild_Remove(slot);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A wild left in the object events that the table does not own (the save kept it; the table is empty after a load, or is a stale\n"},{"port":"// one): removed, only when it carries the mark a wild's object gets (the Boy, no movement type, CTRW_MARK), so a map's own object\n"},{"port":"// events and the companion are never touched. drawn: its sprite exists (a new map); from a load's return to the field it does not yet.\n"},{"port":"static void CtrWild_Sweep(bool8 drawn)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)\n"},{"port":"    {\n"},{"port":"        struct ObjectEvent *objectEvent = &gObjectEvents[i];\n"},{"port":"\n"},{"port":"        if (!objectEvent->active || !CTR_IS_WILD_LOCALID(objectEvent->localId))\n"},{"port":"            continue;\n"},{"port":"        if (!CtrWildsCore_IsOrphan(&gCtrWilds, i, objectEvent->localId,\n"},{"port":"                                   objectEvent->graphicsId == OBJ_EVENT_GFX_BOY && objectEvent->movementType == MOVEMENT_TYPE_NONE\n"},{"port":"                                   && objectEvent->trainerRange_berryTreeId == CTRW_MARK))\n"},{"port":"            continue;\n"},{"port":"        if (drawn)\n"},{"port":"            RemoveObjectEvent(objectEvent);\n"},{"port":"        else\n"},{"port":"            objectEvent->active = FALSE;\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"\n"},{"port":"// One summary line of the map's spawn counters in port.log (the bridge writes nothing when the log is off).\n"},{"port":"static void CtrWild_LogStats(void)\n"},{"port":"{\n"},{"port":"    char line[112];\n"},{"port":"\n"},{"port":"    CtrWildsCore_StatsLine(&gCtrWilds, line, sizeof(line));\n"},{"port":"    CtrWilds_Log(line);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A new map (or the first frame): the table is cleared, and a wild that a save kept (it is an object event like any) is removed.\n"},{"port":"static void CtrWild_NewMap(u16 map)\n"},{"port":"{\n"},{"port":"    if (gCtrWilds.stats.attempts != 0)\n"},{"port":"        CtrWild_LogStats();                     // the map that is left\n"},{"port":"    CtrWildsCore_MapChanged(&gCtrWilds, map);\n"},{"port":"    sCtrWildCharge = 0;\n"},{"port":"    CtrWild_Sweep(TRUE);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWilds_Update(const struct ObjectEvent *player)\n"},{"port":"{\n"},{"port":"    u16 map = ((u16)gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum;\n"},{"port":"    int density = CtrOptions_WildDensity();\n"},{"port":"    CtrWildEnv env;\n"},{"port":"    u8 slot;\n"},{"port":"    int shed;\n"},{"port":"\n"},{"port":"    if (gCtrWilds.mapKnown && gCtrWilds.map == map)\n"},{"port":"    {\n"},{"port":"        if (CtrWildsCore_Idle(&gCtrWilds, density) || CtrWildsCore_Unsupported(&gCtrWilds))\n"},{"port":"            return;                             // the option is off and nothing is out, or nothing can be shown here\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"        CtrWild_NewMap(map);\n"},{"port":"    if (density > 0 && !gCtrWilds.probed)\n"},{"port":"    {\n"},{"port":"        CtrWilds_Probe(&gCtrWilds.mapLand, &gCtrWilds.mapWater);\n"},{"port":"        gCtrWilds.probed = 1;\n"},{"port":"        if (!gCtrWilds.mapLand && !gCtrWilds.mapWater)\n"},{"port":"            return;\n"},{"port":"    }\n"},{"port":"    env.density = density;\n"},{"port":"    env.aggro = CtrOptions_WildAggro();\n"},{"port":"    env.consoleCap = CtrWilds_Max();\n"},{"port":"    env.blocked = CtrOptions_Randomlocke() || gQuestLogState == QL_STATE_PLAYBACK || InUnionRoom() == TRUE || CtrWilds_Disabled();\n"},{"port":"    env.leadPower = sCtrWildLeadPower;\n"},{"port":"    CtrWildsCore_Stir(&gCtrWilds, 0x9E37);\n"},{"port":"    if (CtrWildsCore_Frame(&gCtrWilds, &env))\n"},{"port":"    {\n"},{"port":"        CtrWild_RemoveAll();                    // it stopped working here (option off, Randomlocke, a quest log...)\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    if (!gCtrWilds.operative || ArePlayerFieldControlsLocked())\n"},{"port":"        return;\n"},{"port":"    shed = CtrWildsCore_Tick(&gCtrWilds, density, env.consoleCap, CtrWild_FreeObjects, NULL);\n"},{"port":"    if (shed >= 0)\n"},{"port":"    {\n"},{"port":"        CtrWild_Refresh(shed);\n"},{"port":"        if (CtrWildsCore_StatsDue(&gCtrWilds))\n"},{"port":"            CtrWild_LogStats();                 // every 30 s of play on one map\n"},{"port":"    }\n"},{"port":"    for (slot = 0; slot < CTR_WILD_MAX; slot++)\n"},{"port":"    {\n"},{"port":"        struct ObjectEvent *wild;\n"},{"port":"\n"},{"port":"        if (gCtrWilds.wild[slot].state == CTRW_S_FREE)\n"},{"port":"            continue;\n"},{"port":"        wild = CtrWild_Get(slot);\n"},{"port":"        if (wild == NULL)\n"},{"port":"            CtrWildsCore_Forget(&gCtrWilds, slot);      // the game removed it (out of its view)\n"},{"port":"        else if (CtrWildsCore_Stale(&gCtrWilds, slot, DISPLAY_WIDTH / 32 + 1))\n"},{"port":"            CtrWild_Remove(slot);\n"},{"port":"        else\n"},{"port":"            CtrWild_Run(slot, wild, player);\n"},{"port":"    }\n"},{"port":"    if (CtrWildsCore_SpawnDue(&gCtrWilds))\n"},{"port":"        CtrWild_Spawn(player);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_Fight(u8 slot)\n"},{"port":"{\n"},{"port":"    if (gCtrWilds.wild[slot].state == CTRW_S_FREE || !CtrWilds_Start(&gCtrWilds.wild[slot]))\n"},{"port":"        return FALSE;\n"},{"port":"    CtrWild_Remove(slot);\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The player walked into the tile in front or pressed A there (field_control_avatar.c): one of them is there, so its battle starts\n"},{"port":"// and it is gone. TRUE when a battle started; a Repel or disabled encounters leave it standing (it blocks the way, as a Pokemon\n"},{"port":"// would).\n"},{"port":"bool8 CtrWilds_TryBattle(s16 x, s16 
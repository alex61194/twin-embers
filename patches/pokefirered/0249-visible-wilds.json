{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/wild_encounter.c","before_sha256":"ad464639d311455ad4f411602ebf919d974596e8902364d321a68390d749b384","after_sha256":"ab545b7293b3fbf950d412d30d38c3cdb9263dcf00e5eb42c647cbc2ffe12117","remove":false,"lines":[{"span":[0,943]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"/* VISIBLE WILDS (the OPTIONS row, prototype on Route 1; event_object_movement.c does the walking): a wild Pokemon seen in the grass\n"},{"port":" * is picked from this map's land table by the game's own routines (so species, levels, the LeafGreen and night variants are the\n"},{"port":" * ones a step in the grass would give), and touching it starts the ordinary wild battle with that species and level. The Repel\n"},{"port":" * test is the game's: a Pokemon a Repel would keep off is neither seen nor fought. */\n"},{"port":"bool8 CtrWilds_EncountersOn(void)\n"},{"port":"{\n"},{"port":"    return sWildEncountersDisabled != TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"bool8 CtrWilds_Pick(u16 *species, u8 *level)\n"},{"port":"{\n"},{"port":"    u16 headerId;\n"},{"port":"    const struct WildPokemonInfo *info;\n"},{"port":"    struct WildPokemon scratch;\n"},{"port":"    const struct WildPokemon *mon;\n"},{"port":"    u8 slot;\n"},{"port":"\n"},{"port":"    if (sWildEncountersDisabled == TRUE)\n"},{"port":"        return FALSE;\n"},{"port":"    headerId = GetCurrentMapWildMonHeaderId();\n"},{"port":"    if (headerId == HEADER_NONE)\n"},{"port":"        return FALSE;\n"},{"port":"    info = gWildMonHeaders[headerId].landMonsInfo;\n"},{"port":"    if (info == NULL)\n"},{"port":"        return FALSE;\n"},{"port":"    slot = ChooseWildMonIndex_Land();\n"},{"port":"    mon = CtrWild_VersionSlot(info, WILD_AREA_LAND, slot, &scratch);\n"},{"port":"    *level = ChooseWildMonLevel(mon);\n"},{"port":"    *species = mon->species;\n"},{"port":"    return IsWildLevelAllowedByRepel(*level);\n"},{"port":"}\n"},{"port":"\n"},{"port":"bool8 CtrWilds_Start(u16 species, u8 level)\n"},{"port":"{\n"},{"port":"    if (sWildEncountersDisabled == TRUE || !IsWildLevelAllowedByRepel(level))\n"},{"port":"        return FALSE;\n"},{"port":"    GenerateWildMon(species, level, 0);\n"},{"port":"    StartWildBattle();\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"#endif\n"}]},{"path":"src/event_object_movement.c","before_sha256":"347c4520419278aaf587d2c1e1e2151d7ee52267cdd1b329c9e088deded43a87","after_sha256":"90e89a6c7f1073acc13f38fd3af756d78f9bec1368b0e311f21414919d02ac04","remove":false,"lines":[{"span":[0,9472]},{"port":"// VISIBLE WILDS (OPTIONS; prototype on Route 1 only, off by default): a few wild Pokemon are seen walking in the tall grass of\n"},{"port":"// the route and the battle starts when the player walks into one or presses A facing it. Each is an object event with its own\n"},{"port":"// local id (CTR_WILD_LOCALID + slot), drawn like the companion: the object itself is the Boy's (his palette, so no object palette\n"},{"port":"// is spent) and the compositor shows the Pokemon's picture from the pack in its place when the pack has one. Species and level\n"},{"port":"// come from the route's land table (CtrWilds_Pick, wild_encounter.c), the walking is the game's wander movement, one that\n"},{"port":"// leaves the view is removed by the game, and none is ever kept: on a map that is not the route, with the option off, when\n"},{"port":"// wild encounters are disabled or a save left one behind, they are removed. Spawning spares the object events (never\n"},{"port":"// fewer than CTR_WILD_SPARE are left free) and makes none in the quest log or the Union Room. Its own generator picks where and\n"},{"port":"// when, so the game's random numbers are not drawn on for that.\n"},{"port":"#define CTR_WILD_LOCALID 0xF0\n"},{"port":"#define CTR_WILD_MAX 2\n"},{"port":"#define CTR_WILD_SPARE 4\n"},{"port":"\n"},{"port":"extern int CtrOptions_VisibleWilds(void);\n"},{"port":"extern int CtrOptions_Randomlocke(void);\n"},{"port":"extern bool8 CtrWilds_EncountersOn(void);\n"},{"port":"extern bool8 CtrWilds_Pick(u16 *species, u8 *level);\n"},{"port":"extern bool8 CtrWilds_Start(u16 species, u8 level);\n"},{"port":"\n"},{"port":"static u16 sCtrWildSpecies[CTR_WILD_MAX];       // 0: the slot is free\n"},{"port":"static u8 sCtrWildLevel[CTR_WILD_MAX];\n"},{"port":"static u16 sCtrWildGfx[CTR_WILD_MAX];           // the pack's picture (CTR_NPC_FOLLOWER + dex), or 0 for the Boy\n"},{"port":"static u16 sCtrWildTimer;\n"},{"port":"static u32 sCtrWildRng = 0x2545F491;\n"},{"port":"\n"},{"port":"static u16 CtrWild_Rand(void)\n"},{"port":"{\n"},{"port":"    sCtrWildRng = sCtrWildRng * 1103515245 + 12345;\n"},{"port":"    return sCtrWildRng >> 16;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static struct ObjectEvent *CtrWild_Get(u8 slot)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"\n"},{"port":"    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)\n"},{"port":"        if (gObjectEvents[i].active && gObjectEvents[i].localId == CTR_WILD_LOCALID + slot)\n"},{"port":"            return &gObjectEvents[i];\n"},{"port":"    return NULL;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWild_Remove(u8 slot)\n"},{"port":"{\n"},{"port":"    struct ObjectEvent *wild = CtrWild_Get(slot);\n"},{"port":"\n"},{"port":"    if (wild != NULL)\n"},{"port":"        RemoveObjectEvent(wild);\n"},{"port":"    sCtrWildSpecies[slot] = 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_OnRoute(void)\n"},{"port":"{\n"},{"port":"    return gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_ROUTE1) && gSaveBlock1Ptr->location.mapNum == MAP_NUM(MAP_ROUTE1);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWild_Spawn(u8 slot, const struct ObjectEvent *player)\n"},{"port":"{\n"},{"port":"    u16 species, dex;\n"},{"port":"    u8 level, tries, free, id;\n"},{"port":"    s16 x = 0, y = 0;\n"},{"port":"    struct ObjectEvent *wild;\n"},{"port":"\n"},{"port":"    for (id = 0, free = 0; id < OBJECT_EVENTS_COUNT; id++)\n"},{"port":"        if (!gObjectEvents[id].active)\n"},{"port":"            free++;\n"},{"port":"    if (free <= CTR_WILD_SPARE || !CtrWilds_Pick(&species, &level))\n"},{"port":"        return;\n"},{"port":"    for (tries = 0; tries < 8; tries++)\n"},{"port":"    {\n"},{"port":"        s16 dx = (s16)(CtrWild_Rand() % 11) - 5, dy = (s16)(CtrWild_Rand() % 7) - 3;\n"},{"port":"\n"},{"port":"        x = player->currentCoords.x + dx;\n"},{"port":"        y = player->currentCoords.y + dy;\n"},{"port":"        if ((dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy) < 4)\n"},{"port":"            continue;\n"},{"port":"        if (!MetatileBehavior_IsTallGrass(MapGridGetMetatileBehaviorAt(x, y)))\n"},{"port":"            continue;\n"},{"port":"        if (GetObjectEventIdByPosition(x, y, player->currentElevation) != OBJECT_EVENTS_COUNT)\n"},{"port":"            continue;\n"},{"port":"        break;\n"},{"port":"    }\n"},{"port":"    if (tries == 8)\n"},{"port":"        return;\n"},{"port":"    id = SpawnSpecialObjectEventParameterized(OBJ_EVENT_GFX_BOY, MOVEMENT_TYPE_WANDER_AROUND, CTR_WILD_LOCALID + slot, x, y,\n"},{"port":"                                              player->currentElevation);\n"},{"port":"    if (id == OBJECT_EVENTS_COUNT)\n"},{"port":"        return;\n"},{"port":"    wild = &gObjectEvents[id];\n"},{"port":"    wild->rangeX = 2;\n"},{"port":"    wild->rangeY = 2;\n"},{"port":"    dex = SpeciesToNationalPokedexNum(species);\n"},{"port":"    sCtrWildGfx[slot] = (dex >= 1 && dex <= CTR_FOLLOWER_SPECIES && CtrFollower_Has(dex, FALSE)) ? CTR_NPC_FOLLOWER + dex : 0;\n"},{"port":"    sCtrWildSpecies[slot] = species;\n"},{"port":"    sCtrWildLevel[slot] = level;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrWilds_Update(const struct ObjectEvent *player)\n"},{"port":"{\n"},{"port":"    u8 slot;\n"},{"port":"    bool8 on = CtrOptions_VisibleWilds() && !CtrOptions_Randomlocke() && CtrWild_OnRoute()\n"},{"port":"            && gQuestLogState != QL_STATE_PLAYBACK && InUnionRoom() != TRUE && CtrWilds_EncountersOn()\n"},{"port":"            && !(gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER));\n"},{"port":"\n"},{"port":"    sCtrWildRng += 0x9E37;\n"},{"port":"    for (slot = 0; slot < CTR_WILD_MAX; slot++)\n"},{"port":"    {\n"},{"port":"        if (CtrWild_Get(slot) == NULL)\n"},{"port":"            sCtrWildSpecies[slot] = 0;      // the game removed it (out of view, another map)\n"},{"port":"        else if (!on || sCtrWildSpecies[slot] == 0)\n"},{"port":"            CtrWild_Remove(slot);           // option off, left the route, or one that a save kept\n"},{"port":"    }\n"},{"port":"    if (!on || ArePlayerFieldControlsLocked())\n"},{"port":"        return;\n"},{"port":"    if (sCtrWildTimer != 0)\n"},{"port":"    {\n"},{"port":"        sCtrWildTimer--;\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    for (slot = 0; slot < CTR_WILD_MAX; slot++)\n"},{"port":"    {\n"},{"port":"        if (sCtrWildSpecies[slot] == 0)\n"},{"port":"        {\n"},{"port":"            CtrWild_Spawn(slot, player);\n"},{"port":"            sCtrWildTimer = 90 + CtrWild_Rand() % 150;\n"},{"port":"            return;\n"},{"port":"        }\n"},{"port":"    }\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The player walked into the tile in front or pressed A there (field_control_avatar.c): one of them is there, so its battle starts\n"},{"port":"// and it is gone. TRUE when a battle started; a Repel or disabled encounters leave it standing (it blocks the way, as a Pokemon\n"},{"port":"// would).\n"},{"port":"bool8 CtrWilds_TryBattle(s16 x, s16 y, u8 elevation)\n"},{"port":"{\n"},{"port":"    u8 id = GetObjectEventIdByPosition(x, y, elevation), slot;\n"},{"port":"\n"},{"port":"    if (id == OBJECT_EVENTS_COUNT || gObjectEvents[id].localId < CTR_WILD_LOCALID\n"},{"port":"     || gObjectEvents[id].localId >= CTR_WILD_LOCALID + CTR_WILD_MAX)\n"},{"port":"        return FALSE;\n"},{"port":"    slot = gObjectEvents[id].localId - CTR_WILD_LOCALID;\n"},{"port":"    if (sCtrWildSpecies[slot] == 0 || !CtrWilds_Start(sCtrWildSpecies[slot], sCtrWildLevel[slot]))\n"},{"port":"        return FALSE;\n"},{"port":"    CtrWild_Remove(slot);\n"},{"port":"    sCtrWildTimer = 300;\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"span":[9472,73]},{"port":"    CtrWilds_Update(player);\n"},{"span":[9545,117]},{"port":"    if (objectEvent->localId >= CTR_WILD_LOCALID && objectEvent->localId < CTR_WILD_LOCALID + CTR_WILD_MAX)\n"},{"port":"    {\n"},{"port":"        if (sCtrWildGfx[objectEvent->localId - CTR_WILD_LOCALID] != 0)\n"},{"port":"            *graphicsId = sCtrWildGfx[objectEvent->localId - CTR_WILD_LOCALID];\n"},{"port":"        return;\n"},{"port":"    }\n"},{"span":[9662,59]}]},{"path":"src/field_control_avatar.c","before_sha256":"18b87db714a6c28cd98ae6ab15911cf95805e1db0130f1be46c11159ae2c9461","after_sha256":"f2df177091a0b6a2efe589896e25de6db54fbcc8f85d548387031558113c20aa","remove":false,"lines":[{"span":[0,280]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    // VISIBLE WILDS: walking into a wild Pokemon seen in the grass, or A facing it, starts its battle.\n"},{"port":"    if (gQuestLogState != QL_STATE_PLAYBACK && ((input->heldDirection && input->dpadDirection == playerDirection) || input->pressedAButton)\n"},{"port":"     && CtrWilds_TryBattle(position.x, position.y, position.elevation) == TRUE)\n"},{"port":"        return TRUE;\n"},{"port":"#endif\n"},{"span":[280,938]}]},{"path":"include/event_object_movement.h","before_sha256":"d94b9b94492fb2a41dae1b323ee15b9a1ceac4e81c47a2d521e900adf48fa511","after_sha256":"07613646522ea79d6e521ee3f3b7761bbcf728a0376d08f24404819e42b7bf52","remove":false,"lines":[{"span":[0,7]},{"port":"// VISIBLE WILDS (OPTIONS): wild Pokemon seen in the grass of the prototype route; local ids 0xF0 to 0xF1.\n"},{"port":"bool8 CtrWilds_TryBattle(s16 x, s16 y, u8 elevation);\n"},{"span":[7,235]}]}]}
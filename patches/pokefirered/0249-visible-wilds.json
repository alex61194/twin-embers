mon), and whether it is a silhouette.\n"},{"port":"static unsigned CtrWild_Look(const struct ObjectEvent *objectEvent, unsigned *graphicsId)\n"},{"port":"{\n"},{"port":"    u16 gfx;\n"},{"port":"\n"},{"port":"    if (!CTR_IS_WILD_LOCALID(objectEvent->localId))\n"},{"port":"        return 0;\n"},{"port":"    gfx = gCtrWilds.wild[objectEvent->localId - CTR_WILD_LOCALID].gfx;\n"},{"port":"    if (gfx == 0)\n"},{"port":"        return 0;\n"},{"port":"    *graphicsId = gfx;\n"},{"port":"    return CtrOptions_WildSilhouette() || CtrWild_InDarkTower() ? CTR_NPC_SILHOUETTE : 0;\n"},{"port":"}\n"},{"port":"\n"},{"span":[9472,73]},{"port":"    CtrWilds_Update(player);\n"},{"span":[9545,130]},{"port":"    unsigned silhouette;\n"},{"span":[9675,19]},{"port":"        silhouette = CtrWild_Look(objectEvent, graphicsId);\n"},{"span":[9694,2]},{"port":"            return 1 | silhouette;\n"},{"span":[9697,3]},{"port":"            return (2 + sprite->oam.paletteNum) | silhouette;\n"},{"span":[9701,20]}]},{"path":"include/event_object_movement.h","before_sha256":"d94b9b94492fb2a41dae1b323ee15b9a1ceac4e81c47a2d521e900adf48fa511","after_sha256":"6e885b85b1cb2bc81ee59b1fc70a12b74e22a5d08f8f103a946482a7a487b63b","remove":false,"lines":[{"span":[0,7]},{"port":"// VISIBLE WILDS (OPTIONS): wild Pokemon seen on the maps that have an encounter table; local ids 0xF0 to 0xF5, one for each slot of\n"},{"port":"// the port's table (3ds_wilds_core.h).\n"},{"port":"#define CTR_WILD_LOCALID 0xF0\n"},{"port":"#define CTR_WILD_MAX 6\n"},{"port":"#define CTR_IS_WILD_LOCALID(id) ((id) >= CTR_WILD_LOCALID && (id) < CTR_WILD_LOCALID + CTR_WILD_MAX)\n"},{"port":"bool8 CtrWilds_TryBattle(s16 x, s16 y, u8 elevation);\n"},{"port":"bool8 CtrWilds_TryCharge(void);\n"},{"span":[7,235]}]},{"path":"src/field_control_avatar.c","before_sha256":"18b87db714a6c28cd98ae6ab15911cf95805e1db0130f1be46c11159ae2c9461","after_sha256":"66d84ba156cc1f5d10cfed140ded0809a14cb8bc79b8bd4889da80d25181017e","remove":false,"lines":[{"sp
{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/trade.c","before_sha256":"63d8e4e9fd5aeb1339f2f63aeed1d108b8df50d3e9933f1838b4f96b94248695","after_sha256":"54a4f8c088c591f3ae5f9aedd274592a5ffefb75073f455469b875419b755f8c","remove":false,"lines":[{"span":[0,1829]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The choice of a Pokemon to trade, for the lower screen (3ds_bottom.c draws both parties as cards): noted every frame the menu reads its\n"},{"port":"// input, with the cursor as FireRed has it (0-5 your party, 6-11 the partner's, 12 CANCEL). A tap asks for a place (CtrTrade_Ask), taken here\n"},{"port":"// as if the D-pad had moved the cursor there (the lower screen sends A next).\n"},{"port":"static EWRAM_DATA u32 sCtrTradeFrame = 0;\n"},{"port":"static EWRAM_DATA s8 sCtrTradeAsk = -1;\n"},{"port":"\n"},{"port":"int CtrTrade_Active(void)\n"},{"port":"{\n"},{"port":"    return sTradeMenu != NULL && sCtrTradeFrame != 0 && gMain.vblankCounter2 - sCtrTradeFrame <= 3;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrTrade_Cursor(void)\n"},{"port":"{\n"},{"port":"    return sTradeMenu != NULL ? sTradeMenu->cursorPosition : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrTrade_Count(int side)\n"},{"port":"{\n"},{"port":"    return sTradeMenu != NULL && side >= 0 && side < 2 ? sTradeMenu->partyCounts[side] : 0;\n"},{"port":"}\n"},{"port":"\n"},{"port":"void CtrTrade_Ask(int position)\n"},{"port":"{\n"},{"port":"    sCtrTradeAsk = position;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// One Pokemon of a party: FALSE for an empty place. The nickname is FireRed's text (12 bytes at least).\n"},{"port":"int CtrTrade_Mon(int side, int index, u16 *species, u8 *level, u8 *hpPercent, u8 *egg, u32 *personality, u8 *nickname)\n"},{"port":"{\n"},{"port":"    struct Pokemon *mon;\n"},{"port":"    u32 hp, maxHp;\n"},{"port":"\n"},{"port":"    if (side < 0 || side > 1 || index < 0 || index >= PARTY_SIZE || index >= CtrTrade_Count(side))\n"},{"port":"        return FALSE;\n"},{"port":"    mon = side == TRADE_PLAYER ? &gPlayerParty[index] : &gEnemyParty[index];\n"},{"port":"    *species = GetMonData(mon, MON_DATA_SPECIES);\n"},{"port":"    *level = GetMonData(mon, MON_DATA_LEVEL);\n"},{"port":"    *egg = GetMonData(mon, MON_DATA_IS_EGG);\n"},{"port":"    *personality = GetMonData(mon, MON_DATA_PERSONALITY);\n"},{"port":"    hp = GetMonData(mon, MON_DATA_HP);\n"},{"port":"    maxHp = GetMonData(mon, MON_DATA_MAX_HP);\n"},{"port":"    *hpPercent = maxHp != 0 ? hp * 100 / maxHp : 0;\n"},{"port":"    GetMonData(mon, MON_DATA_NICKNAME, nickname);\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The other player's name, FireRed's text (EOS ended, 8 characters at most).\n"},{"port":"void CtrTrade_PartnerName(u8 *out)\n"},{"port":"{\n"},{"port":"    StringCopy(out, gLinkPlayers[GetMultiplayerId() ^ 1].name);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static void CtrTrade_Taken(void)\n"},{"port":"{\n"},{"port":"    sCtrTradeFrame = gMain.vblankCounter2 | 1;\n"},{"port":"    if (sCtrTradeAsk >= 0 && sCtrTradeAsk <= PARTY_SIZE * 2 && sTradeMenu->optionsActive[(u8)sCtrTradeAsk])\n"},{"port":"    {\n"},{"port":"        u8 newPosition = sCtrTradeAsk;\n"},{"port":"\n"},{"port":"        if (newPosition == PARTY_SIZE * 2)\n"},{"port":"        {\n"},{"port":"            StartSpriteAnim(&gSprites[sTradeMenu->cursorSpriteId], CURSOR_ANIM_ON_CANCEL);\n"},{"port":"            gSprites[sTradeMenu->cursorSpriteId].x = DISPLAY_WIDTH - 16;\n"},{"port":"            gSprites[sTradeMenu->cursorSpriteId].y = DISPLAY_HEIGHT;\n"},{"port":"        }\n"},{"port":"        else\n"},{"port":"        {\n"},{"port":"            StartSpriteAnim(&gSprites[sTradeMenu->cursorSpriteId], CURSOR_ANIM_NORMAL);\n"},{"port":"            gSprites[sTradeMenu->cursorSpriteId].x = sTradeMonSpriteCoords[newPosition][0] * 8 + 32;\n"},{"port":"            gSprites[sTradeMenu->cursorSpriteId].y = sTradeMonSpriteCoords[newPosition][1] * 8;\n"},{"port":"        }\n"},{"port":"        sTradeMenu->cursorPosition = newPosition;\n"},{"port":"    }\n"},{"port":"    sCtrTradeAsk = -1;\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[1829,3]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrTrade_Taken();\n"},{"port":"#endif\n"},{"span":[1832,1126]}]},{"path":"src/menu.c","before_sha256":"1b29976568cc0e78453f8ff3f3bcfff4f4b232cc3e11d8e5771419a6fcfe168a","after_sha256":"a5ac617ce7901a19f2a276eb84888acd0c9627b13922e7bf56cfbf6d29491de8","remove":false,"lines":[{"span":[0,370]},{"port":"extern int CtrTrade_Active(void);\n"},{"span":[370,210]},{"port":"    if (CtrUnionLeader_Active() || CtrTrade_Active())\n"},{"line":581},{"port":"        sCtrMenuInputFrame = gMain.vblankCounter2;   // the leader's wait and the trade's choice of a Pokemon are drawn by the lower screen itself\n"},{"span":[583,704]}]}]}
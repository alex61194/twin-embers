{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/ctr_poketouch.c","before_sha256":null,"after_sha256":"538301906605a5f44261e5f4f7c0af9065cbf9fcb15b8c06922e3ce6a598edee","remove":false,"lines":[{"port":"/* PokeTouch bridge: what the bottom-screen menu shows, read from FireRed.\n"},{"port":" *\n"},{"port":" * Read-only: item icons come from FireRed's own icon table (so the X panel\n"},{"port":" * shows whatever item is registered) and the Bag sprite follows the player's\n"},{"port":" * gender. Port code never includes game headers; these are its only facts.\n"},{"port":" */\n"},{"port":"#include \"global.h\"\n"},{"port":"#include \"decompress.h\"\n"},{"port":"#include \"item_menu_icons.h\"\n"},{"port":"#include \"constants/items.h\"\n"},{"port":"#include \"3ds_assets.h\"\n"},{"port":"\n"},{"port":"/* Items whose icons PokeTouch shows for fixed roles (3ds_poketouch.c). */\n"},{"port":"unsigned CtrPokeTouch_ItemId(int role)\n"},{"port":"{\n"},{"port":"    static const u16 sItems[] = { ITEM_POKE_BALL, ITEM_TOWN_MAP, ITEM_BICYCLE };\n"},{"port":"\n"},{"port":"    return role >= 0 && role < (int)ARRAY_COUNT(sItems) ? sItems[role] : ITEM_NONE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"/* An item's 24x24 icon: 4bpp tiles (3x3, 1D) and its 16-colour palette. */\n"},{"port":"int CtrPokeTouch_ItemIcon(unsigned item, unsigned char *tiles, unsigned short *palette)\n"},{"port":"{\n"},{"port":"    const u32 *gfx, *pal;\n"},{"port":"\n"},{"port":"    if (item == ITEM_NONE || item >= ITEMS_COUNT)\n"},{"port":"        return 0;\n"},{"port":"    gfx = GetItemIconGfxPtr(item, ITEMICON_TILES);\n"},{"port":"    pal = GetItemIconGfxPtr(item, ITEMICON_PAL);\n"},{"port":"    if (gfx == NULL || pal == NULL)\n"},{"port":"        return 0;\n"},{"port":"    CTR_ASSET_READ(gfx, 4);\n"},{"port":"    CTR_ASSET_READ(pal, 4);\n"},{"port":"    if (GetDecompressedDataSize((const u8 *)gfx) > 0x200 || GetDecompressedDataSize((const u8 *)pal) > 32)\n"},{"port":"        return 0;\n"},{"port":"    LZ77UnCompWram(gfx, tiles);\n"},{"port":"    LZ77UnCompWram(pal, palette);\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"\n"},{"port":"int CtrPokeTouch_PlayerFemale(void)\n"},{"port":"{\n"},{"port":"    return gSaveBlock2Ptr->playerGender == FEMALE;\n"},{"port":"}\n"}]}]}

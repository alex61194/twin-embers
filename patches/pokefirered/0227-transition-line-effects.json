{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/battle_transition.c","before_sha256":"a45554e67da67d5c88a4de21d935ecdcbb31c2750daaa5a222c4f100df7e24a2","after_sha256":"0782de68ac2bb432f56a25ceed6d6479fb8804983a0b455131cbbb0d5ff3641e","remove":false,"lines":[{"span":[0,679]},{"port":"}\n"},{"port":"\n"},{"port":"// The transitions that bend the field line by line from their HBlank callbacks, which the port does not run: Swirl\n"},{"port":"// and Slice move each line across, Shuffle and Ripple up and down. `shift` gets each of the 160 lines' offset from\n"},{"port":"// the camera's (what the callback writes to BG1-3, less the scroll the field has anyway); 1 across, 2 up and down,\n"},{"port":"// 0 when no such transition is running.\n"},{"port":"int CtrTransition_LineShift(s16 *shift)\n"},{"port":"{\n"},{"port":"    s32 i;\n"},{"port":"    s16 base;\n"},{"port":"    int kind;\n"},{"port":"\n"},{"port":"    if (sTransitionData == NULL)\n"},{"port":"        return 0;\n"},{"port":"    if (gMain.hblankCallback == HBlankCB_Swirl || gMain.hblankCallback == HBlankCB_Slice)\n"},{"port":"    {\n"},{"port":"        kind = 1;\n"},{"port":"        base = sTransitionData->cameraX;\n"},{"port":"    }\n"},{"port":"    else if (gMain.hblankCallback == HBlankCB_Shuffle || gMain.hblankCallback == HBlankCB_Ripple)\n"},{"port":"    {\n"},{"port":"        kind = 2;\n"},{"port":"        base = sTransitionData->cameraY;\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"    {\n"},{"port":"        return 0;\n"},{"port":"    }\n"},{"port":"    for (i = 0; i < DISPLAY_HEIGHT; i++)\n"},{"port":"        shift[i] = (s16)gScanlineEffectRegBuffers[1][i] - base;\n"},{"port":"    return kind;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The white bars' brightness, BLDY line by line from their HBlank callback: 1 while it runs, 0 otherwise.\n"},{"port":"int CtrTransition_LineBrightness(u16 *lines)\n"},{"port":"{\n"},{"port":"    s32 i;\n"},{"port":"\n"},{"port":"    if (sTransitionData == NULL || gMain.hblankCallback != HBlankCB_WhiteBarsFade)\n"},{"port":"        return 0;\n"},{"port":"    for (i = 0; i < DISPLAY_HEIGHT; i++)\n"},{"port":"        lines[i] = gScanlineEffectRegBuffers[1][i];\n"},{"port":"    return 1;\n"},{"span":[679,2465]}]}]}
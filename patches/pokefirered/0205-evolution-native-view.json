{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/evolution_scene.c","before_sha256":"660d0c91db22d1b78c75d9a95f31d47454a33bfd46ae47e6b869ff328212374a","after_sha256":"81436e2d0d7c892e22988b24cd8429e22d036741121ee58c5df359645a702bf6","remove":false,"lines":[{"span":[0,28]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_battle_gen4.h\"\n"},{"port":"#endif\n"},{"span":[28,15]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"// The evolution scene is shown as a battle (the scene magnified, its text box crisp at the bottom, as the battle\n"},{"port":"// compositor draws it): its main callback registers in the battle class, not the centred one this file is built in.\n"},{"port":"// Trade evolutions keep the centred class, they sit inside the trade screen.\n"},{"port":"extern void CtrBattle_SetVBlankCallback(IntrCallback callback);\n"},{"port":"\n"},{"port":"// HeartGold's 80x80 picture of the evolving species, drawn in place of the 64x64 one (3ds_battle_gen4.h): slot 0 is the\n"},{"port":"// Pokemon before, slot 1 after. The species whose picture changes with a form keep FireRed's.\n"},{"port":"static void CtrEvo_Gen4(u8 slot, u16 species, u32 personality, u32 otId, const void *pic, u16 paletteOffset)\n"},{"port":"{\n"},{"port":"    u16 palette[16];\n"},{"port":"    u32 shinyValue = HIHALF(otId) ^ LOHALF(otId) ^ HIHALF(personality) ^ LOHALF(personality);\n"},{"port":"\n"},{"port":"    if (species == SPECIES_UNOWN || species == SPECIES_SPINDA || species == SPECIES_CASTFORM\n"},{"port":"     || !CtrGen4_Load(slot, SpeciesToNationalPokedexNum(species), FALSE,\n"},{"port":"                      GetGenderFromSpeciesAndPersonality(species, personality) == MON_FEMALE,\n"},{"port":"                      shinyValue < SHINY_ODDS, pic, palette))\n"},{"port":"    {\n"},{"port":"        CtrGen4_Drop(slot);\n"},{"port":"        return;\n"},{"port":"    }\n"},{"port":"    LoadPalette(palette, paletteOffset, PLTT_SIZE_4BPP);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The OAM tile and palette of the evolving Pokemon's sprite, for the compositor (battle_gfx_sfx_util.c).\n"},{"port":"int CtrEvo_SpriteOam(unsigned slot)\n"},{"port":"{\n"},{"port":"    u8 spriteId;\n"},{"port":"\n"},{"port":"    if (sEvoStructPtr == NULL || slot > 1)\n"},{"port":"        return -1;\n"},{"port":"    spriteId = slot == 0 ? sEvoStructPtr->preEvoSpriteId : sEvoStructPtr->postEvoSpriteId;\n"},{"port":"    if (spriteId >= MAX_SPRITES || !gSprites[spriteId].inUse)\n"},{"port":"        return -1;\n"},{"port":"    return gSprites[spriteId].oam.tileNum | (gSprites[spriteId].oam.paletteNum << 12);\n"},{"port":"}\n"},{"port":"#endif\n"},{"span":[43,224]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrEvo_Gen4(0, currSpecies, personality, trainerId, gMonSpritesGfxPtr->sprites[B_POSITION_OPPONENT_LEFT], OBJ_PLTT_ID(1));\n"},{"port":"#endif\n"},{"span":[267,15]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrEvo_Gen4(1, postEvoSpecies, personality, trainerId, gMonSpritesGfxPtr->sprites[B_POSITION_OPPONENT_RIGHT], OBJ_PLTT_ID(2));\n"},{"port":"#endif\n"},{"span":[282,24]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrBattle_SetVBlankCallback(VBlankCB_EvolutionScene);\n"},{"port":"#else\n"},{"port":"    SetVBlankCallback(VBlankCB_EvolutionScene);\n"},{"port":"#endif\n"},{"span":[307,54]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrEvo_Gen4(1, postEvoSpecies, personality, trainerId, gMonSpritesGfxPtr->sprites[B_POSITION_OPPONENT_RIGHT], OBJ_PLTT_ID(2));\n"},{"port":"#endif\n"},{"span":[361,11]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    CtrBattle_SetVBlankCallback(VBlankCB_EvolutionScene);\n"},{"port":"#else\n"},{"port":"    SetVBlankCallback(VBlankCB_EvolutionScene);\n"},{"port":"#endif\n"},{"span":[373,457]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"            CtrGen4_DropAll();\n"},{"port":"#endif\n"},{"span":[830,877]}]},{"path":"src/battle_gfx_sfx_util.c","before_sha256":"4ea09e0f21a5753624d6f2a991
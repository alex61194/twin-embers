=%u substate=%u request=%d cursor=%u src=%p dst=%p size=%u mode=%u vcount=%u\",\n"},{"port":"                             menu, state, substate, i, gDma3RequestCursor,\n"},{"port":"                             (void *)gDma3Requests[i].src, (void *)gDma3Requests[i].dest,\n"},{"port":"                             gDma3Requests[i].size, gDma3Requests[i].mode, REG_VCOUNT);\n"},{"line":175},{"line":181},{"port":"#endif\n"},{"line":179},{"span":[16,166]}]}]}

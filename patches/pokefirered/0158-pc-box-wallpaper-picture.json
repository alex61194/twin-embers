{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/pokemon_storage_system_graphics.c","before_sha256":"608af7053c4f7b056a43812b9b6fa96128e259cb1704bcea8f2a835fed5f95b5","after_sha256":"25f520cf7bd11abcaa509caf639ebadd2b13ae3fce0dae9e2baf452d5a68c5bc","remove":false,"lines":[{"span":[0,185]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"#include \"3ds_assets.h\"\n"},{"port":"// A box's wallpaper as FireRed draws it (20x18 tiles, the 160x144 picture of its own tilemap), for the lower screen:\n"},{"port":"// BGR555 colours, 0 index = the first colour. Its two palettes are the tilemap's 1 and 2.\n"},{"port":"int CtrPokeTouch_Wallpaper(unsigned id, unsigned short *out)\n"},{"port":"{\n"},{"port":"    static u16 tilemap[360];\n"},{"port":"    static u8 tiles[0x800];\n"},{"port":"    const struct Wallpaper *wallpaper;\n"},{"port":"    int tx, ty, x, y;\n"},{"port":"\n"},{"port":"    if (id >= WALLPAPER_COUNT || out == NULL)\n"},{"port":"        return 0;\n"},{"port":"    wallpaper = &sWallpapers[id];\n"},{"port":"    CtrAssets_RequireRange(wallpaper->palettes, 64);\n"},{"port":"    memset(tiles, 0, sizeof(tiles));\n"},{"port":"    LZ77UnCompWram(wallpaper->tileMap, tilemap);\n"},{"port":"    LZ77UnCompWram(wallpaper->tiles, tiles);\n"},{"port":"    for (ty = 0; ty < 18; ty++)\n"},{"port":"        for (tx = 0; tx < 20; tx++)\n"},{"port":"        {\n"},{"port":"            u16 entry = tilemap[ty * 20 + tx];\n"},{"port":"            u32 tile = entry & 0x3FF;\n"},{"port":"            int palBase = ((entry >> 12) == 2) ? 16 : 0;\n"},{"port":"\n"},{"port":"            if (tile >= sizeof(tiles) / 32)\n"},{"port":"                tile = 0;\n"},{"port":"            for (y = 0; y < 8; y++)\n"},{"port":"                for (x = 0; x < 8; x++)\n"},{"port":"                {\n"},{"port":"                    int sx = (entry & 0x400) ? 7 - x : x, sy = (entry & 0x800) ? 7 - y : y;\n"},{"port":"                    u8 byte = tiles[tile * 32 + sy * 4 + sx / 2];\n"},{"port":"\n"},{"port":"                    out[(ty * 8 + y) * 160 + tx * 8 + x] = wallpaper->palettes[palBase + ((byte >> ((sx & 1) * 4)) & 15)];\n"},{"port":"                }\n"},{"port":"        }\n"},{"port":"    return 1;\n"},{"port":"}\n"},{"port":"#endif\n"},{"span":[185,1364]}]},{"path":"src/pokemon_storage_system_tasks.c","before_sha256":"71ced7c4aaa79febc530048e58dddd78e331ea92910d7b19b50ae05107eba0ea","after_sha256":"3c233c4519c84ebb54ea680ed857507d2ab1d3ec83ccbfaecc0b649078b745fe","remove":false,"lines":[{"span":[0,2983]},{"port":"    b->wallpaper = GetBoxWallpaper(box);\n"},{"span":[2983,45]}]}]}

{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"src/wild_encounter.c","before_sha256":"ad464639d311455ad4f411602ebf919d974596e8902364d321a68390d749b384","after_sha256":"30a5e222b0fcc7769ecbd1387639f49b407e90cb1a8be82a1aeeff8636f12cdb","remove":false,"lines":[{"span":[0,20]},{"port":"#include \"3ds_battle_gen4.h\"\n"},{"port":"#include \"3ds_wilds_core.h\"\n"},{"span":[20,396]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"/* VISIBLE WILDS: where the system works and a wild is out or can appear, a step on the tiles it shows wilds on gives way to them\n"},{"port":" * (3ds_wilds_core.c, CtrWildsCore_SuppressStep); everywhere else, and with the option off, the game's step encounters are untouched. */\n"},{"port":"static bool8 CtrWilds_StepSuppressed(u32 currMetatileAttrs)\n"},{"port":"{\n"},{"port":"    u8 type = ExtractMetatileAttribute(currMetatileAttrs, METATILE_ATTRIBUTE_ENCOUNTER_TYPE);\n"},{"port":"\n"},{"port":"    return CtrWildsCore_SuppressStep(&gCtrWilds, type == TILE_ENCOUNTER_LAND ? CTRW_TILE_LAND : type == TILE_ENCOUNTER_WATER ? CTRW_TILE_WATER : CTRW_TILE_NONE);\n"},{"port":"}\n"},{"port":"#endif\n"},{"port":"\n"},{"span":[416,7]},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"    if (CtrWilds_StepSuppressed(currMetatileAttrs))\n"},{"port":"        return FALSE;\n"},{"port":"#endif\n"},{"span":[423,520]},{"port":"\n"},{"port":"#ifdef PLATFORM_3DS\n"},{"port":"/* VISIBLE WILDS (the OPTIONS page Wilds; event_object_movement.c does the walking and 3ds_wilds_core.c has the rules): the one picker and\n"},{"port":" * the one launcher. The picker rolls a whole Pokemon once, from the map's land or water table with the game's own routines (so\n"},{"port":" * species, levels and the LeafGreen and night variants are the ones a step in the grass would give), with a roamer on its map shown\n"},{"port":" * as the game's own 1 in 4 would pick it: species, level, personality (nature, gender, shininess) and roamer. A Pokemon with no\n"},{"port":" * picture in the pack, an Unown (its letter depends on the chamber's slot) and one that a Repel keeps off are not picked. It runs the\n"},{"port":" * game's routines on our own random numbers (the game's generator is put back as it was), so showing a wild never changes what the\n"},{"port":" * game's Random() gives afterwards. The launcher starts the battle with that very Pokemon (a roamer through the roamer's own\n"},{"port":" * functions), and not in the Safari Zone, with Randomlocke or with encounters disabled (those maps keep the game's encounters). */\n"},{"port":"extern bool32 GetSafariZoneFlag(void);\n"},{"port":"\n"},{"port":"bool8 CtrWilds_Disabled(void)\n"},{"port":"{\n"},{"port":"    return sWildEncountersDisabled == TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_HasPicture(u16 species)\n"},{"port":"{\n"},{"port":"    u16 dex = SpeciesToNationalPokedexNum(species);\n"},{"port":"\n"},{"port":"    return dex >= 1 && dex <= CTR_FOLLOWER_SPECIES && CtrFollower_Has(dex, FALSE);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_SpeciesOk(u16 species)\n"},{"port":"{\n"},{"port":"    return CtrWildsCore_SpeciesOk(species, CtrWild_HasPicture(species), species == SPECIES_UNOWN);\n"},{"port":"}\n"},{"port":"\n"},{"port":"// A table can show a Pokemon when one of its species (or its night one) is not an Unown and has a picture.\n"},{"port":"static bool8 CtrWild_TableOk(const struct WildPokemonInfo *info, bool8 water, u8 count)\n"},{"port":"{\n"},{"port":"    u8 i;\n"},{"port":"    u16 species, map = ((u16)gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum;\n"},{"port":"\n"},{"port":"    if (info == NULL)\n"},{"port":"        return FALSE;\n"},{"port":"    for (i = 0; i < count; i++)\n"},{"port":"    {\n"},{"port":"        species = info->wildPokemon[i].species;\n"},{"port":"        if (CtrWild_SpeciesOk(species))\n"},{"port":"            return TRUE;\n"},{"port":"        species = CtrNightWild_Species(map, water ? CTR_WILD_WATER : CTR_WILD_LAND, i, species, TRUE, IsNationalPokedexEnabled());\n"},{"port":"        if (CtrWild_SpeciesOk(species))\n"},{"port":"            return TRUE;\n"},{"port":"    }\n"},{"port":"    return FALSE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// What this map can show: a table (land and water) with a Pokemon that has a picture. Not in the Safari Zone.\n"},{"port":"void CtrWilds_Probe(u8 *land, u8 *water)\n"},{"port":"{\n"},{"port":"    u16 headerId;\n"},{"port":"\n"},{"port":"    *land = FALSE;\n"},{"port":"    *water = FALSE;\n"},{"port":"    if (GetSafariZoneFlag() == TRUE)\n"},{"port":"        return;\n"},{"port":"    headerId = GetCurrentMapWildMonHeaderId();\n"},{"port":"    if (headerId == HEADER_NONE)\n"},{"port":"        return;\n"},{"port":"    *land = CtrWild_TableOk(gWildMonHeaders[headerId].landMonsInfo, FALSE, LAND_WILD_COUNT);\n"},{"port":"    *water = CtrWild_TableOk(gWildMonHeaders[headerId].waterMonsInfo, TRUE, WATER_WILD_COUNT);\n"},{"port":"}\n"},{"port":"\n"},{"port":"static u32 CtrWild_Stats(u16 species)\n"},{"port":"{\n"},{"port":"    const struct SpeciesInfo *info = &gSpeciesInfo[species];\n"},{"port":"\n"},{"port":"    return info->baseHP + info->baseAttack + info->baseDefense + info->baseSpeed + info->baseSpAttack + info->baseSpDefense;\n"},{"port":"}\n"},{"port":"\n"},{"port":"static bool8 CtrWild_Pick(bool8 isWater, CtrWildMon *out)\n"},{"port":"{\n"},{"port":"    u16 headerId = GetCurrentMapWildMonHeaderId();\n"},{"port":"    const struct WildPokemonInfo *info;\n"},{"port":"    struct WildPokemon scratch;\n"},{"port":"    const struct WildPokemon *mon;\n"},{"port":"    struct Roamer *roamer = &gSaveBlock1Ptr->roamer;\n"},{"port":"    u8 slot, level, tries;\n"},{"port":"    u16 species;\n"},{"port":"\n"},{"port":"    if (headerId == HEADER_NONE)\n"},{"port":"        return FALSE;\n"},{"port":"    info = isWater ? gWildMonHeaders[headerId].waterMonsInfo : gWildMonHeaders[headerId].landMonsInfo;\n"},{"port":"    if (info == NULL)\n"},{"port":"        return FALSE;\n"},{"port":"    out->water = isWater;\n"},{"port":"    if (CtrWildsCore_RollRoamer(&gCtrWilds, IsRoamerAt(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum),\n"},{"port":"                                CtrWildsCore_HasRoamer(&gCtrWilds))\n"},{"port":"     && CtrWild_SpeciesOk(roamer->species) && IsWildLevelAllowedByRepel(roamer->level))\n"},{"port":"    {\n"},{"port":"        out->species = roamer->species;\n"},{"port":"        out->level = roamer->level;\n"},{"port":"        out->personality = roamer->personality;\n"},{"port":"        out->roamer = TRUE;\n"},{"port":"        out->power = CtrWildsCore_Power(roamer->level, CtrWild_Stats(roamer->species));\n"},{"port":"        return TRUE;\n"},{"port":"    }\n"},{"port":"    for (tries = 0; tries < 6; tries++)     // a few rolls: one without a picture or that a Repel keeps off is skipped\n"},{"port":"    {\n"},{"port":"        slot = isWater ? ChooseWildMonIndex_WaterRock() : ChooseWildMonIndex_Land();\n"},{"port":"        mon = CtrWild_VersionSlot(info, isWater ? WILD_AREA_WATER : WILD_AREA_LAND, slot, &scratch);\n"},{"port":"        level = ChooseWildMonLevel(mon);\n"},{"port":"        species = mon->species;\n"},{"port":"        if (!CtrWild_SpeciesOk(species) || !IsWildLevelAllowedByRepel(level))\n"},{"port":"            continue;\n"},{"port":"        out->species = species;\n"},{"port":"        out->level = level;\n"},{"port":"        out->roamer = FALSE;\n"},{"port":"        out->personality = CtrWildsCore_Personality(&gCtrWilds, CtrWildsCore_Rand(&gCtrWilds) % NUM_NATURES);\n"},{"port":"        out->power = CtrWildsCore_Power(level, CtrWild_Stats(species));\n"},{"port":"        return TRUE;\n"},{"port":"    }\n"},{"port":"    return FALSE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// One whole Pokemon for a wild that is about to appear: what the battle will start with, and what is seen (its picture, its gender,\n"},{"port":"// whether it is shiny).\n"},{"port":"bool8 CtrWilds_Roll(bool8 isWater, CtrWildMon *out, u16 *gfx, u8 *gender, u8 *shiny)\n"},{"port":"{\n"},{"port":"    u32 saved = gRngValue;\n"},{"port":"    bool8 ok;\n"},{"port":"    u16 dex;\n"},{"port":"\n"},{"port":"    gRngValue = CtrWildsCore_Seed(&gCtrWilds);      // the game's routines draw our numbers, not the game's\n"},{"port":"    ok = CtrWild_Pick(isWater, out);\n"},{"port":"    CtrWildsCore_Stir(&gCtrWilds, gRngValue);\n"},{"port":"    gRngValue = saved;\n"},{"port":"    if (!ok)\n"},{"port":"        return FALSE;\n"},{"port":"    *gender = CtrWildsCore_Gender(gSpeciesInfo[out->species].genderRatio, out->personality);\n"},{"port":"    *shiny = CtrWildsCore_Shiny(T1_READ_32(gSaveBlock2Ptr->playerTrainerId), out->personality);\n"},{"port":"    dex = SpeciesToNationalPokedexNum(out->species);\n"},{"port":"    *gfx = CTR_NPC_FOLLOWER + dex;\n"},{"port":"    if (*gender == MON_FEMALE && CtrFollower_Has(dex, TRUE))\n"},{"port":"        *gfx = CTR_NPC_FOLLOWER + CTR_NPC_FOLLOWER_FEMALE + dex;\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"\n"},{"port":"// The battle of a wild that was touched (or that caught up): its own Pokemon, as rolled. FALSE (nothing starts) when a Repel keeps\n"},{"port":"// its level off or encounters are disabled.\n"},{"port":"bool8 CtrWilds_Start(const CtrWild *wild)\n"},{"port":"{\n"},{"port":"    if (sWildEncountersDisabled == TRUE || !IsWildLevelAllowedByRepel(wild->level))\n"},{"port":"        return FALSE;\n"},{"port":"    if (wild->roamer)\n"},{"port":"    {\n"},{"port":"        if (!IsRoamerAt(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum))\n"},{"port":"            return FALSE;\n"},{"port":"        CreateRoamerMonInstance();\n"},{"port":"        StartRoamerBattle();\n"},{"port":"    }\n"},{"port":"    else\n"},{"port":"    {\n"},{"port":"        ZeroEnemyPartyMons();\n"},{"port":"        CreateMon(&gEnemyParty[0], wild->species, wild->level, USE_RANDOM_IVS, TRUE, wild->personality, OT_ID_PLAYER_ID, 0);\n"},{"port":"        StartWildBattle();\n"},{"port":"    }\n"},{"port":"    ResetEncounterRateModifiers();\n"},{"port":"    return TRUE;\n"},{"port":"}\n"},{"port":"#endif\n"}]}]}
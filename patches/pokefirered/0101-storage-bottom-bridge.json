    },
    {
     "port": "\n"
    },
    {
     "port": "#include \"3ds_storage_bridge.h\"\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "/* The PC's initial field menu and the one returned to after closing a box.\n"
    },
    {
     "port": " * Identify its real live task rather than estimating from map/scene state. */\n"
    },
    {
     "port": "static int CtrBottomStorage_MenuTask(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    int i;\n"
    },
    {
     "port": "    for (i = 0; i < NUM_TASKS; ++i)\n"
    },
    {
     "port": "        if (gTasks[i].isActive && gTasks[i].func == Task_PCMainMenu)\n"
    },
    {
     "port": "            return i;\n"
    },
    {
     "port": "    return -1;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "int CtrBottomStorage_PCMenu(void) { return CtrBottomStorage_MenuTask() >= 0; }\n"
    },
    {
     "port": "int CtrBottomStorage_PCMenuReady(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    int i = CtrBottomStorage_MenuTask();\n"
    },
    {
     "port": "    return i >= 0 && (gTasks[i].tState == STATE_HANDLE_INPUT\n"
    },
    {
     "port": "                       || gTasks[i].tState == STATE_ERROR_MSG);\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "int CtrBottomStorage_PCMenuCursor(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    int i = CtrBottomStorage_MenuTask();\n"
    },
    {
     "port": "    return i >= 0 ? gTasks[i].tSelectedOption : -1;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "int CtrBottomStorage_PCMenuCount(void) { return OPTIONS_COUNT; }\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_PCInputContext(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    /* ERROR_MSG and HANDLE_INPUT are the same root menu. An arrow dismisses\n"
    },
    {
     "port": "     * the error and moves its cursor; the plan must finish in that menu. */\n"
    },
    {
     "port": "    return CtrBottomStorage_PCMenuReady() ? 12 : 0;\n"
    },
    {
     "port": "}\n"
    }
   ]
  },

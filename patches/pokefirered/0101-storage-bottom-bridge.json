   "path": "src/pokemon_storage_system_tasks.c",
   "before_sha256": "43b76a9c88533f835a0dabd9e4bd2da630675ad1fbafcaf803c91afdca77d511",
   "after_sha256": "6f3766d8b8a921bf425da2a9f99ad9a13f6d607abb13a8f322110afb956ffa42",

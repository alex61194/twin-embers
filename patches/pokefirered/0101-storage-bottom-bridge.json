    {
     "port": "#include \"3ds_storage_bridge.h\"\n"
    },
    {
     "port": "/* A box-name child is present only after its real setup and fade have ended. */\n"
    },
    {
     "port": "int CtrBottomStorage_NamingPresented(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return sNamingScreen != NULL && gMain.callback2 == CB2_NamingScreen\n"
    },
    {
     "port": "        && sNamingScreen->templateNum == NAMING_SCREEN_BOX\n"
    },
    {
     "port": "        && sNamingScreen->state >= STATE_HANDLE_INPUT && !gPaletteFade.active;\n"
    },
    {
     "port": "}\n"
    }

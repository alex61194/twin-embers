    },
    {
     "port": "\n"
    },
    {
     "port": "#include \"3ds_storage_bridge.h\"\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "/* Native lower PC view: observe the real controller, never mutate box data.\n"
    },
    {
     "port": " * Task_PokeStorageMain/state 0 is the only stable state for direct cursor taps. */\n"
    },
    {
     "port": "int CtrBottomStorage_BoxOpen(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return gStorage != NULL && gMain.callback2 == CB2_PokeStorage;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_BoxReady(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return CtrBottomStorage_BoxOpen() && !gPaletteFade.active\n"
    },
    {
     "port": "        && gStorage->taskId < NUM_TASKS\n"
    },
    {
     "port": "        && gTasks[gStorage->taskId].isActive\n"
    },
    {
     "port": "        && gTasks[gStorage->taskId].func == Task_PokeStorageMain\n"
    },
    {
     "port": "        && gStorage->state == 0;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_ContextMenu(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    TaskFunc fn;\n"
    },
    {
     "port": "    if (!CtrBottomStorage_BoxOpen() || gStorage->taskId >= NUM_TASKS\n"
    },
    {
     "port": "        || !gTasks[gStorage->taskId].isActive || gPaletteFade.active)\n"
    },
    {
     "port": "        return 0;\n"
    },
    {
     "port": "    fn = gTasks[gStorage->taskId].func;\n"
    },
    {
     "port": "    return (fn == Task_OnSelectedMon && gStorage->state == 2)\n"
    },
    {
     "port": "        || (fn == Task_HandleBoxOptions && gStorage->state == 2)\n"
    },
    {
     "port": "        || (fn == Task_HandleWallpapers && (gStorage->state == 2 || gStorage->state == 4));\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_ContextCount(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return CtrBottomStorage_YesNo() ? 2 : CtrBottomStorage_ContextMenu() ? gStorage->menuItemsCount : 0;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_ContextCursor(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return (CtrBottomStorage_ContextMenu() || CtrBottomStorage_YesNo()) ? Menu_GetCursorPos() : -1;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_ContextX(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return CtrBottomStorage_ContextMenu() ? 8 * gStorage->menuWindow.tilemapLeft : -1;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "int CtrBottomStorage_ContextY(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return CtrBottomStorage_ContextMenu() ? 8 * gStorage->menuWindow.tilemapTop : -1;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "int CtrBottomStorage_ContextW(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    return CtrBottomStorage_ContextMenu() ? 8 * gStorage->menuWindow.width : 0;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_BoxChoose(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    TaskFunc fn;\n"
    },
    {
     "port": "    if (!CtrBottomStorage_BoxOpen() || gStorage->taskId >= NUM_TASKS\n"
    },
    {
     "port": "        || !gTasks[gStorage->taskId].isActive\n"
    },
    {
     "port": "        || gPaletteFade.active || gStorage->state != 1)\n"
    },
    {
     "port": "        return 0;\n"
    },
    {
     "port": "    fn = gTasks[gStorage->taskId].func;\n"
    },
    {
     "port": "    return fn == Task_DepositMenu || fn == Task_JumpBox;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_YesNo(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    TaskFunc fn;\n"
    },
    {
     "port": "    if (!CtrBottomStorage_BoxOpen() || gStorage->taskId >= NUM_TASKS\n"
    },
    {
     "port": "        || !gTasks[gStorage->taskId].isActive || gPaletteFade.active)\n"
    },
    {
     "port": "        return 0;\n"
    },
    {
     "port": "    fn = gTasks[gStorage->taskId].func;\n"
    },
    {
     "port": "    return ((fn == Task_ReleaseMon || fn == Task_CloseBoxWhileHoldingItem) && gStorage->state == 1)\n"
    },
    {
     "port": "        || ((fn == Task_OnCloseBoxPressed || fn == Task_OnBPressed) && gStorage->state == 2);\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "/* Zero means busy; nonzero identifies the stable input controller. Cursor\n"
    },
    {
     "port": " * animations retain the same identity when the controller becomes ready. */\n"
    },
    {
     "port": "int CtrBottomStorage_InputContext(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    TaskFunc fn;\n"
    },
    {
     "port": "    if (!CtrBottomStorage_BoxReady() && !CtrBottomStorage_ContextMenu()\n"
    },
    {
     "port": "        && !CtrBottomStorage_YesNo() && !CtrBottomStorage_BoxChoose())\n"
    },
    {
     "port": "        return 0;\n"
    },
    {
     "port": "    fn = gTasks[gStorage->taskId].func;\n"
    },
    {
     "port": "    if (fn == Task_PokeStorageMain) return 1;\n"
    },
    {
     "port": "    if (fn == Task_OnSelectedMon) return 2;\n"
    },
    {
     "port": "    if (fn == Task_HandleBoxOptions) return 3;\n"
    },
    {
     "port": "    if (fn == Task_HandleWallpapers) return gStorage->state == 2 ? 4 : 5;\n"
    },
    {
     "port": "    if (fn == Task_DepositMenu) return 6;\n"
    },
    {
     "port": "    if (fn == Task_JumpBox) return 7;\n"
    },
    {
     "port": "    if (fn == Task_ReleaseMon) return 8;\n"
    },
    {
     "port": "    if (fn == Task_CloseBoxWhileHoldingItem) return 9;\n"
    },
    {
     "port": "    if (fn == Task_OnCloseBoxPressed) return 10;\n"
    },
    {
     "port": "    if (fn == Task_OnBPressed) return 11;\n"
    },
    {
     "port": "    return 0;\n"
    },
    {
     "port": "}\n"
    },
    {
     "port": "\n"
    },
    {
     "port": "int CtrBottomStorage_BoxPresented(void)\n"
    },
    {
     "port": "{\n"
    },
    {
     "port": "    TaskFunc fn;\n"
    },
    {
     "port": "    if (!CtrBottomStorage_BoxOpen() || gStorage->taskId >= NUM_TASKS\n"
    },
    {
     "port": "        || !gTasks[gStorage->taskId].isActive || gPaletteFade.active)\n"
    },
    {
     "port": "        return 0;\n"
    },
    {
     "port": "    fn = gTasks[gStorage->taskId].func;\n"
    },
    {
     "port": "    return fn != Task_InitPokeStorage && fn != Task_ShowPokeStorage\n"
    },
    {
     "port": "        && fn != Task_ReshowPokeStorage;\n"
    },
    {
     "port": "}\n"
    }
   ]
  },

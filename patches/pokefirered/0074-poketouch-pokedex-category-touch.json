{"schema":1,"technical_reference":"96f95e015af9f5f38e4a8aefca7cab29a78b030d","files":[{"path":"include/ctr_poketouch.h","before_sha256":"f2a229827ad4337d1aae2f80a644126ecee77e27f056d045d4e2124280a24e8a","after_sha256":"e403905286bec0f244eb58969136ef8c11cef2d7805e64406715903fe0b391dc","remove":false,"lines":[{"span":[0,75]},{"port":"// ...and for the habitat/group page (CTR_DEX_CATEGORY): the slot under a point, the selected slot, the page's\n"},{"port":"// identity, and whether a page flip that way leads to another page.\n"},{"port":"int CtrBottomDex_PageSlotAt(int x, int y);\n"},{"port":"int CtrBottomDex_PageSlot(void);\n"},{"port":"int CtrBottomDex_Page(void);\n"},{"port":"int CtrBottomDex_PageCanFlip(int direction);\n"},{"span":[75,47]}]},{"path":"src/pokedex_screen.c","before_sha256":"1628b9082a498e7feed76eceef30836b9e9eea0cf0ca279a91198284d7553c74","after_sha256":"2e1c15c6ffe64ea8c6814ff646f4b2fc80a7176f9acc20acfbb5e025eb40751e","remove":false,"lines":[{"span":[0,3596]},{"line":3581},{"port":"// The habitat/group page (a category's page of up to four Pokemon: CTR_DEX_CATEGORY). Slots are laid out by\n"},{"port":"// the page's own icon table; a slot is its picture's window and its number/name window. -1: none.\n"},{"port":"int CtrBottomDex_PageSlotAt(int x, int y)\n"},{"line":3584},{"port":"    const u8 (*coords)[4];\n"},{"port":"    int slot, n = sPokedexScreenData != NULL ? sPokedexScreenData->numMonsOnPage : 0;\n"},{"line":3581},{"port":"    if (CtrBottomDex_State() != CTR_DEX_CATEGORY || n < 1 || n > 4)\n"},{"line":3578},{"port":"    coords = sCategoryPageIconCoords[n - 1];\n"},{"port":"    for (slot = 0; slot < n; slot++)\n"},{"line":3588},{"port":"        if ((x >= coords[slot][0] * 8 && x < (coords[slot][0] + sWindowTemplate_CategoryMonIcon.width) * 8\n"},{"port":"          && y >= coords[slot][1] * 8 && y < (coords[slot][1] + sWindowTemplate_CategoryMonIcon.height) * 8)\n"},{"port":"         || (x >= coords[slot][2] * 8 && x < (coords[slot][2] + sWindowTemplate_CategoryMonInfo.width) * 8\n"},{"port":"          && y >= coords[slot][3] * 8 && y < (coords[slot][3] + sWindowTemplate_CategoryMonInfo.height) * 8))\n"},{"port":"            return slot;\n"},{"line":3593},{"port":"    return -1;\n"},{"line":3595},{"line":3581},{"port":"// The selected slot of that page, or -1.\n"},{"port":"int CtrBottomDex_PageSlot(void)\n"},{"line":3584},{"port":"    return CtrBottomDex_State() == CTR_DEX_CATEGORY ? sPokedexScreenData->categoryCursorPosInPage : -1;\n"},{"line":3595},{"line":3581},{"port":"// Which page of which category (changes with a flip), or -1.\n"},{"port":"int CtrBottomDex_Page(void)\n"},{"line":3584},{"port":"    return CtrBottomDex_State() == CTR_DEX_CATEGORY ? sPokedexScreenData->category * 256 + sPokedexScreenData->pageNum : -1;\n"},{"line":3595},{"line":3581},{"port":"// Whether the page flip the Pokedex's LEFT (-1) or RIGHT (1) at the edge of the page leads somewhere: another\n"},{"port":"// unlocked page that way (without one, FireRed's own LEFT/RIGHT there leaves the category).\n"},{"port":"int CtrBottomDex_PageCanFlip(int direction)\n"},{"line":3584},{"port":"    int page;\n"},{"line":3581},{"port":"    if (CtrBottomDex_State() != CTR_DEX_CATEGORY)\n"},{"line":3586},{"port":"    if (direction < 0)\n"},{"line":3588},{"port":"        for (page = sPokedexScreenData->pageNum - 1; page >= sPokedexScreenData->firstPageInCategory; page--)\n"},{"line":3450},{"port":"            if (DexScreen_IsPageUnlocked(sPokedexScreenData->category, page))\n"},{"port":"                return 1;\n"},{"line":3460},{"line":3593},{"line":3288},{"line":3588},{"port":"        for (page = sPokedexScreenData->pageNum + 1; page < sPokedexScreenData->lastPageInCategory; page++)\n"},{"line":3450},{"port":"            if (DexScreen_IsPageUnlocked(sPokedexScreenData->category, page))\n"},{"port":"                return 1;\n"},{"line":3460},{"line":3593},{"line":3594},{"line":3595},{"span":[3596,1]}]}]}
